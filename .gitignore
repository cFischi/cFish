# Exclude large WordPress backup directories
WordPress/wp-content/Archives/
WordPress/wp-content/*/backup*
z_Archives/Unsorted/wp-includes/
z_backups/*/backup*

# Exclude any .bak files
*.bak

# Exclude backup and temporary files
*.nosync
*.tmp
*.temp
*~

# Exclude large log files
*.log

# Exclude any files with excessively long paths
WordPress/wp-content/*/jetpack_vendor/automattic/backups/*.json.*

# Large files exceeding GitHub's 100MB limit
