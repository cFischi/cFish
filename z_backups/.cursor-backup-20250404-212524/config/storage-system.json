{
  "alerts": {
    "engine": "elasticsearch",
    "type": "document",
    "retention": "90d"
  },
  "metrics": {
    "engine": "prometheus",
    "type": "time-series",
    "retention": {
      "raw": "7d",
      "hourly": "30d",
      "daily": "365d"
    }
  },
  "logs": {
    "engine": "elasticsearch",
    "type": "document",
    "retention": "30d"
  }
}
