{
  "name": "cursor-system",
  "version": "0.8.24",
  "description": "Cursor system management and monitoring",
  "main": "index.js",
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:d3": "jest --config jest.d3.config.js",
    "install:stage1": "npm install express@5.1.0 ws@8.18.1 blessed@0.1.81",
    "install:stage2": "npm install systeminformation@5.21.22 process-list@2.0.0",
    "install:stage3": "npm install glob@11.0.1 rimraf@6.0.1",
    "install:dev1": "npm install --save-dev typescript@5.3.3 @types/node@20.11.0",
    "install:dev2": "npm install --save-dev jest@29.7.0 ts-jest@29.1.1 @types/jest@29.5.11",
    "install:dev3": "npm install --save-dev chai@5.2.0 mocha@10.2.0 eslint@9.23.0",
    "install:dev4": "npm install --save-dev @testing-library/react @testing-library/jest-dom jest-environment-jsdom lru-cache@10.2.0 @types/d3@7.4.3",
    "install:all": "npm run install:stage1 && npm run install:stage2 && npm run install:stage3 && npm run install:dev1 && npm run install:dev2 && npm run install:dev3 && npm run install:dev4",
    "lint": "eslint .",
    "start": "node index.js",
    "monitor": "node scripts/monitor.js",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "blessed": "0.1.81",
    "express": "5.1.0",
    "systeminformation": "5.21.22",
    "ws": "8.18.1",
    "process-list": "2.0.0",
    "glob": "11.0.1",
    "rimraf": "6.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.2.1", 
    "@types/d3": "^7.4.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "chai": "^5.2.0",
    "eslint": "9.23.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lru-cache": "^10.2.0",
    "mocha": "10.2.0",
    "moment": "^2.30.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
