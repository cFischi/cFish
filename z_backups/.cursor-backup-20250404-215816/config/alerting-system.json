{
  "rules": {
    "performance": {
      "reliability": "value < %",
      "responseTime": "value > ms",
      "accuracy": "value < %",
      "efficiency": "value < %",
      "processTree": {
        "renderTime": "value > ms",
        "memoryUsage": "value > MB",
        "updateLatency": "value > ms"
      },
      "resourceGraphs": {
        "renderEfficiency": "value < %",
        "updateLatency": "value > ms",
        "dataCompression": "value < %"
      }
    },
    "collaboration": {
      "resolutionTime": "value > s",
      "conflictRate": "value > %",
      "teamEfficiency": "value < %",
      "handoffSuccess": "value < %"
    },
    "resourceManagement": {
      "predictionAccuracy": "value < %",
      "statePersistence": "value < %",
      "recoveryReliability": "value < %",
      "systemIntegration": {
        "overhead": "value > %",
        "latency": "value > ms"
      }
    }
  },
  "correlation": {
    "groups": [
      {
        "name": "process-tree-performance",
        "metrics": [
          "performance.processTree.renderTime",
          "performance.processTree.memoryUsage",
          "performance.processTree.updateLatency"
        ],
        "condition": "any",
        "window": "5m"
      },
      {
        "name": "resource-graphs-performance",
        "metrics": [
          "performance.resourceGraphs.renderEfficiency",
          "performance.resourceGraphs.updateLatency",
          "performance.resourceGraphs.dataCompression"
        ],
        "condition": "any",
        "window": "5m"
      },
      {
        "name": "resource-management-health",
        "metrics": [
          "resourceManagement.predictionAccuracy",
          "resourceManagement.statePersistence",
          "resourceManagement.recoveryReliability",
          "resourceManagement.systemIntegration.overhead",
          "resourceManagement.systemIntegration.latency"
        ],
        "condition": "any",
        "window": "10m"
      }
    ]
  },
  "throttling": "15m",
  "grouping": "5m",
  "channels": [
    "email",
    "slack",
    "dashboard"
  ],
  "prioritization": {
    "critical": [
      "performance.processTree.renderTime",
      "performance.processTree.memoryUsage",
      "resourceManagement.recoveryReliability"
    ],
    "high": [
      "performance.resourceGraphs.renderEfficiency",
      "resourceManagement.predictionAccuracy",
      "resourceManagement.statePersistence"
    ],
    "medium": [
      "performance.processTree.updateLatency",
      "performance.resourceGraphs.updateLatency",
      "resourceManagement.systemIntegration.overhead"
    ]
  }
}
