{
  "terminal": {
    "shell": "cmd.exe",
    "args": []
  },
  "editor": {
    "formatOnSave": true,
    "tabSize": 2
  },
  "wordpress": {
    "title": "WordPress Development Guidelines v1.0",
    "coreVersion": {
      "php": "7.4+",
      "wordpress": "6.0+"
    },
    "corePrinciples": [
      "Use OOP for better modularity and maintainability",
      "Follow WordPress coding standards consistently",
      "Leverage WordPress hooks (actions/filters) appropriately",
      "Implement proper security practices (nonce, sanitize, escape)",
      "Never modify core/parent theme files directly"
    ],
    "corePrinciples": [
      "Use OOP for better modularity and maintainability",
      "Follow WordPress coding standards consistently",
      "Leverage WordPress hooks (actions/filters) appropriately",
      "Implement proper security practices (nonce, sanitize, escape)",
      "Never modify core/parent theme files directly"
    ],
    "codeOrganization": [
      "Directory naming: lowercase with hyphens (wp-content/themes/my-theme)",
      "File naming: descriptive, purpose-based (class-user-profile.php)",
      "Enable strict typing: declare(strict_types=1);",
      "Header format: [Description, @package, @since, @author]",
      "Branch naming: feature/name, bugfix/name, hotfix/name"
    ],
    "securityPractices": [
      "Database: Use $wpdb->prepare() for ALL queries",
      "Input: sanitize_* functions before processing",
      "Output: esc_* functions before display",
      "Forms: wp_nonce_* functions for verification",
      "APIs: wp_remote_* for external requests"
    ],
    "workflowRequirements": [
      "Git: commit each atomic change with clear message",
      "Branches: NEVER commit to main, always feature branches",
      "Testing: verify all changes before requesting review",
      "Documentation: update memory.md, changelog.md with each change"
    ],
    "communicationPreferences": {
      "style": "terse answers with functional code examples",
      "learningStage": "Beginner - explain reasoning clearly",
      "confidenceLevel": "Present solutions with confidence level (1-10)",
      "clarifyingQuestions": "Ask 3-5 clarifying questions when needed",
      "responsePrefix": "👽"
    },
    "documentationPractices": {
      "memoryMdUpdates": {
        "format": "## [Title] (MM-DD-2025)\\n- [Bullet points with key information]\\n- [More bullet points as needed]\\n\\n_Updated MM-DD-2025 | AI: Cursor (Claude 3.7 Sonnet)_",
        "requirements": [
          "ALWAYS conclude memory.md entries with signature line in italic",
          "Use format: _Updated MM-DD-2025 | AI: Cursor (Claude 3.7 Sonnet)_",
          "Format date as MM-DD-2025",
          "Include current date in both the section title and signature",
          "Place new entries before the 'Next Steps' section",
          "Use bullet points for all major items",
          "Keep entries concise and relevant"
        ],
        "aiSignature": "_Updated MM-DD-2025 | AI: Cursor (Claude 3.7 Sonnet)_",
        "humanSignature": "_Updated MM-DD-2025 | Human: tY FischEYe_"
      },
      "changelogMdUpdates": {
        "format": "## [Version] - [2025-MM-DD]\\n\\n### Added\\n- [New features]\\n\\n### Changed\\n- [Changes to existing functionality]\\n\\n### Fixed\\n- [Bug fixes]",
        "requirements": [
          "Follow semantic versioning (MAJOR.MINOR.PATCH)",
          "Group changes by type: Added, Changed, Fixed, Removed",
          "Include date in ISO format (2025-MM-DD)",
          "Reference ticket/issue numbers when applicable"
        ]
      }
    },
    "codingConventions": {
      "database": "Use $wpdb->prepare() for all dynamic queries to prevent SQL injection",
      "hooks": "Add hooks using proper array syntax: add_action('init', [$this, 'method_name'], 10)",
      "security": "Always verify nonces and sanitize input, escape output"
    },
    "bestPractices": {
      "performance": [
        "Use transients API for caching data",
        "Implement proper database indexing",
        "Optimize queries with WP_Query"
      ],
      "themes": [
        "Use child themes for customizations",
        "Follow template hierarchy",
        "Implement template tags appropriately"
      ],
      "plugins": [
        "Register hooks in a main plugin class",
        "Separate functionality into logical components",
        "Follow the singleton pattern when appropriate"
      ],
      "content": [
        "Use custom post types for specialized content",
        "Implement custom taxonomies for relationships",
        "Leverage post meta for additional attributes"
      ]
    },
    "mobileFirst": {
      "breakpoints": {
        "mobile": "< 768px",
        "tablet": "768px - 1024px",
        "desktop": "> 1024px"
      },
      "priorities": [
        "Optimize portfolio galleries for mobile viewing",
        "Ensure contact forms are mobile-friendly",
        "Prioritize mobile load performance",
        "Test touch interactions on all components",
        "Implement responsive typography"
      ]
    }
  },
  "editHandling": {
    "singlePass": "Make all necessary changes in a single pass when possible",
    "grouping": "Group related edits together within the same file",
    "avoidMultipleIterations": "Avoid making multiple separate edits to the same file",
    "markers": "Use clear edit markers and comments to indicate changes"
  },
  "toolUsage": {
    "fileOperations": [
      "Always verify file existence before attempting operations",
      "Use read_file before attempting to edit files",
      "Check file permissions before attempting to write"
    ],
    "searchOperations": [
      "Use specific search terms to get precise results",
      "Verify search results before acting on them",
      "Prefer codebase_search over grep_search for semantic understanding"
    ],
    "codeAnalysis": [
      "Verify syntax before making changes",
      "Analyze all affected files before proposing edits",
      "Consider dependencies before modifying shared components"
    ]
  },
  "errorPrevention": {
    "preEditChecks": [
      "Verify file context thoroughly before editing",
      "Validate syntax before making changes",
      "Confirm understanding of the file's purpose and dependencies"
    ],
    "postEditValidation": [
      "Check for introduced errors after editing",
      "Verify all references remain intact",
      "Ensure code still follows WordPress standards"
    ]
  },
  "performanceOptimization": {
    "operationBatching": "Group related operations to reduce API calls",
    "resourceManagement": "Release resources promptly after use",
    "contextOptimization": "Minimize token usage by focusing only on relevant context"
  },
  "codeQuality": {
    "documentation": "Comment all significant changes with proper PHPDoc",
    "errorHandling": "Provide clear error messages and proper exception handling",
    "versionControl": "Respect WordPress version compatibility requirements",
    "testing": "Create unit tests for new functionality where appropriate"
  },
  "operationalConstraints": {
    "fileSizeLimits": "Be aware of file size limits for processing",
    "performanceTargets": "Optimize code for WordPress performance standards",
    "compatibilityRequirements": "Ensure compatibility with specified PHP and WordPress versions"
  },
  "security": {
    "dataValidation": "Always validate and sanitize user input",
    "outputEscaping": "Always escape output before display",
    "queryPreparation": "Use prepared statements for all database queries",
    "nonceVerification": "Implement nonce verification for all forms",
    "capabilityChecks": "Check user capabilities before performing actions"
  },
  "wordpressSpecific": {
    "pluginDevelopment": [
      "Use namespaces for all plugin code",
      "Initialize plugins using the plugins_loaded hook",
      "Register activation/deactivation hooks properly",
      "Follow WordPress plugin header requirements"
    ],
    "themeDevelopment": [
      "Use get_template_part() for modular templates",
      "Implement proper template hierarchy",
      "Register scripts and styles properly",
      "Use child themes for customizations"
    ],
    "blockDevelopment": [
      "Follow block.json structure for block registration",
      "Use ESNext syntax for JavaScript",
      "Implement editor and frontend components properly",
      "Register block assets with proper dependencies"
    ]
  },
  "clientResponse": {
    "core": {
      "acknowledgmentTime": "1 hour maximum",
      "responseTime": "4 hours maximum",
      "followupTime": "48 hours",
      "replyTime": "4 hours maximum"
    },
    "venues": ["club", "lounge", "bar", "residential"],
    "priorities": ["REVENUE-CRITICAL", "REVENUE-HIGH", "REVENUE-MEDIUM", "REVENUE-LOW"]
  },
  "clientCommunication": {
    "format": {
      "task": "TASK: [Brief client communication task]\nClient: [Client Name]\nClient Type: [Club|Lounge|Bar|Residential|Other]\nPriority: [REVENUE-CRITICAL|REVENUE-HIGH|REVENUE-MEDIUM|REVENUE-LOW]\nTimeline: [Expected completion time]\nValue: [Estimated revenue potential]\nSuccess Criteria: [Client response or action]",
      "documentation": "## [Client Name] - [Contact Purpose] (MM-DD-2025)\n\n### Summary\n- Brief overview of client inquiry or communication\n\n### Details\n- Key information shared with client\n- Client feedback or questions\n- Specific needs identified\n- Portfolio examples shared\n\n### Next Steps\n- Follow-up actions and timeline\n- Required materials to prepare\n- Conversion plan\n\n_Contact Made MM-DD-2025 | Response Expected By: MM-DD-2025_",
      "pattern": "## [Venue Type] Success Pattern (MM-DD-2025)\n\n### Client Profile\n- Venue type and characteristics\n- Initial concerns or priorities\n- Communication preferences\n\n### Effective Approach\n- Portfolio examples that resonated\n- Key talking points that connected\n- Objections and how they were addressed\n- Timeline that led to conversion\n\n### Lessons Learned\n- What worked well\n- What to avoid\n- Recommendations for similar clients\n\n_Updated MM-DD-2025 | AI: Cursor (Claude 3.7 Sonnet)_"
    },
    "templates": {
      "acknowledgment": "Thank you for reaching out about your [venue type] project. I'm reviewing your inquiry and will provide a complete response within [X] hours (maximum 4 hours).",
      "followup": "I wanted to follow up on my previous email regarding your [venue type] project. I'm still excited about the opportunity to discuss how we can help with your specific needs."
    }
  },
  "patternDocumentation": {
    "directory": ".cursor/patterns",
    "categories": [
      "client-engagement",
      "venue-specific/club",
      "venue-specific/lounge",
      "venue-specific/bar",
      "portfolio-templates"
