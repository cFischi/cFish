// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+alt+u",
        "command": "composer.openAddContextMenu",
        "when": "composerFocused"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-composer.openAddContextMenu",
        "when": "composerFocused"
    },
    {
        "key": "ctrl+alt+p",
        "command": "pieces-vscode.search",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-pieces-vscode.search"
    },
    {
        "key": "ctrl+alt+l",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "cd \"${workspaceFolder}\" && git pull\n"
        }
    },
    {
        "key": "ctrl+alt+k",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "cd \"${workspaceFolder}\" && git add . && git commit -n -m \"Update from VS Code\" && git push --no-verify\n"
        }
    },
    {
        "key": "ctrl+alt+j",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "cd \"${workspaceFolder}\" && git status\n"
        }
    }
]