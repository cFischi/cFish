// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+alt+u",
        "command": "composer.openAddContextMenu",
        "when": "composerFocused"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-composer.openAddContextMenu",
        "when": "composerFocused"
    },
    {
        "key": "ctrl+alt+p",
        "command": "pieces-vscode.search",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+alt+p",
        "command": "-pieces-vscode.search"
    },
    {
        "key": "ctrl+alt+l",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "cd ${workspaceFolder} && powershell -NoProfile -Command \"& {${workspaceFolder}\\z_git-flo\\gitflo_tools\\active\\cursor-pull.bat | Out-Host}\"\n"
        }
    },
    {
        "key": "ctrl+alt+k",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "cd ${workspaceFolder} && powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\z_git-flo\\gitflo_tools\\active\\push-helper-fixed.ps1\n"
        }
    }
]