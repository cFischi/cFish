{
  "default": {
    "content": "article, .content, .entry-content, main, .document-content, .notion-page-content",
    "title": "h1, .entry-title, .post-title, .headline, .notion-page-header",
    "date": ".date, .published, time, .post-date, meta[property='article:published_time']",
    "author": ".author, .byline, .post-author, meta[name='author']",
    "image": ".featured-image img, .post-thumbnail img, article img:first-of-type",
    "tags": ".tags a, .categories a, .post-tags a",
    "unwanted": ".sidebar, .comments, .navigation, .related-posts, .social-share, .advertisement, script, style, .notion-header, .notion-topbar",
    "nextPage": ".pagination a, .nav-next a, a.next-page"
  },
  "site_specific": {
    "u.cfish.io": {
      "content": ".notion-page-content",
      "title": ".notion-page-header",
      "date": ".notion-page-info",
      "author": ".notion-page-info-author",
      "image": ".notion-image img",
      "tags": ".notion-page-tags a",
      "unwanted": ".notion-header, .notion-topbar, .notion-sidebar, .notion-footer",
      "nextPage": ".notion-page-link a"
    }
  },
  "url_patterns": [
    {
      "pattern": "/u-ucf",
      "selectors": {
        "content": ".notion-page-content",
        "title": ".notion-page-header",
        "date": ".notion-page-info"
      }
    }
  ],
  "special_cases": {
    "paywall": {
      "detection": ".paywall, .subscription-required, .premium-content",
      "action": "skip"
    },
    "cookie_consent": {
      "detection": ".cookie-consent, .gdpr-banner, #cookie-notice",
      "action": "click",
      "click_selector": ".accept-cookies, .accept-all, .agree-button"
    }
  }
} 