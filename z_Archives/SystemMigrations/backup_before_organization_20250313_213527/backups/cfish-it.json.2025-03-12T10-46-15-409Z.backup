        "",
        "I --> J[\"Monitor Resolution\"]",
        "",
        "J --> K{\"Issue Resolved?\"}",
        "",
        "K -- No --> L[\"Escalate to Next Level\"]",
        "",
        "K -- Yes --> M[\"Update Documentation\"]",
        "",
        "```",
