        "graph TD",
        "",
        "A[\"System Issue Detected\"] --> B{\"Priority Level?\"}",
        "",
        "B -- RED --> C[\"Immediate Tech Lead Alert\"]",
        "",
        "B -- AMBER --> D[\"30min DMT Team Alert\"]",
        "",
        "B -- GREEN --> E[\"2hr Support Team Alert\"]",
        "",
        "C --> F[\"System-wide Health Check\"]",
        "",
        "D --> G[\"Run Data Integrity Checks\"]",
        "",
        "E --> H[\"Verify Platform Permissions\"]",
