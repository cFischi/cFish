{
  "watchDirectories": {
    "markdown": [
      ".",
      "docs",
      "sync-system/docs"
    ],
    "json": [
      "json"
    ]
  },
  "exclusions": [
    "node_modules/**",
    ".git/**",
    "logs/**",
    "backups/**",
    "**/*.lock",
    "**/*.nosync",
    "**/*.backup"
  ],
  "debounceTime": 1000,
  "backupSettings": {
    "enabled": true,
    "backupDir": "backups",
    "maxBackups": 5,
    "rotationEnabled": true
  },
  "performanceSettings": {
    "batchProcessingEnabled": true,
    "batchSize": 3,
    "batchTimeout": 3000,
    "throttlingEnabled": true,
    "maxConcurrentTasks": 2,
    "throttleDelay": 1000
  },
  "errorRecoverySettings": {
    "enabled": true,
    "retryEnabled": true,
    "maxRetries": 3,
    "initialRetryDelay": 1000,
    "retryBackoffMultiplier": 2,
    "retryQueueProcessInterval": 10000,
    "autoRecoveryEnabled": true,
    "recoveryStrategies": [
      "backupRestore",
      "partialSync",
      "recreate"
    ]
  },
  "uiSettings": {
    "enabled": true,
    "statusFilePath": "state/md-json-sync-status.json",
    "statusUpdateInterval": 5000,
    "notificationsEnabled": true,
    "notificationsFilePath": "state/md-json-sync-notifications.json",
    "maxNotifications": 100,
    "consoleIndicatorsEnabled": true
  },
  "memoryOptimizationSettings": {
    "memoryWarningThreshold": 60,
    "memoryCriticalThreshold": 80,
    "memoryCheckInterval": 5000,
    "enableAutoGC": true,
    "streamChunkSize": 65536
  }
}