# UcFish Scraper Configuration
# ===========================

# Base configuration
BASE_URL=https://example.com
MAX_DEPTH=3
OUTPUT_DIR=./output

# Request configuration
MAX_CONCURRENT_SCRAPES=2
REQUEST_DELAY=2000
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Content processing
MIN_CONTENT_LENGTH=100
SIMILARITY_THRESHOLD=0.6
MAX_HEADING_LEVEL=6

# Feature toggles
ENABLE_VERIFICATION=true
ENABLE_CONTENT_MERGING=true
ENABLE_RESUMABLE=true

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/scraper.log

# Content selectors
CONTENT_SELECTOR=article, .content, .post, main, #content
TITLE_SELECTOR=h1, .title, .post-title
METADATA_SELECTORS=meta[property^="og:"], meta[name^="twitter:"], meta[name="description"]
IGNORE_SELECTORS=.sidebar, .comments, .advertisement, nav, footer, header

# URL filtering
URL_INCLUDE_PATTERNS=^https?://example\.com/.*
URL_EXCLUDE_PATTERNS=\.(jpg|jpeg|png|gif|svg|webp|mp4|webm|mp3|pdf|zip|rar|exe|dmg|tar|gz|csv|xls|xlsx|doc|docx|ppt|pptx)$,/tag/,/category/,/author/,/page/,/wp-content/,/wp-admin/,/wp-includes/

# Output formatting
MARKDOWN_HEADING_STYLE=atx
MARKDOWN_BULLET_STYLE=*
MARKDOWN_CODE_BLOCK_STYLE=```
MARKDOWN_LINK_STYLE=[]()
MARKDOWN_EMPHASIS_STYLE=*
MARKDOWN_STRONG_STYLE=** 