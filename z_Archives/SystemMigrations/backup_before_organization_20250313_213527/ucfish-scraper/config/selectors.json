{
  "default": {
    "content": "article, .content, .post-content, .entry-content, main",
    "title": "h1, .entry-title, .post-title, .headline",
    "date": ".date, .published, time, .post-date, meta[property='article:published_time']",
    "author": ".author, .byline, .post-author, meta[name='author']",
    "image": ".featured-image img, .post-thumbnail img, article img:first-of-type",
    "tags": ".tags a, .categories a, .post-tags a",
    "unwanted": ".sidebar, .comments, .navigation, .related-posts, .social-share, .advertisement, script, style",
    "nextPage": ".pagination a, .nav-next a, a.next-page"
  },
  "site_specific": {
    "example.com": {
      "content": ".article-body",
      "title": ".article-title",
      "date": ".article-date",
      "author": ".article-author",
      "image": ".article-featured-image img",
      "tags": ".article-tags a",
      "unwanted": ".article-sidebar, .article-comments",
      "nextPage": ".article-pagination a.next"
    },
    "blog.example.com": {
      "content": ".blog-post-content",
      "title": ".blog-post-title",
      "date": ".blog-post-date",
      "author": ".blog-post-author",
      "image": ".blog-post-image img",
      "tags": ".blog-post-categories a",
      "unwanted": ".blog-sidebar, .blog-comments",
      "nextPage": ".blog-pagination a.next"
    },
    "docs.example.com": {
      "content": ".documentation-content",
      "title": ".documentation-title",
      "unwanted": ".documentation-sidebar, .documentation-footer"
    }
  },
  "url_patterns": [
    {
      "pattern": "/blog/",
      "selectors": {
        "content": ".blog-content",
        "title": ".blog-title",
        "date": ".blog-date",
        "author": ".blog-author"
      }
    },
    {
      "pattern": "/news/",
      "selectors": {
        "content": ".news-content",
        "title": ".news-title",
        "date": ".news-date",
        "author": ".news-author"
      }
    },
    {
      "pattern": "/products/",
      "selectors": {
        "content": ".product-description",
        "title": ".product-name",
        "price": ".product-price",
        "features": ".product-features li"
      }
    }
  ],
  "special_cases": {
    "paywall": {
      "detection": ".paywall, .subscription-required, .premium-content",
      "action": "skip"
    },
    "infinite_scroll": {
      "detection": "[data-infinite-scroll]",
      "action": "scroll_and_wait",
      "scroll_times": 5,
      "wait_ms": 2000
    },
    "cookie_consent": {
      "detection": ".cookie-consent, .gdpr-banner, #cookie-notice",
      "action": "click",
      "click_selector": ".accept-cookies, .accept-all, .agree-button"
    }
  }
} 