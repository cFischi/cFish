{
  "name": "ucfish-scraper",
  "version": "1.0.0",
  "description": "Web scraper and markdown converter for UcFish website content",
  "main": "src/index.js",
  "bin": {
    "ucfish-scraper": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "prepare": "npm run lint && npm run test"
  },
  "keywords": [
    "web-scraper",
    "markdown",
    "content-extraction",
    "html-to-markdown",
    "ucfish"
  ],
  "author": "UcFish Team",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "commander": "^11.0.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.1.1",
    "gray-matter": "^4.0.3",
    "html-to-text": "^9.0.5",
    "jsdom": "^22.1.0",
    "lodash": "^4.17.21",
    "natural": "^8.0.1",
    "p-limit": "^3.1.0",
    "p-queue": "^8.1.0",
    "p-retry": "^4.6.2",
    "playwright": "^1.51.0",
    "sanitize-filename": "^1.6.3",
    "slugify": "^1.6.6",
    "turndown": "^7.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "jest": true,
      "es6": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "node/exports-style": [
        "error",
        "module.exports"
      ],
      "node/file-extension-in-import": [
        "error",
        "always"
      ],
      "node/prefer-global/buffer": [
        "error",
        "always"
      ],
      "node/prefer-global/console": [
        "error",
        "always"
      ],
      "node/prefer-global/process": [
        "error",
        "always"
      ],
      "node/prefer-global/url-search-params": [
        "error",
        "always"
      ],
      "node/prefer-global/url": [
        "error",
        "always"
      ],
      "node/prefer-promises/dns": "error",
      "node/prefer-promises/fs": "error"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true
  }
}
