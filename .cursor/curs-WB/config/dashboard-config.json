{
  "timeRange": {
    "options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "7d",
      "30d"
    ],
    "default": "6h"
  },
  "layout": {
    "sections": [
      {
        "visualization": "line-chart",
        "metrics": [
          "responseTime",
          "accuracy",
          "efficiency",
          "reliability"
        ],
        "timeRange": "6h",
        "title": "Performance Metrics"
      },
      {
        "visualization": "line-chart",
        "metrics": [
          "handoffSuccess",
          "conflictRate",
          "resolutionTime",
          "teamEfficiency"
        ],
        "timeRange": "6h",
        "title": "Collaboration Metrics"
      },
      {
        "limit": 100,
        "type": "alert-list",
        "title": "Alert History"
      },
      {
        "metrics": [
          "system_health",
          "agent_status"
        ],
        "type": "status-panel",
        "title": "System Health"
      }
    ]
  },
  "refresh": "1m"
}
