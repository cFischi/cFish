### Implementation Guidelines
```php
// Base Service Class
abstract class BaseService {
    protected $model;
    protected $validator;
    
    public function __construct(Model $model, Validator $validator) {
        $this->model = $model;
        $this->validator = $validator;
    }
    
    protected function validate($data) {
        return $this->validator->validate($data);
    }
    
    protected function create($data) {
        $this->validate($data);
        return $this->model->create($data);
    }
}

// Feature Service Implementation
class FeatureService extends BaseService {
    public function processFeature($input) {
        // Validate input
        $validated = $this->validate($input);
        
        // Process business logic
        $result = $this->processBusinessLogic($validated);
        
        // Create record
        $record = $this->create($result);
        
        // Return response
        return $this->formatResponse($record);
    }
}
```

### Testing Strategy
```php
class FeatureTest extends TestCase {
    /** @test */
    public function it_processes_valid_input() {
        // Arrange
        $input = $this->validInput();
        $service = $this->createService();
        
        // Act
        $result = $service->processFeature($input);
        
        // Assert
        $this->assertFeatureProcessed($result);
    }
    
    /** @test */
    public function it_handles_invalid_input() {
        // Arrange
        $input = $this->invalidInput();
        $service = $this->createService();
        
        // Act & Assert
        $this->expectException(ValidationException::class);
        $service->processFeature($input);
    }
}
```

## Integration Guidelines

### Database Integration
```php
// Migration
class CreateFeatureTable extends Migration {
    public function up() {
        Schema::create('features', function (Blueprint $table) {
            $table->id();
            $table->string('name');
            $table->string('status');
            $table->json('configuration');
            $table->timestamps();
            
            $table->index(['name', 'status']);
        });
    }
}

// Model
class Feature extends Model {
    protected $fillable = [
        'name',
        'status',
        'configuration'
    ];
    
    protected $casts = [
        'configuration' => 'array'
    ];
}
```

### API Integration
```php
// Controller
class FeatureController extends Controller {
    protected $service;
    
    public function __construct(FeatureService $service) {
        $this->service = $service;
    }
    
    public function store(FeatureRequest $request) {
        try {
            $result = $this->service->processFeature(
                $request->validated()
            );
            
            return response()->json($result, 201);
        } catch (Exception $e) {
            return $this->handleError($e);
        }
    }
}

// Request Validation
class FeatureRequest extends FormRequest {
    public function rules() {
        return [
            'name' => 'required|string|max:255',
            'status' => 'required|in:active,inactive',
            'configuration' => 'required|array'
        ];
    }
}
```

