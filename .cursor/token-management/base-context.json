{
  "version": "1.0.1",
  "lastUpdated": "2025-04-02",
  "baseContext": {
    "requiredTokens": 10000,
    "priorityRules": ["wordpress", "security"],
    "relaunchCritical": true,
    "pillarAwareness": true
  },
  "baseTokenAllocation": {
    "systemPrompt": 2000,
    "userContext": 3000,
    "conversationHistory": 5000,
    "activeTask": 10000,
    "reserve": 5000
  },
