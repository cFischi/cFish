{
  "name": "cfish-installation-scripts",
  "version": "1.0.0",
  "description": "Installation scripts for cFish.io",
  "private": true,
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "cli-progress": "^3.12.0",
    "colors": "^1.4.0",
    "express": "^4.18.2",
    "moment": "^2.29.4",
    "node-os-utils": "^1.3.7",
    "pidusage": "^4.0.0",
    "systeminformation": "^5.21.24",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "assert": "^2.1.0",
    "chai": "^5.2.0",
    "jest": "^29.7.0",
    "mocha": "^10.3.0",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.2"
  },
  "main": "alert-correlation.js",
  "scripts": {
    "test": "jest --config ../jest.config.js",
    "test:watch": "jest --watch",
    "install:stage1": "node staged-installer.js --stage=1",
    "install:stage2": "node staged-installer.js --stage=2",
    "install:stage3": "node staged-installer.js --stage=3",
    "install:dev1": "node staged-installer.js --stage=dev1",
    "install:dev2": "node staged-installer.js --stage=dev2",
    "install:dev3": "node staged-installer.js --stage=dev3",
    "install:all": "npm run install:stage1 && npm run install:stage2 && npm run install:stage3 && npm run install:dev1 && npm run install:dev2 && npm run install:dev3",
    "lint": "eslint .",
    "start": "node alert-correlation.js",
    "monitor": "node monitor.js"
  },
