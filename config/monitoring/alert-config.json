{
  "Channels": {
    "Email": {
      "SmtpPort": 587,
      "FromAddress": "alerts@cfish.io",
      "Enabled": {
        "IsPresent": true
      },
      "Subject": "cFish.io Monitoring Alert",
      "SmtpServer": "smtp.cfish.io",
      "UseTLS": true,
      "Recipients": [
        "admin@cfish.io",
        "alerts@cfish.io"
      ]
    },
    "SMS": {
      "Enabled": {
        "IsPresent": false
      },
      "Recipients": [
        "+19876543210"
      ],
      "Provider": "Twilio"
    },
    "Dashboard": {
      "Enabled": true,
      "PlaySound": true,
      "HighlightCritical": true
    }
  },
  "Rules": {
    "MemoryCritical": {
      "Message": "CRITICAL: System memory usage",
      "Actions": [
        "Dashboard",
        "Email",
        "SMS"
      ],
      "RemediationScript": "remediate-memory.ps1",
      "Condition": "Memory usage exceeds 85%",
      "Level": "CRITICAL",
      "AutoRemediate": true,
      "Cooldown": 120
    },
    "ProcessCountCritical": {
      "Message": "CRITICAL: Process count is very high",
      "Actions": [
        "Dashboard",
        "Email",
        "SMS"
      ],
      "RemediationScript": "remediate-processes.ps1",
      "Condition": "Process count exceeds 250",
      "Level": "CRITICAL",
      "AutoRemediate": true,
      "Cooldown": 120
    },
    "ComponentDown": {
      "Message": "CRITICAL: Component is down",
      "Actions": [
        "Dashboard",
        "Email",
        "SMS"
      ],
      "RemediationScript": "restart-component.ps1",
      "Condition": "Component status is DOWN",
      "Level": "CRITICAL",
      "AutoRemediate": true,
      "Cooldown": 60
    },
    "MemoryWarning": {
      "Condition": "Memory usage exceeds 75%",
      "Message": "System memory usage is high",
      "Cooldown": 300,
      "Level": "WARNING",
      "Actions": [
        "Dashboard",
        "Email"
      ]
    },
    "ProcessCountWarning": {
      "Condition": "Process count exceeds 200",
      "Message": "Process count is high",
      "Cooldown": 300,
      "Level": "WARNING",
      "Actions": [
        "Dashboard",
        "Email"
      ]
    }
  },
  "Enabled": true
}
