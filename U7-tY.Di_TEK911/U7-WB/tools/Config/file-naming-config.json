{
  "pattern": "[CompanyPrefix]-[DeptNumber].[FunctionNumber]-[TaskIdentifier].[extension]",
  "example": "ucf-u5.3-data-migration.js",
  "components": {
    "companyPrefix": {
      "values": ["ucf", "tyf", "fh", "ucw", "uz", "fe", "ty"],
      "description": "Company Prefix - identifier for the organizational unit",
      "required": true
    },
    "deptNumber": {
      "values": ["u1", "u2", "u3", "u4", "u5", "u6", "u7"],
      "description": "Department Number - corresponding to UcF departments",
      "required": true
    },
    "functionNumber": {
      "description": "Function Number - Department-specific function identifier (1-9)",
      "required": true
    },
    "taskIdentifier": {
      "description": "Task Identifier - Brief, hyphen-separated description of file purpose",
      "required": true
    },
    "date": {
      "format": "YYYYMMDD",
      "description": "Date - Format: YYYYMMDD for physical documents only (not used in digital files)",
      "required": false
    }
  },
  "exclusions": {
    "directories": [
      "node_modules",
      ".git",
      "wp-includes",
      "wp-admin"
    ],
    "filePatterns": [
      "wp-config.php",
      "index.php",
      ".htaccess",
      ".*\\.min\\.(js|css)$",
      ".*\\.lock$",
      "package\\.json"
    ]
  },
