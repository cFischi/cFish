{
  "name": "md-json-sync",
  "version": "1.0.0",
  "description": "Bidirectional synchronization between Markdown and JSON files using a distributed agent architecture",
  "main": "sync-system/core/tydisync.js",
  "scripts": {
    "start": "node sync-system/core/tydisync.js",
    "watch": "node sync-system/core/tydisync.js --watch",
    "watch:verbose": "node sync-system/core/tydisync.js --watch --verbose",
    "memory-optimized": "node sync-system/core/memory-optimization.js",
    "cursor-integration": "node sync-system/core/cursor-md-json-enhanced.js",
    "test": "node sync-system/tests/test-sync.js"
  },
  "keywords": [
    "markdown",
    "json",
    "synchronization",
    "bidirectional",
    "cursor",
    "agent"
  ],
  "author": "cFish.io",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.3",
    "cheerio": "^1.0.0",
    "chokidar": "^3.6.0",
    "crypto": "^1.0.1",
    "events": "^3.3.0",
    "fs": "0.0.1-security",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "moment": "^2.30.1",
    "node-watch": "^0.7.4",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "turndown": "^7.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "bin": {
    "tydisync": "tydisync.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cFish-io/md-json-sync.git"
  },
  "bugs": {
    "url": "https://github.com/cFish-io/md-json-sync/issues"
  },
  "homepage": "https://github.com/cFish-io/md-json-sync#readme",
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs"
}
