{
  "configuration_version": "1.0",
  "last_updated": "2025-03-15",
  "directory_order": {
    "priority_directories": [
      ".cursor",
      "_Resources",
      "docs",
      "Documentation"
    ],
    "department_directories_pattern": "^U[1-7]-",
    "post_department_directories": [
      "wp-content",
      "_Archives"
    ],
    "backup_directories_pattern": "backup_*",
    "excluded_directories": [
      "node_modules",
      ".git",
      "tmp"
    ]
  },
  "display_options": {
    "show_directory_sizes": true,
    "color_scheme": {
      "priority_directories": "Cyan",
      "department_directories": "Green",
      "post_department_directories": "Cyan",
      "backup_directories": "Yellow",
      "other_directories": "White",
      "critical_files": "Magenta",
      "size_info": "Gray"
    },
    "critical_files": [
      "memory.md",
      "changelog.md",
      "ucf-u5.1-implementation-review-20250314.md",
      "ucf-u5.1-comprehensive-action-plan-update-20250315.md"
    ]
  },
  "desktop_shortcut_options": {
    "shortcut_location": "%USERPROFILE%\\Desktop\\cFish.io",
    "create_subdirectory": true,
    "include_department_shortcuts": true,
    "include_critical_file_shortcuts": true,
    "shortcut_icon_path": "_Resources/icons/cfish-folder.ico"
  },
  "html_report_options": {
    "default_output_path": "U5-Data/Reports/directory-structure-report.html",
    "include_css": true,
    "include_javascript": true,
    "interactive": true,
    "include_file_counts": true,
    "include_directory_sizes": true,
    "css_theme": "light"
  },
  "explorer_integration": {
    "context_menu_name": "Open in cFish.io Visual Directory",
    "enable_context_menu": true,
    "enable_explorer_extension": false
  }
} 