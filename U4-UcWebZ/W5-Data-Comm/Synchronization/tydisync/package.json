{
  "name": "tydisync",
  "version": "1.0.0",
  "description": "Bidirectional synchronization between Markdown and JSON files using a distributed agent architecture",
  "main": "src/core/tydisync.js",
  "scripts": {
    "start": "node src/core/tydisync.js",
    "watch": "node src/core/tydisync.js --watch",
    "watch:verbose": "node src/core/tydisync.js --watch --verbose",
    "memory-optimized": "node src/core/memory-optimization.js",
    "cursor-integration": "node src/core/cursor-md-json-enhanced.js",
    "test": "node src/tests/test-sync.js"
  },
  "keywords": [
    "markdown",
    "json",
    "synchronization",
    "bidirectional",
    "cursor",
    "agent"
  ],
  "author": "cFish.io",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.3",
    "cheerio": "^1.0.0",
    "chokidar": "^3.6.0",
    "crypto": "^1.0.1",
    "events": "^3.3.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.1",
    "moment": "^2.30.1",
    "node-watch": "^0.7.4",
    "turndown": "^7.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "bin": {
    "tydisync": "src/core/tydisync.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cFish-io/tydisync.git"
  },
  "bugs": {
    "url": "https://github.com/cFish-io/tydisync/issues"
  },
  "homepage": "https://github.com/cFish-io/tydisync#readme",
  "directories": {
    "doc": "src/docs"
  },
  "type": "commonjs"
} 