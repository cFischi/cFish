<#
.SYNOPSIS
    Fixes variable reference errors with colons in PowerShell scripts.

.DESCRIPTION
    This script specifically targets and fixes variable reference errors with colons
    in PowerShell scripts, which cannot be fixed by the general fix-powershell-syntax.ps1
    script due to linter errors.

.PARAMETER ScriptDirectory
    The directory containing PowerShell scripts to fix. Default is the current directory.

.PARAMETER BackupDirectory
    The directory to store backups of original scripts. Default is ".\backups".

.PARAMETER LogFile
    The path to the log file. Default is ".\fix-variable-references.log".

.PARAMETER WhatIf
    If specified, shows what would be fixed without making actual changes.

.EXAMPLE
    .\fix-variable-references.ps1 -ScriptDirectory "C:\Scripts" -BackupDirectory "C:\Backups" -LogFile "C:\Logs\fix.log"

.NOTES
    Version:        1.0
    Author:         cFish.io Team
    Creation Date:  2025-03-20
#>

[CmdletBinding(SupportsShouldProcess=$true)]
param (
    [Parameter(Mandatory=$false)]
    [string]$ScriptDirectory = ".",
    
    [Parameter(Mandatory=$false)]
    [string]$BackupDirectory = ".\backups",
    
    [Parameter(Mandatory=$false)]
    [string]$LogFile = ".\fix-variable-references.log"
)

#### Initialize logging
function Write-Log {
    param (
        [Parameter(Mandatory=$true)]
        [string]$Message,
        
        [Parameter(Mandatory=$false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    #### Write to console with appropriate color
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Green }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    #### Write to log file
    Add-Content -Path $LogFile -Value $logMessage
}

#### Create backup directory if it doesn't exist
if (-not (Test-Path -Path $BackupDirectory)) {
    try {
        New-Item -Path $BackupDirectory -ItemType Directory -Force | Out-Null
        Write-Log "Created backup directory: $BackupDirectory"
    }
    catch {
        Write-Log "Failed to create backup directory: $($_.Exception.Message)" -Level "ERROR"
        exit 1
    }
}

#### Initialize counters
$scriptCount = 0
$fixedScriptCount = 0
$errorCount = 0

#### Get all PowerShell scripts in the directory
$scripts = Get-ChildItem -Path $ScriptDirectory -Filter "*.ps1" -Recurse

Write-Log "Found $($scripts.Count) PowerShell scripts to process"

foreach ($script in $scripts) {
    $scriptCount++
    $scriptPath = $script.FullName
    $backupPath = Join-Path -Path $BackupDirectory -ChildPath "$($script.Name).bak"
    
    Write-Log "Processing script: $scriptPath"
    
    try {
        #### Read script content as lines to avoid regex issues with colons
        $lines = Get-Content -Path $scriptPath
        
        #### Create backup
        if ($PSCmdlet.ShouldProcess($scriptPath, "Create backup")) {
            Copy-Item -Path $scriptPath -Destination $backupPath -Force
            Write-Log "Created backup: $backupPath"
        }
        else {
            Write-Log "Would create backup: $backupPath (WhatIf mode)" -Level "INFO"
        }
        
        #### Track if any fixes were applied
        $fixesApplied = $false
        $fixedLines = @()
        
        foreach ($line in $lines) {
            #### Skip comment lines
            if ($line -match '^\s*#') {
                $fixedLines += $line
                continue
            }
            
            #### Check for variable:property pattern
            if ($line -match '\$\w+:\w+') {
                $fixedLine = $line
                
                #### Handle simple cases with direct string replacement
                #### Example: $var:prop → ${var}:prop
                $fixedLine = $fixedLine -replace '\$(\w+):(\w+)', '${$1}:$2'
                
                if ($fixedLine -ne $line) {
                    $fixesApplied = $true
                    Write-Log "Fixed variable reference in line: $line" -Level "INFO"
                }
                
                $fixedLines += $fixedLine
            }
            else {
                $fixedLines += $line
            }
        }
        
        #### Save changes if any fixes were applied
        if ($fixesApplied) {
            if ($PSCmdlet.ShouldProcess($scriptPath, "Fix variable references")) {
                Set-Content -Path $scriptPath -Value $fixedLines
                Write-Log "Fixed variable references in: $scriptPath" -Level "INFO"
                $fixedScriptCount++
            }
            else {
                Write-Log "Would fix variable references in: $scriptPath (WhatIf mode)" -Level "INFO"
            }
        }
        else {
            Write-Log "No variable reference issues found in: $scriptPath" -Level "INFO"
        }
    }
    catch {
        Write-Log "Error processing ${scriptPath}: $($_.Exception.Message)" -Level "ERROR"
        $errorCount++
    }
}

#### Summary
Write-Log "===== Summary =====" -Level "INFO"
Write-Log "Total scripts processed: $scriptCount" -Level "INFO"
Write-Log "Scripts with fixes applied: $fixedScriptCount" -Level "INFO"
Write-Log "Errors encountered: $errorCount" -Level "INFO"

if ($errorCount -gt 0) {
    Write-Log "Completed with errors. See log file for details: $LogFile" -Level "WARNING"
    exit 1
}
else {
    Write-Log "Completed successfully. See log file for details: $LogFile" -Level "INFO"
    exit 0
} 

