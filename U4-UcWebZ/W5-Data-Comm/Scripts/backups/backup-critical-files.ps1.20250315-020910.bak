# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

# Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$PSCommandPath-error-log.txt"
    )
    
    # Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    
    try {
        # Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Handle-Error"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    # Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in $Operation: $($Error.Exception.Message)"
    $errorDetails = "Exception Type: $($Error.Exception.GetType().FullName)
Stack Trace: $($Error.ScriptStackTrace)"
    
    # Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    # Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    # Return error information
    return @{
        Message = $Error.Exception.Message
        Type = $Error.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

<#
.SYNOPSIS
    Backs up critical files in the cFish.io system.

.DESCRIPTION
    This script creates daily backups of critical files like memory.md and changelog.md
    with a 30-day retention policy. It implements proper error handling and 
    verification of backup integrity.

.NOTES
    File Name      : backup-critical-files.ps1
    Author         : tY FischEYe via Cursor/Claude
    Prerequisite   : PowerShell V3
    Copyright      : cFish.io 2025
    Date           : March 20, 2025
#>

# Script configuration
$criticalFiles = @(
    "memory.md",
    "changelog.md"
)
$backupRoot = "U5-Data\Backups\critical"
$retentionDays = 30
$logDir = "U5-Data\Backups\logs"

# Initialize
$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
$dateFolder = Get-Date -Format "yyyyMMdd" 
$backupDir = Join-Path -Path $backupRoot -ChildPath $dateFolder
$logFile = Join-Path -Path $logDir -ChildPath "backup-critical-$timestamp.log"

# Ensure directories exist
if (-not (Test-Path -Path $backupRoot)) {
    New-Item -ItemType Directory -Path $backupRoot -Force
}
if (-not (Test-Path -Path $backupDir)) {
    New-Item -ItemType Directory -Path $backupDir -Force
}
if (-not (Test-Path -Path $logDir)) {
    New-Item -ItemType Directory -Path $logDir -Force
}

# Start logging
Start-Transcript -Path $logFile -Append
Write-Output "============================================="
Write-Output "Critical File Backup - Started: $(Get-Date)"
Write-Output "============================================="

# Create backup for each critical file
$backupResults = @()
foreach ($file in $criticalFiles) {
    try {
        if (Test-Path -Path $file) {
            $destination = Join-Path -Path $backupDir -ChildPath "$file"
            Copy-Item -Path $file -Destination $destination -Force
            
            # Calculate SHA-256 hash for verification
            $sourceHash = (Get-FileHash -Path $file -Algorithm SHA256).Hash
            $destinationHash = (Get-FileHash -Path $destination -Algorithm SHA256).Hash
            
            # Verify backup integrity
            $verified = ($sourceHash -eq $destinationHash)
            
            $backupResults += [PSCustomObject]@{
                File = $file
                Size = (Get-Item -Path $file).Length
                Destination = $destination
                SourceHash = $sourceHash
                BackupHash = $destinationHash
                Verified = $verified
                Timestamp = Get-Date
            }
            
            Write-Output "Backed up: $file -> $destination (Verified: $verified)"
        } else {
            Write-Warning "File not found: $file"
        }
    } catch {
        $errorMessage = $_.Exception.Message
        Write-Error "Error backing up $file: $errorMessage"
    }
}

# Clean up old backups (retention policy)
try {
    $cutoffDate = (Get-Date).AddDays(-$retentionDays)
    $oldBackups = Get-ChildItem -Path $backupRoot -Directory | Where-Object { 
        $folderDate = [datetime]::ParseExact($_.Name, "yyyyMMdd", $null)
        $folderDate -lt $cutoffDate 
    }
    
    foreach ($oldBackup in $oldBackups) {
        Write-Output "Removing old backup: $($oldBackup.FullName)"
        Remove-Item -Path $oldBackup.FullName -Recurse -Force
    }
    
    $remainingBackups = (Get-ChildItem -Path $backupRoot -Directory).Count
    Write-Output "Retention policy applied. Remaining backups: $remainingBackups"
} catch {
    $errorMessage = $_.Exception.Message
    Write-Error "Error applying retention policy: $errorMessage"
}

# Create backup summary file
$summaryFile = Join-Path -Path $backupDir -ChildPath "backup-summary.json"
$backupResults | ConvertTo-Json -Depth 5 | Out-File -FilePath $summaryFile -Encoding utf8

Write-Output "============================================="
Write-Output "Critical File Backup - Completed: $(Get-Date)"
Write-Output "============================================="

# Display backup summary
Write-Output "Backup Summary:"
$backupResults | Format-Table -Property File, Size, Verified -AutoSize

# End logging
Stop-Transcript

# Return backup results
return $backupResults 
