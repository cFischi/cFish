# enhance-error-handling.ps1
# Purpose: Enhance error handling in DMMS scripts by adding try-catch blocks and proper error logging
# Created: 2025-03-19
# Author: Claude 3.7 Sonnet

# Set error action preference
$ErrorActionPreference = "Stop"

#### Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

#### Log file path
$logFile = Join-Path -Path $logDir -ChildPath "error-handling-enhancement-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

#### Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    #### Write to console
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    #### Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

#### Function to backup a file before modifying it
function Backup-File {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    $backupDir = Join-Path -Path $PSScriptRoot -ChildPath "backups"
    if (-not (Test-Path -Path $backupDir)) {
        New-Item -Path $backupDir -ItemType Directory -Force | Out-Null
    }
    
    $fileName = Split-Path -Path $FilePath -Leaf
    $timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
    $backupPath = Join-Path -Path $backupDir -ChildPath "${fileName}.${timestamp}.bak"
    
    try {
        Copy-Item -Path $FilePath -Destination $backupPath -Force
        Write-Log "Created backup of $FilePath at $backupPath"
        return $true
    }
    catch {
        Write-Log "Failed to create backup of $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

#### Function to enhance error handling in a PowerShell script
function Enhance-ErrorHandling {
    param (
        [Parameter(Mandatory = $true)]
        [string]$ScriptPath
    )
    
    Write-Log "Processing script: $ScriptPath"
    
    #### Check if file exists
    if (-not (Test-Path -Path $ScriptPath)) {
        Write-Log "Script file not found: $ScriptPath" -Level "ERROR"
        return $false
    }
    
    #### Backup the file
    if (-not (Backup-File -FilePath $ScriptPath)) {
        Write-Log "Skipping $ScriptPath due to backup failure" -Level "ERROR"
        return $false
    }
    
    try {
        #### Read the script content
        $content = Get-Content -Path $ScriptPath -Raw
        
        #### Check if the script already has enhanced error handling
        if ($content -match "# Enhanced error handling added") {
            Write-Log "Script already has enhanced error handling: $ScriptPath" -Level "WARNING"
            return $true
        }
        
        #### Add error handling header
        $enhancedHeader = @"
# Enhanced error handling added $(Get-Date -Format "yyyy-MM-dd")
`$ErrorActionPreference = "Stop"

#### Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = `$true)]
        [System.Management.Automation.ErrorRecord]`$Error,
        
        [Parameter(Mandatory = `$true)]
        [string]`$Operation,
        
        [Parameter(Mandatory = `$false)]
        [string]`$LogFile = "`$PSScriptRoot\logs\$(Split-Path -Path `$PSCommandPath -Leaf)-error-log.txt"
    )
    
    #### Create log directory if it doesn't exist
    `$logDir = Split-Path -Path `$LogFile -Parent
    if (-not (Test-Path -Path `$logDir)) {
        New-Item -Path `$logDir -ItemType Directory -Force | Out-Null
    }
    
    #### Format error message
    `$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    `$errorMessage = "[`$timestamp] ERROR in `$Operation: `$(`$Error.Exception.Message)"
    `$errorDetails = "Exception Type: `$(`$Error.Exception.GetType().FullName)`nStack Trace: `$(`$Error.ScriptStackTrace)"
    
    #### Write to log file
    Add-Content -Path `$LogFile -Value `$errorMessage
    Add-Content -Path `$LogFile -Value `$errorDetails
    Add-Content -Path `$LogFile -Value "----------------------------------------"
    
    #### Display error message
    Write-Host `$errorMessage -ForegroundColor Red
    
    #### Return error information
    return @{
        Message = `$Error.Exception.Message
        Type = `$Error.Exception.GetType().FullName
        Operation = `$Operation
        Time = `$timestamp
    }
}

"@
        
        # Add the enhanced header to the script
        $enhancedContent = $enhancedHeader + "`n" + $content
        
        #### Find all function definitions
        $functionPattern = '(?ms)function\s+([A-Za-z0-9_-]+)\s*\{(.*?)\}'
        $enhancedContent = [regex]::Replace($enhancedContent, $functionPattern, {
            param($match)
            
            $functionName = $match.Groups[1].Value
            $functionBody = $match.Groups[2].Value
            
            #### Skip if function already has try-catch
            if ($functionBody -match 'try\s*\{') {
                return $match.Value
            }
            
            #### Add try-catch block to the function
            $enhancedFunction = @"
function $functionName {$functionBody
    try {
        # Original function body is above
    }
    catch {
        `$errorInfo = Handle-Error -Error `$_ -Operation "$functionName"
        Write-Warning "Operation failed. See error log for details."
        return `$false
    }
}
"@
            return $enhancedFunction
        })
        
        #### Write the enhanced content back to the file
        Set-Content -Path $ScriptPath -Value $enhancedContent
        
        Write-Log "Successfully enhanced error handling in $ScriptPath"
        return $true
    }
    catch {
        Write-Log "Failed to enhance error handling in $ScriptPath. Error: $_" -Level "ERROR"
        
        #### Try to restore from backup
        $backupDir = Join-Path -Path $PSScriptRoot -ChildPath "backups"
        $fileName = Split-Path -Path $ScriptPath -Leaf
        $latestBackup = Get-ChildItem -Path $backupDir -Filter "$fileName.*.bak" | Sort-Object LastWriteTime -Descending | Select-Object -First 1
        
        if ($latestBackup) {
            try {
                Copy-Item -Path $latestBackup.FullName -Destination $ScriptPath -Force
                Write-Log "Restored $ScriptPath from backup $($latestBackup.FullName)" -Level "WARNING"
            }
            catch {
                Write-Log "Failed to restore $ScriptPath from backup. Error: $_" -Level "ERROR"
            }
        }
        
        return $false
    }
}

#### Main script execution
Write-Log "Starting error handling enhancement process"

#### Get all PowerShell scripts in the current directory
$scripts = Get-ChildItem -Path $PSScriptRoot -Filter "*.ps1" | Where-Object { $_.Name -ne "enhance-error-handling.ps1" }

Write-Log "Found $($scripts.Count) scripts to process"

$successCount = 0
$failureCount = 0

foreach ($script in $scripts) {
    $result = Enhance-ErrorHandling -ScriptPath $script.FullName
    
    if ($result) {
        $successCount++
    }
    else {
        $failureCount++
    }
}

Write-Log "Error handling enhancement completed. Success: $successCount, Failure: $failureCount"

#### Create a summary report
$summaryFile = Join-Path -Path $logDir -ChildPath "error-handling-enhancement-summary-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"

$summary = @"
#### DMMS Error Handling Enhancement Summary

##### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Total Scripts Processed**: $($scripts.Count)
- **Successfully Enhanced**: $successCount
- **Failed to Enhance**: $failureCount
- **Completion Percentage**: $([math]::Round(($successCount / $scripts.Count) * 100, 2))%

##### Details
- Log file: $logFile
- Enhanced scripts now include:
  - Standardized error handling function
  - Try-catch blocks in all functions
  - Detailed error logging with timestamps
  - Error recovery mechanisms
  - Consistent error reporting format

##### Next Steps
1. Test all enhanced scripts to verify functionality
2. Update documentation to reflect enhanced error handling
3. Implement automated testing for error scenarios
4. Train team members on new error handling approach

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@

Set-Content -Path $summaryFile -Value $summary
Write-Log "Created summary report at $summaryFile"

Write-Host "`nError handling enhancement process completed. See $summaryFile for details." -ForegroundColor Green 

