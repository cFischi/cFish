# enhance-service-documentation.ps1
# Purpose: Standardize and enrich service documentation with technical details, integration guidance, and usage examples
# Created: 2025-03-19
# Author: Claude 3.7 Sonnet

# Script parameters
param (
    [Parameter(Mandatory = $false)]
    [string]$ServiceCatalogPath = "Services\service-catalog.json",
    
    [Parameter(Mandatory = $false)]
    [string]$OutputDirectory = "Services\Documentation",
    
    [Parameter(Mandatory = $false)]
    [switch]$GenerateAll = $false,
    
    [Parameter(Mandatory = $false)]
    [string]$TargetService = "",
    
    [Parameter(Mandatory = $false)]
    [string]$TemplatePath = "Templates\service-documentation-template.md"
)

# Set error action preference
$ErrorActionPreference = "Stop"

# Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

# Log file path
$logFile = Join-Path -Path $logDir -ChildPath "service-documentation-enhancement-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

# Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "DEBUG")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    # Write to console with different colors based on level
    switch ($Level) {
        "DEBUG" { Write-Host $logMessage -ForegroundColor Gray }
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    # Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

# Function to load service catalog
function Load-ServiceCatalog {
    param (
        [Parameter(Mandatory = $true)]
        [string]$ServiceCatalogPath
    )
    
    $catalogFullPath = Join-Path -Path $PSScriptRoot -ChildPath $ServiceCatalogPath
    
    if (-not (Test-Path -Path $catalogFullPath)) {
        Write-Log "Service catalog file not found at $catalogFullPath" -Level "ERROR"
        throw "Service catalog file not found"
    }
    
    try {
        $catalog = Get-Content -Path $catalogFullPath -Raw | ConvertFrom-Json
        Write-Log "Loaded service catalog from $catalogFullPath" -Level "INFO"
        return $catalog
    }
    catch {
        Write-Log "Error loading service catalog: $_" -Level "ERROR"
        throw "Failed to load service catalog. See log for details."
    }
}

# Function to load documentation template
function Load-DocumentationTemplate {
    param (
        [Parameter(Mandatory = $true)]
        [string]$TemplatePath
    )
    
    $templateFullPath = Join-Path -Path $PSScriptRoot -ChildPath $TemplatePath
    
    if (-not (Test-Path -Path $templateFullPath)) {
        Write-Log "Documentation template file not found at $templateFullPath" -Level "ERROR"
        Write-Log "Creating default documentation template" -Level "WARNING"
        
        # Create Templates directory if it doesn't exist
        $templateDir = Split-Path -Path $templateFullPath -Parent
        if (-not (Test-Path -Path $templateDir)) {
            New-Item -Path $templateDir -ItemType Directory -Force | Out-Null
            Write-Log "Created template directory at $templateDir" -Level "INFO"
        }
        
        # Create default template
        $defaultTemplate = @"
# {{ServiceName}}

## Service Overview
{{ServiceDescription}}

**Service ID:** {{ServiceId}}  
**Version:** {{ServiceVersion}}  
**Category:** {{ServiceCategory}}  
**Status:** {{ServiceStatus}}  
**Owner:** {{ServiceOwner}}  
**Last Updated:** {{LastUpdated}}

## Technical Specifications

### Architecture
{{ServiceArchitecture}}

### Dependencies
{{ServiceDependencies}}

### API Reference
{{ApiReference}}

### Data Model
{{DataModel}}

### Configuration
{{ConfigurationOptions}}

## Integration Guide

### Prerequisites
{{IntegrationPrerequisites}}

### Authentication
{{AuthenticationMethod}}

### Request/Response Examples
{{RequestResponseExamples}}

### Error Handling
{{ErrorHandling}}

## Usage Examples

### Basic Implementation
```{{CodeLanguage}}
{{BasicImplementationExample}}
```

### Advanced Scenarios
{{AdvancedScenarios}}

## Performance Considerations
{{PerformanceConsiderations}}

## Security Notes
{{SecurityNotes}}

## Service Level Agreement
{{ServiceLevelAgreement}}

## Support Information
For support with this service, please contact:
- **Email:** {{SupportEmail}}
- **Team:** {{SupportTeam}}
- **Hours:** {{SupportHours}}

## Version History
{{VersionHistory}}

_Updated {{UpdateDate}} | AI: Cursor (Claude 3.7 Sonnet)_
"@
        
        Set-Content -Path $templateFullPath -Value $defaultTemplate
        Write-Log "Created default documentation template at $templateFullPath" -Level "INFO"
        
        return $defaultTemplate
    }
    
    try {
        $template = Get-Content -Path $templateFullPath -Raw
        Write-Log "Loaded documentation template from $templateFullPath" -Level "INFO"
        return $template
    }
    catch {
        Write-Log "Error loading documentation template: $_" -Level "ERROR"
        throw "Failed to load documentation template. See log for details."
    }
}

# Function to generate technical details for a service
function Generate-TechnicalDetails {
    param (
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service
    )
    
    # This function would normally analyze service code, configuration, and other details
    # to generate technical documentation. For this example, we'll generate placeholder content.
    
    $architectureInfo = switch ($Service.category) {
        "Data Processing" { 
            "The $($Service.name) service follows a data pipeline architecture with multiple processing stages:
            
1. Data Ingestion Layer - Handles incoming data from various sources
2. Processing Layer - Applies business logic and transformations
3. Storage Layer - Persists processed data in appropriate storage systems
4. API Layer - Provides standardized access to processed data"
        }
        "Integration" { 
            "The $($Service.name) service uses an event-driven architecture with the following components:

1. Event Listeners - Monitor for integration triggers
2. Transformation Engine - Converts data between different formats
3. Routing Rules - Direct integrated data to appropriate destinations
4. Logging & Monitoring - Track integration activity and performance"
        }
        "Analytics" { 
            "The $($Service.name) service employs a distributed analytics architecture:

1. Data Collection Layer - Aggregates data from multiple sources
2. Processing Cluster - Distributes analytical workloads
3. Model Management - Maintains analytical models and parameters
4. Visualization API - Provides interfaces for displaying results"
        }
        default { 
            "The $($Service.name) service uses a standard microservice architecture with:

1. REST API Interface - Public-facing endpoints
2. Business Logic Layer - Core service functionality
3. Data Access Layer - Interface with persistence systems
4. Security Layer - Access control and authentication"
        }
    }
    
    # Generate placeholder dependencies based on service category
    $dependencies = @()
    
    if ($Service.category -eq "Data Processing") {
        $dependencies += "- **Database Service** - For persistent storage of processed data"
        $dependencies += "- **Message Queue** - For asynchronous processing of data batches"
    }
    elseif ($Service.category -eq "Integration") {
        $dependencies += "- **Authentication Service** - For validating integration requests"
        $dependencies += "- **Data Transformation Service** - For format conversion"
    }
    elseif ($Service.category -eq "Analytics") {
        $dependencies += "- **Data Lake Service** - For storing large analytical datasets"
        $dependencies += "- **Machine Learning Service** - For predictive capabilities"
    }
    else {
        $dependencies += "- **Authentication Service** - For user/client authentication"
        $dependencies += "- **Logging Service** - For activity tracking"
    }
    
    $dependencies += "- **Configuration Service** - For centralized service configuration"
    
    return @{
        Architecture = $architectureInfo
        Dependencies = ($dependencies -join "`n")
        ApiReference = "Detailed API documentation is available in the [API Reference Guide](../api-reference/$($Service.id).md)."
        DataModel = "The service utilizes the following data models:`n`n- ${$Service.name}Request`n- ${$Service.name}Response`n- ${$Service.name}Configuration"
        ConfigurationOptions = "The service supports the following configuration options:`n`n- **connectionTimeout**: Maximum connection time in milliseconds (default: 30000)`n- **maxRetries**: Maximum number of retry attempts (default: 3)`n- **cacheEnabled**: Whether to enable response caching (default: true)"
    }
}

# Function to generate integration guidance for a service
function Generate-IntegrationGuidance {
    param (
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service
    )
    
    # Generate placeholder integration guidance
    $authMethod = if ($Service.category -eq "Analytics" -or $Service.price -gt 200) {
        "This service requires OAuth 2.0 authentication with the following scopes:
        
- `${$Service.id}:read` - For read operations
- `${$Service.id}:write` - For write operations

Authentication tokens should be included in the Authorization header:
```
Authorization: Bearer {token}
```"
    }
    else {
        "This service uses API key authentication. Include your API key in the X-API-Key header:
```
X-API-Key: your_api_key_here
```

API keys can be obtained from the Service Portal."
    }
    
    $errorHandling = @"
The service returns standard HTTP status codes:

- **200 OK** - Request successful
- **400 Bad Request** - Invalid input parameters
- **401 Unauthorized** - Authentication failure
- **403 Forbidden** - Insufficient permissions
- **404 Not Found** - Resource not found
- **429 Too Many Requests** - Rate limit exceeded
- **500 Internal Server Error** - Server-side error

Error responses include a JSON body with additional details:
```json
{
  "error": {
    "code": "ERROR_CODE",
    "message": "Human-readable error message",
    "details": {
      "field": "Specific field with error",
      "reason": "Detailed reason for the error"
    }
  }
}
```
"@
    
    $requestExample = switch ($Service.category) {
        "Data Processing" {
@"
```http
POST /api/v1/${$Service.id}/process HTTP/1.1
Host: api.cfish.io
Content-Type: application/json
X-API-Key: your_api_key_here

{
  "data": {
    "id": "data-123",
    "attributes": {
      "field1": "value1",
      "field2": "value2"
    }
  },
  "options": {
    "processingLevel": "standard"
  }
}
```

Response:
```json
{
  "result": {
    "id": "result-456",
    "status": "completed",
    "processingTime": 235,
    "data": {
      "processedField1": "processed_value1",
      "processedField2": "processed_value2"
    }
  }
}
```
"@
        }
        "Integration" {
@"
```http
POST /api/v1/${$Service.id}/connect HTTP/1.1
Host: api.cfish.io
Content-Type: application/json
X-API-Key: your_api_key_here

{
  "source": {
    "system": "system_a",
    "endpoint": "/data/export",
    "credentials": {
      "token": "source_system_token"
    }
  },
  "destination": {
    "system": "system_b",
    "endpoint": "/data/import",
    "credentials": {
      "apiKey": "destination_system_key"
    }
  },
  "mappings": [
    {
      "source": "field_a",
      "destination": "field_b",
      "transformation": "uppercase"
    }
  ]
}
```

Response:
```json
{
  "connection": {
    "id": "conn-789",
    "status": "active",
    "createdAt": "2025-03-19T14:22:10Z",
    "lastSyncTime": null
  }
}
```
"@
        }
        default {
@"
```http
GET /api/v1/${$Service.id}/resources/123 HTTP/1.1
Host: api.cfish.io
X-API-Key: your_api_key_here
```

Response:
```json
{
  "resource": {
    "id": "123",
    "name": "Example Resource",
    "status": "active",
    "createdAt": "2025-03-15T10:30:00Z",
    "attributes": {
      "key1": "value1",
      "key2": "value2"
    }
  }
}
```
"@
        }
    }
    
    return @{
        Prerequisites = "Before integrating with this service, ensure you have:`n`n- A valid service account with appropriate permissions`n- Network access to the service endpoints`n- Required dependencies installed in your environment"
        AuthenticationMethod = $authMethod
        RequestResponseExamples = $requestExample
        ErrorHandling = $errorHandling
    }
}

# Function to generate usage examples for a service
function Generate-UsageExamples {
    param (
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service
    )
    
    # Determine the most appropriate language for examples based on service category
    $language = switch ($Service.category) {
        "Data Processing" { "python" }
        "Integration" { "javascript" }
        "Analytics" { "python" }
        default { "csharp" }
    }
    
    # Generate a basic implementation example based on the language
    $basicExample = switch ($language) {
        "python" {
@"
import requests

API_KEY = "your_api_key_here"
BASE_URL = "https://api.cfish.io/api/v1/${$Service.id}"

def process_data(data_payload):
    headers = {
        "X-API-Key": API_KEY,
        "Content-Type": "application/json"
    }
    
    response = requests.post(f"{BASE_URL}/process", 
                            json=data_payload, 
                            headers=headers)
    
    if response.status_code == 200:
        return response.json()
    else:
        raise Exception(f"Error: {response.status_code}, {response.text}")

# Example usage
payload = {
    "data": {
        "id": "data-123",
        "attributes": {
            "field1": "value1",
            "field2": "value2"
        }
    },
    "options": {
        "processingLevel": "standard"
    }
}

result = process_data(payload)
print(f"Processing completed in {result['result']['processingTime']}ms")
"@
        }
        "javascript" {
@"
const axios = require('axios');

const API_KEY = 'your_api_key_here';
const BASE_URL = 'https://api.cfish.io/api/v1/${$Service.id}';

async function connectSystems(sourceSystem, destinationSystem, mappings) {
  try {
    const response = await axios.post(`${BASE_URL}/connect`, {
      source: sourceSystem,
      destination: destinationSystem,
      mappings: mappings
    }, {
      headers: {
        'X-API-Key': API_KEY,
        'Content-Type': 'application/json'
      }
    });
    
    return response.data;
  } catch (error) {
    console.error('Integration error:', error.response ? error.response.data : error.message);
    throw error;
  }
}

// Example usage
const sourceSystem = {
  system: 'system_a',
  endpoint: '/data/export',
  credentials: {
    token: 'source_system_token'
  }
};

const destinationSystem = {
  system: 'system_b',
  endpoint: '/data/import',
  credentials: {
    apiKey: 'destination_system_key'
  }
};

const fieldMappings = [
  {
    source: 'field_a',
    destination: 'field_b',
    transformation: 'uppercase'
  }
];

connectSystems(sourceSystem, destinationSystem, fieldMappings)
  .then(result => console.log('Connection established:', result.connection.id))
  .catch(error => console.error('Failed to establish connection'));
"@
        }
        "csharp" {
@"
using System;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using System.Threading.Tasks;

public class ${$Service.name}Client
{
    private readonly HttpClient _httpClient;
    private readonly string _apiKey;
    private readonly string _baseUrl;

    public ${$Service.name}Client(string apiKey)
    {
        _httpClient = new HttpClient();
        _apiKey = apiKey;
        _baseUrl = "https://api.cfish.io/api/v1/${$Service.id}";
    }

    public async Task<ResourceResponse> GetResourceAsync(string resourceId)
    {
        _httpClient.DefaultRequestHeaders.Clear();
        _httpClient.DefaultRequestHeaders.Add("X-API-Key", _apiKey);

        var response = await _httpClient.GetAsync($"{_baseUrl}/resources/{resourceId}");
        response.EnsureSuccessStatusCode();

        var content = await response.Content.ReadAsStringAsync();
        return JsonSerializer.Deserialize<ResourceResponse>(content);
    }
}

// Example resource model
public class ResourceResponse
{
    public Resource Resource { get; set; }
}

public class Resource
{
    public string Id { get; set; }
    public string Name { get; set; }
    public string Status { get; set; }
    public DateTime CreatedAt { get; set; }
    public Dictionary<string, string> Attributes { get; set; }
}

// Example usage
public class Program
{
    public static async Task Main()
    {
        var client = new ${$Service.name}Client("your_api_key_here");
        
        try
        {
            var resource = await client.GetResourceAsync("123");
            Console.WriteLine($"Resource name: {resource.Resource.Name}, Status: {resource.Resource.Status}");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error retrieving resource: {ex.Message}");
        }
    }
}
"@
        }
    }
    
    # Generate advanced scenarios
    $advancedScenarios = @"
### Batch Processing

For high-volume operations, the service supports batch processing:

```${$language}
# Batch processing example code would be provided here
```

### Webhook Integration

The service can send webhook notifications when specific events occur:

1. Register a webhook endpoint in your service portal
2. Configure the events that should trigger notifications
3. Implement a webhook handler in your application

### Offline Operation

For scenarios with limited connectivity, the service supports offline operation:

1. Cache service responses for offline use
2. Queue operations when offline
3. Sync queued operations when connectivity is restored
"@
    
    return @{
        CodeLanguage = $language
        BasicImplementationExample = $basicExample
        AdvancedScenarios = $advancedScenarios
    }
}

# Function to generate performance and security information
function Generate-OperationalInfo {
    param (
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service
    )
    
    # Generate performance considerations based on service pricing tier
    $performanceInfo = if ($Service.price -lt 100) {
@"
This service is designed for standard workloads with the following characteristics:

- **Request Rate Limit**: 100 requests per minute
- **Max Response Time**: 500ms (95th percentile)
- **Concurrent Connections**: Up to 50
- **Data Volume**: Up to 10MB per request

For higher performance requirements, consider upgrading to the premium tier.
"@
    }
    elseif ($Service.price -lt 300) {
@"
This service is optimized for high-throughput applications with the following characteristics:

- **Request Rate Limit**: 500 requests per minute
- **Max Response Time**: 200ms (95th percentile)
- **Concurrent Connections**: Up to 200
- **Data Volume**: Up to 50MB per request

For best performance:
- Implement connection pooling
- Use batch operations for multiple items
- Cache frequently accessed resources
"@
    }
    else {
@"
This enterprise-grade service is designed for mission-critical applications with the following characteristics:

- **Request Rate Limit**: 2000 requests per minute
- **Max Response Time**: 100ms (95th percentile)
- **Concurrent Connections**: Up to 1000
- **Data Volume**: Up to 200MB per request

Performance optimization recommendations:
- Use the dedicated regional endpoints for your geographic location
- Implement exponential backoff for retries
- Monitor your usage patterns and optimize high-volume operations
- Consider using the streaming API for large datasets
"@
    }
    
    # Generate security notes
    $securityInfo = @"
This service follows security best practices:

- All data is encrypted in transit using TLS 1.3
- Sensitive data is encrypted at rest using AES-256
- Authentication uses industry-standard protocols
- Regular security audits and penetration testing
- Compliance with relevant industry standards

Security recommendations:
- Rotate API keys regularly
- Use the principle of least privilege when assigning permissions
- Monitor service usage for unusual patterns
- Validate and sanitize all inputs before sending to the service
"@
    
    # Generate SLA information based on pricing tier
    $slaInfo = if ($Service.price -lt 100) {
@"
**Standard Tier SLA:**
- **Availability**: 99.5% uptime
- **Support Response Time**: Within 24 hours (business days)
- **Scheduled Maintenance**: With 48 hours notice
"@
    }
    elseif ($Service.price -lt 300) {
@"
**Professional Tier SLA:**
- **Availability**: 99.9% uptime
- **Support Response Time**: Within 8 hours (business days)
- **Scheduled Maintenance**: With 72 hours notice
- **Service Credits**: Available for SLA violations
"@
    }
    else {
@"
**Enterprise Tier SLA:**
- **Availability**: 99.99% uptime
- **Support Response Time**: Within 4 hours (24/7)
- **Scheduled Maintenance**: With 1 week notice
- **Service Credits**: Automatic for SLA violations
- **Dedicated Support Contact**: Available for critical issues
"@
    }
    
    return @{
        PerformanceConsiderations = $performanceInfo
        SecurityNotes = $securityInfo
        ServiceLevelAgreement = $slaInfo
    }
}

# Function to apply template to service information
function Apply-ServiceTemplate {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Template,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$TechnicalDetails,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$IntegrationGuidance,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$UsageExamples,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$OperationalInfo
    )
    
    $result = $Template
    
    # Replace basic service information
    $result = $result.Replace("{{ServiceName}}", $Service.name)
    $result = $result.Replace("{{ServiceDescription}}", $Service.description)
    $result = $result.Replace("{{ServiceId}}", $Service.id)
    $result = $result.Replace("{{ServiceVersion}}", $Service.version)
    $result = $result.Replace("{{ServiceCategory}}", $Service.category)
    $result = $result.Replace("{{ServiceStatus}}", $Service.status)
    $result = $result.Replace("{{ServiceOwner}}", $Service.owner)
    $result = $result.Replace("{{LastUpdated}}", (Get-Date -Format "yyyy-MM-dd"))
    
    # Replace technical details
    $result = $result.Replace("{{ServiceArchitecture}}", $TechnicalDetails.Architecture)
    $result = $result.Replace("{{ServiceDependencies}}", $TechnicalDetails.Dependencies)
    $result = $result.Replace("{{ApiReference}}", $TechnicalDetails.ApiReference)
    $result = $result.Replace("{{DataModel}}", $TechnicalDetails.DataModel)
    $result = $result.Replace("{{ConfigurationOptions}}", $TechnicalDetails.ConfigurationOptions)
    
    # Replace integration guidance
    $result = $result.Replace("{{IntegrationPrerequisites}}", $IntegrationGuidance.Prerequisites)
    $result = $result.Replace("{{AuthenticationMethod}}", $IntegrationGuidance.AuthenticationMethod)
    $result = $result.Replace("{{RequestResponseExamples}}", $IntegrationGuidance.RequestResponseExamples)
    $result = $result.Replace("{{ErrorHandling}}", $IntegrationGuidance.ErrorHandling)
    
    # Replace usage examples
    $result = $result.Replace("{{CodeLanguage}}", $UsageExamples.CodeLanguage)
    $result = $result.Replace("{{BasicImplementationExample}}", $UsageExamples.BasicImplementationExample)
    $result = $result.Replace("{{AdvancedScenarios}}", $UsageExamples.AdvancedScenarios)
    
    # Replace operational information
    $result = $result.Replace("{{PerformanceConsiderations}}", $OperationalInfo.PerformanceConsiderations)
    $result = $result.Replace("{{SecurityNotes}}", $OperationalInfo.SecurityNotes)
    $result = $result.Replace("{{ServiceLevelAgreement}}", $OperationalInfo.ServiceLevelAgreement)
    
    # Replace support information with generic values
    $result = $result.Replace("{{SupportEmail}}", "support@cfish.io")
    $result = $result.Replace("{{SupportTeam}}", "cFish.io Support Team")
    $result = $result.Replace("{{SupportHours}}", "Monday-Friday, 9am-5pm EST")
    
    # Replace version history with placeholder
    $result = $result.Replace("{{VersionHistory}}", "- **${$Service.version}** ($(Get-Date -Format 'yyyy-MM-dd')) - Initial documentation")
    
    # Replace update date
    $result = $result.Replace("{{UpdateDate}}", (Get-Date -Format "MM-dd-yyyy"))
    
    return $result
}

# Function to generate enhanced documentation for a service
function Generate-EnhancedDocumentation {
    param (
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Service,
        
        [Parameter(Mandatory = $true)]
        [string]$Template,
        
        [Parameter(Mandatory = $true)]
        [string]$OutputDirectory
    )
    
    Write-Log "Generating enhanced documentation for service: $($Service.name) ($($Service.id))" -Level "INFO"
    
    try {
        # Generate detailed information
        $technicalDetails = Generate-TechnicalDetails -Service $Service
        $integrationGuidance = Generate-IntegrationGuidance -Service $Service
        $usageExamples = Generate-UsageExamples -Service $Service
        $operationalInfo = Generate-OperationalInfo -Service $Service
        
        # Apply template
        $document = Apply-ServiceTemplate -Template $Template `
                                       -Service $Service `
                                       -TechnicalDetails $technicalDetails `
                                       -IntegrationGuidance $integrationGuidance `
                                       -UsageExamples $usageExamples `
                                       -OperationalInfo $operationalInfo
        
        # Create output directory if it doesn't exist
        $outputDirFullPath = Join-Path -Path $PSScriptRoot -ChildPath $OutputDirectory
        if (-not (Test-Path -Path $outputDirFullPath)) {
            New-Item -Path $outputDirFullPath -ItemType Directory -Force | Out-Null
            Write-Log "Created output directory at $outputDirFullPath" -Level "INFO"
        }
        
        # Save document
        $outputFilePath = Join-Path -Path $outputDirFullPath -ChildPath "$($Service.id).md"
        Set-Content -Path $outputFilePath -Value $document
        
        Write-Log "Enhanced documentation saved to $outputFilePath" -Level "INFO"
        
        return $outputFilePath
    }
    catch {
        Write-Log "Error generating enhanced documentation for service $($Service.id): $_" -Level "ERROR"
        return $null
    }
}

# Main execution
try {
    Write-Log "Starting Service Documentation Enhancement" -Level "INFO"
    Write-Log "Parameters: ServiceCatalogPath=$ServiceCatalogPath, OutputDirectory=$OutputDirectory, GenerateAll=$GenerateAll, TargetService=$TargetService" -Level "INFO"
    
    # Load service catalog
    $catalog = Load-ServiceCatalog -ServiceCatalogPath $ServiceCatalogPath
    
    # Load documentation template
    $template = Load-DocumentationTemplate -TemplatePath $TemplatePath
    
    # Create Templates directory if it doesn't exist
    $templatesDir = Join-Path -Path $PSScriptRoot -ChildPath "Templates"
    if (-not (Test-Path -Path $templatesDir)) {
        New-Item -Path $templatesDir -ItemType Directory -Force | Out-Null
        Write-Log "Created Templates directory" -Level "INFO"
    }
    
    # Determine which services to process
    $servicesToProcess = @()
    
    if ($GenerateAll) {
        $servicesToProcess = $catalog.services
        Write-Log "Generating enhanced documentation for all $($servicesToProcess.Count) services" -Level "INFO"
    }
    elseif ($TargetService -ne "") {
        $targetServiceObj = $catalog.services | Where-Object { $_.id -eq $TargetService }
        
        if ($targetServiceObj) {
            $servicesToProcess = @($targetServiceObj)
            Write-Log "Generating enhanced documentation for service $TargetService" -Level "INFO"
        }
        else {
            Write-Log "Service with ID $TargetService not found in catalog" -Level "ERROR"
            exit 1
        }
    }
    else {
        # Default behavior: process services that need documentation updates
        $servicesToProcess = $catalog.services | Where-Object { $_.status -eq "active" -or $_.status -eq "beta" }
        Write-Log "Generating enhanced documentation for $($servicesToProcess.Count) active and beta services" -Level "INFO"
    }
    
    # Process each service
    $successCount = 0
    $failureCount = 0
    $processedServices = @()
    
    foreach ($service in $servicesToProcess) {
        $result = Generate-EnhancedDocumentation -Service $service -Template $template -OutputDirectory $OutputDirectory
        
        if ($result) {
            $successCount++
            $processedServices += @{
                ServiceId = $service.id
                ServiceName = $service.name
                DocumentationPath = $result
                Status = "Success"
            }
        }
        else {
            $failureCount++
            $processedServices += @{
                ServiceId = $service.id
                ServiceName = $service.name
                DocumentationPath = $null
                Status = "Failed"
            }
        }
    }
    
    # Generate summary report
    $reportFile = Join-Path -Path $logDir -ChildPath "documentation-enhancement-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $reportContent = @"
# Service Documentation Enhancement Report

## Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Services Processed**: $($successCount + $failureCount)
- **Successfully Enhanced**: $successCount
- **Failed**: $failureCount

## Service Status

| Service ID | Service Name | Status | Documentation Path |
|------------|--------------|--------|-------------------|
$(foreach ($service in $processedServices) {
"| $($service.ServiceId) | $($service.ServiceName) | $($service.Status) | $($service.DocumentationPath) |"
})

## Next Steps
1. Review the enhanced documentation for accuracy and completeness
2. Obtain approvals from service owners and stakeholders
3. Publish the enhanced documentation to the service portal
4. Schedule regular documentation reviews and updates

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $reportContent
    Write-Log "Generated documentation enhancement report at $reportFile" -Level "INFO"
    
    Write-Host "`nService Documentation Enhancement completed." -ForegroundColor Green
    Write-Host "Successfully enhanced $successCount services. Failed: $failureCount" -ForegroundColor Cyan
    Write-Host "See report for details: $reportFile" -ForegroundColor Cyan
    
    # Exit with error code if any failures
    if ($failureCount -gt 0) {
        exit 1
    }
    else {
        exit 0
    }
}
catch {
    Write-Log "Fatal error in Service Documentation Enhancement: $_" -Level "ERROR"
    Write-Log $_.ScriptStackTrace -Level "ERROR"
    
    Write-Host "`nERROR: Service Documentation Enhancement failed with an error." -ForegroundColor Red
    Write-Host "See log file for details: $logFile" -ForegroundColor Red
    
    exit 9999
} 