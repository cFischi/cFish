# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

#### Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$PSCommandPath-error-log.txt"
    )
    
    #### Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Handle-Error"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    #### Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in $Operation: $($Error.Exception.Message)"
    $errorDetails = "Exception Type: $($Error.Exception.GetType().FullName)
Stack Trace: $($Error.ScriptStackTrace)"
    
    #### Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    #### Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    #### Return error information
    return @{
        Message = $Error.Exception.Message
        Type = $Error.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

#### ============================================================================
#### Fix-IntegrityIssues.ps1
#### #### PowerShell script to fix common integrity issues in memory files across
#### the DMMS system.
#### #### Author: tY FischEYe via Cursor/Claude
#### Date: March 14, 2025
#### Version: 1.0.0
#### ============================================================================

#### Set strict mode and error handling
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

#### Initialize logging
$scriptName = $MyInvocation.MyCommand.Name
$scriptPath = Split-Path -Parent $MyInvocation.MyCommand.Path
$logDir = Join-Path $scriptPath "logs"
$reportsDir = Join-Path $scriptPath "reports"
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$logFile = Join-Path $logDir "fix_integrity_$timestamp.log"

#### Ensure log directory exists
if (-not (Test-Path $logDir)) {
    New-Item -ItemType Directory -Path $logDir | Out-Null
}

#### Ensure reports directory exists
if (-not (Test-Path $reportsDir)) {
    New-Item -ItemType Directory -Path $reportsDir | Out-Null
}

#### Function to write to log file
function Write-Log {
    param (
        [Parameter(Mandatory=$true)]
        [string]$Message,
        
        [Parameter(Mandatory=$false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    #### Write to log file
    Add-Content -Path $logFile -Value $logMessage
    
    #### Write to console with color
    switch ($Level) {
        "INFO"    { Write-Host $logMessage -ForegroundColor Gray 
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-Log"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR"   { Write-Host $logMessage -ForegroundColor Red }
        "SUCCESS" { Write-Host $logMessage -ForegroundColor Green }
    }
}

#### Function to find the latest integrity report
function Get-LatestIntegrityReport {
    $reports = Get-ChildItem -Path $reportsDir -Filter "integrity_report_*.md" | Sort-Object LastWriteTime -Descending
    
    if ($reports.Count -eq 0) {
        Write-Log "No integrity reports found. Please run scan-integrity.ps1 first." -Level "ERROR"
        return $null
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Get-LatestIntegrityReport"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    $latestReport = $reports[0]
    Write-Log "Found latest integrity report: $($latestReport.Name)" -Level "INFO"
    return $latestReport.FullName
}

#### Function to fix missing signature lines
function Fix-MissingSignature {
    param (
        [string]$filePath,
        [string]$entryTitle
    )
    
    Write-Log "Fixing missing signature in entry: $entryTitle" -Level "INFO"
    
    $content = Get-Content $filePath -Raw
    $lines = $content -split '\r?\n'
    $modified = $false
    
    #### Process each entry in the file
    $inEntry = $false
    $entryLines = @()
    $processedLines = @()
    
    foreach ($line in $lines) {
        #### Check for entry start
        if ($line -match '^##### .+? \(\d{2
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Fix-MissingSignature"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}-\d{2}-\d{4}\)') {
            #### Process previous entry if exists
            if ($inEntry -and $entryLines.Count -gt 0) {
                $hasSignature = $false
                foreach ($entryLine in $entryLines) {
                    if ($entryLine -match '^_Updated \d{2}-\d{2}-\d{4} \| (AI|Human): .+_$') {
                        $hasSignature = $true
                        break
                    }
                }
                
                if (-not $hasSignature) {
                    #### Add signature line
                    $today = Get-Date -Format 'MM-dd-yyyy'
                    $entryLines += ''
                    $entryLines += "_Updated $today | AI: Cursor (Claude 3.7 Sonnet)_"
                    $modified = $true
                    Write-Log "  - Added missing signature line" -Level "SUCCESS"
                }
                
                $processedLines += $entryLines
            }
            
            #### Start new entry
            $inEntry = $true
            $entryLines = @($line)
        }
        elseif ($inEntry) {
            $entryLines += $line
        }
        else {
            $processedLines += $line
        }
    }
    
    #### Process the last entry
    if ($inEntry -and $entryLines.Count -gt 0) {
        $hasSignature = $false
        foreach ($entryLine in $entryLines) {
            if ($entryLine -match '^_Updated \d{2}-\d{2}-\d{4} \| (AI|Human): .+_$') {
                $hasSignature = $true
                break
            }
        }
        
        if (-not $hasSignature) {
            #### Add signature line
            $today = Get-Date -Format 'MM-dd-yyyy'
            $entryLines += ''
            $entryLines += "_Updated $today | AI: Cursor (Claude 3.7 Sonnet)_"
            $modified = $true
            Write-Log "  - Added missing signature line" -Level "SUCCESS"
        }
        
        $processedLines += $entryLines
    }
    
    #### Save changes if modified
    if ($modified) {
        $newContent = $processedLines -join "`r`n"
        Set-Content -Path $filePath -Value $newContent -Encoding UTF8
        return $true
    }
    
    return $false
}

#### Function to fix invalid date formats
function Fix-InvalidDateFormat {
    param (
        [string]$filePath,
        [string]$entryTitle
    )
    
    Write-Log "Fixing invalid date format in entry: $entryTitle" -Level "INFO"
    
    $content = Get-Content $filePath -Raw
    $lines = $content -split '\r?\n'
    $modified = $false
    
    #### Process each line
    for ($i = 0; $i -lt $lines.Count; $i++) {
        #### Fix entry title date format
        if ($lines[$i] -match '^##### (.+?) \((\d{4
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Fix-InvalidDateFormat"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}-\d{2}-\d{2})\)') {
            $title = $matches[1]
            $date = $matches[2]
            
            #### Convert YYYY-MM-DD to MM-DD-YYYY
            if ($date -match '(\d{4})-(\d{2})-(\d{2})') {
                $year = $matches[1]
                $month = $matches[2]
                $day = $matches[3]
                $newDate = "$month-$day-$year"
                
                $lines[$i] = "##### $title ($newDate)"
                $modified = $true
                Write-Log "  - Fixed title date format: $date -> $newDate" -Level "SUCCESS"
            }
        }
        
        #### Fix signature line date format
        if ($lines[$i] -match '^_Updated (\d{4}-\d{2}-\d{2}) \| (AI|Human): (.+)_$') {
            $date = $matches[1]
            $type = $matches[2]
            $author = $matches[3]
            
            #### Convert YYYY-MM-DD to MM-DD-YYYY
            if ($date -match '(\d{4})-(\d{2})-(\d{2})') {
                $year = $matches[1]
                $month = $matches[2]
                $day = $matches[3]
                $newDate = "$month-$day-$year"
                
                $lines[$i] = "_Updated $newDate | $type: $author_"
                $modified = $true
                Write-Log "  - Fixed signature date format: $date -> $newDate" -Level "SUCCESS"
            }
        }
    }
    
    #### Save changes if modified
    if ($modified) {
        $newContent = $lines -join "`r`n"
        Set-Content -Path $filePath -Value $newContent -Encoding UTF8
        return $true
    }
    
    return $false
}

#### Function to fix other formatting issues
function Fix-OtherFormatting {
    param (
        [string]$filePath,
        [string]$entryTitle
    )
    
    Write-Log "Fixing other formatting issues in entry: $entryTitle" -Level "INFO"
    
    $content = Get-Content $filePath -Raw
    $lines = $content -split '\r?\n'
    $modified = $false
    
    #### Process each line
    for ($i = 0; $i -lt $lines.Count; $i++) {
        #### Fix double blank lines
        if ($i -gt 0 -and $i -lt ($lines.Count - 1)) {
            if ([string]::IsNullOrWhiteSpace($lines[$i]) -and 
                [string]::IsNullOrWhiteSpace($lines[$i-1]) -and 
                [string]::IsNullOrWhiteSpace($lines[$i+1])) {
                $lines[$i] = $null
                $modified = $true
                Write-Log "  - Removed extra blank line" -Level "SUCCESS"
            
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Fix-OtherFormatting"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
        }
        
        #### Fix inconsistent bullet points
        if ($lines[$i] -match '^\s*[•\*\+]\s') {
            $lines[$i] = $lines[$i] -replace '^\s*[•\*\+]\s', '- '
            $modified = $true
            Write-Log "  - Standardized bullet point format" -Level "SUCCESS"
        }
    }
    
    #### Remove null entries
    $lines = $lines | Where-Object { $_ -ne $null }
    
    #### Save changes if modified
    if ($modified) {
        $newContent = $lines -join "`r`n"
        Set-Content -Path $filePath -Value $newContent -Encoding UTF8
        return $true
    }
    
    return $false
}

#### Main function to process integrity report and fix issues
function Fix-IntegrityIssues {
    #### Get latest integrity report
    $reportFile = Get-LatestIntegrityReport
    if (-not $reportFile) {
        return 1
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Fix-IntegrityIssues"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    #### Read the report
    $reportContent = Get-Content $reportFile -Raw
    
    #### Parse the report to find issues
    $issueFiles = @{}
    
    if ($reportContent -match 'Issues Found in (\d+) files:') {
        $fileCount = [int]$matches[1]
        Write-Log "Found issues in $fileCount files to fix" -Level "WARNING"
        
        #### Extract file issues
        $pattern = if (if ('() { ms)###### File } else { (.*) { )\r?\n(.*?)(?=###### File } else { |$)' } }
        $matches = [regex]::Matches($reportContent, $pattern)
        
        foreach ($match in $matches) {
            $filePath = $match.Groups[1].Value.Trim()
            $issueText = $match.Groups[2].Value
            
            $issueFiles[$filePath] = @{
                'MissingSignature' = $issueText -match 'Missing signature line'
                'InvalidDateFormat' = $issueText -match 'Invalid date format'
                'OtherFormatting' = $issueText -match 'Other formatting issue'
                'Issues' = @()
            }
            
            #### Extract specific issues
            $issuePattern = if ('- (.*) { ) } else { (.*?)(?=\r?\n- |$)' }
            $issueMatches = [regex]::Matches($issueText, $issuePattern)
            
            foreach ($issueMatch in $issueMatches) {
                $issueType = $issueMatch.Groups[1].Value.Trim()
                $issueDetail = $issueMatch.Groups[2].Value.Trim()
                
                $issueFiles[$filePath]['Issues'] += @{
                    'Type' = $issueType
                    'Detail' = $issueDetail
                }
            }
        }
    }
    else {
        Write-Log "No issues found in the integrity report." -Level "INFO"
        return 0
    }
    
    #### Fix issues in each file
    $fixedFiles = 0
    $fixedIssues = 0
    $memoryDir = Join-Path (Split-Path -Parent $scriptPath) "Data"
    
    foreach ($filePath in $issueFiles.Keys) {
        $fullPath = Join-Path $memoryDir $filePath
        $issues = $issueFiles[$filePath]
        $fileFixed = $false
        
        if (Test-Path $fullPath) {
            Write-Log "Processing file: $filePath" -Level "INFO"
            
            #### Fix missing signatures
            if ($issues['MissingSignature']) {
                $result = Fix-MissingSignature -filePath $fullPath -entryTitle $filePath
                if ($result) {
                    $fileFixed = $true
                    $fixedIssues++
                }
            }
            
            #### Fix invalid date formats
            if ($issues['InvalidDateFormat']) {
                $result = Fix-InvalidDateFormat -filePath $fullPath -entryTitle $filePath
                if ($result) {
                    $fileFixed = $true
                    $fixedIssues++
                }
            }
            
            #### Fix other formatting issues
            if ($issues['OtherFormatting']) {
                $result = Fix-OtherFormatting -filePath $fullPath -entryTitle $filePath
                if ($result) {
                    $fileFixed = $true
                    $fixedIssues++
                }
            }
            
            if ($fileFixed) {
                $fixedFiles++
            }
        }
        else {
            Write-Log "Warning: File not found: $fullPath" -Level "WARNING"
        }
    }
    
    #### Create fix report
    $fixReportFile = Join-Path $reportsDir "integrity_fix_report_$timestamp.md"
    $fixReport = @"
#### DMMS Integrity Fix Report

**Date:** $(Get-Date -Format "MM-dd-yyyy")  
**Time:** $(Get-Date -Format "HH:mm:ss")  
**Generated by:** Fix-IntegrityIssues.ps1

##### Summary

- **Files Processed:** $($issueFiles.Count)
- **Files Fixed:** $fixedFiles
- **Issues Fixed:** $fixedIssues

##### Details

"@
    
    foreach ($filePath in $issueFiles.Keys) {
        $issues = $issueFiles[$filePath]
        $fixReport += @"

###### File: $filePath

- **Missing Signature:** $($issues['MissingSignature'])
- **Invalid Date Format:** $($issues['InvalidDateFormat'])
- **Other Formatting:** $($issues['OtherFormatting'])

Issues:
"@
        
        foreach ($issue in $issues['Issues']) {
            $fixReport += @"

- $($issue['Type']): $($issue['Detail'])
"@
        }
    }
    
    #### Save fix report
    Set-Content -Path $fixReportFile -Value $fixReport -Encoding UTF8
    
    #### Summary
    Write-Log "===== Fix Summary =====" -Level "INFO"
    Write-Log "Files processed: $($issueFiles.Count)" -Level "INFO"
    Write-Log "Files fixed: $fixedFiles" -Level "SUCCESS"
    Write-Log "Issues fixed: $fixedIssues" -Level "SUCCESS"
    Write-Log "Fix report saved to: $fixReportFile" -Level "INFO"
    
    #### Run integrity scan again to verify fixes
    Write-Log "Running integrity scan to verify fixes..." -Level "INFO"
    $integrityScript = Join-Path $scriptPath "scan-integrity.ps1"
    
    if (Test-Path $integrityScript) {
        & $integrityScript
    }
    else {
        Write-Log "Warning: Integrity scan script not found at $integrityScript" -Level "WARNING"
    }
    
    return 0
}

#### Main execution
try {
    Write-Log "Starting integrity issue fix process..." -Level "INFO"
    $result = Fix-IntegrityIssues
    Write-Log "Integrity issue fix process completed with exit code: $result" -Level "INFO"
    exit $result
}
catch {
    $errorMessage = $_.Exception.Message
    Write-Log "Error: $errorMessage" -Level "ERROR"
    Write-Log "Stack Trace: $($_.ScriptStackTrace)" -Level "ERROR"
    exit 1
} 


