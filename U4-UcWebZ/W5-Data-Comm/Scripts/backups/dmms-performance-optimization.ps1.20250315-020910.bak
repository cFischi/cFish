# dmms-performance-optimization.ps1
# Purpose: Implement performance optimizations for DMMS components
# Created: 2025-03-19
# Author: Claude 3.7 Sonnet

# Set error action preference
$ErrorActionPreference = "Stop"

# Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

# Log file path
$logFile = Join-Path -Path $logDir -ChildPath "performance-optimization-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

# Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    # Write to console
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    # Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

# Function to backup a file before modifying it
function Backup-File {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    }
    
    try {
        $backupDir = Join-Path -Path $PSScriptRoot -ChildPath "backups"
        if (-not (Test-Path -Path $backupDir)) {
            New-Item -Path $backupDir -ItemType Directory -Force | Out-Null
        }
        
        $fileName = Split-Path -Path $FilePath -Leaf
        $backupPath = Join-Path -Path $backupDir -ChildPath "$fileName.$(Get-Date -Format 'yyyyMMdd-HHmmss').bak"
        
        Copy-Item -Path $FilePath -Destination $backupPath -Force
        Write-Log "Created backup of $FilePath at $backupPath"
        return $true
    }
    catch {
        Write-Log "Failed to create backup of $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

# Function to optimize file locking mechanism
function Optimize-FileLocking {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    }
    
    try {
        # Create backup
        $backupSuccess = Backup-File -FilePath $FilePath
        if (-not $backupSuccess) {
            return $false
        }
        
        # Read file content
        $content = Get-Content -Path $FilePath -Raw
        
        # Optimize file locking mechanism by implementing timeout and retry logic
        if ($FilePath.EndsWith("file-locking.ps1")) {
            Write-Log "Optimizing file locking mechanism in $FilePath"
            
            # Update the lock acquisition with timeout and retry logic
            $oldLockCode = @"
function Acquire-FileLock {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$FilePath
    )
    
    `$lockFile = "`$FilePath.lock"
    
    # Check if lock exists
    if (Test-Path -Path `$lockFile) {
        throw "File is locked: `$FilePath"
    }
    
    # Create lock
    Set-Content -Path `$lockFile -Value (Get-Date) -Force
    
    return `$lockFile
}
"@
            
            $newLockCode = @"
function Acquire-FileLock {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$FilePath,
        
        [Parameter(Mandatory = `$false)]
        [int]`$TimeoutSeconds = 10,
        
        [Parameter(Mandatory = `$false)]
        [int]`$RetryIntervalMs = 100
    )
    
    `$lockFile = "`$FilePath.lock"
    `$startTime = Get-Date
    `$acquired = `$false
    
    while (-not `$acquired -and ((Get-Date) - `$startTime).TotalSeconds -lt `$TimeoutSeconds) {
        # Check if lock exists
        if (Test-Path -Path `$lockFile) {
            # Lock exists, but check if it's stale (older than 5 minutes)
            `$lockAge = (Get-Date) - (Get-Item -Path `$lockFile).LastWriteTime
            if (`$lockAge.TotalMinutes -gt 5) {
                Write-Log "Removing stale lock for `$FilePath (age: `$(`$lockAge.TotalMinutes) minutes)" -Level "WARNING"
                Remove-Item -Path `$lockFile -Force
            }
            else {
                # Lock is valid, wait and retry
                Start-Sleep -Milliseconds `$RetryIntervalMs
                continue
            }
        }
        
        # Try to create lock
        try {
            Set-Content -Path `$lockFile -Value (Get-Date) -Force
            `$acquired = `$true
        }
        catch {
            # Another process might have created the lock at the same time
            Start-Sleep -Milliseconds `$RetryIntervalMs
        }
    }
    
    if (-not `$acquired) {
        throw "Failed to acquire lock for `$FilePath after `$TimeoutSeconds seconds"
    }
    
    return `$lockFile
}
"@
            
            # Replace the lock function with optimized version
            $content = $content -replace [regex]::Escape($oldLockCode), $newLockCode
            
            # Update the lock release function to handle errors better
            $oldReleaseCode = @"
function Release-FileLock {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$LockFile
    )
    
    # Remove lock
    Remove-Item -Path `$LockFile -Force
}
"@
            
            $newReleaseCode = @"
function Release-FileLock {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$LockFile
    )
    
    # Remove lock
    if (Test-Path -Path `$LockFile) {
        try {
            Remove-Item -Path `$LockFile -Force
            Write-Log "Released lock: `$LockFile" -Level "INFO"
        }
        catch {
            Write-Log "Failed to release lock: `$LockFile. Error: `$_" -Level "ERROR"
            # Continue execution even if lock removal fails
        }
    }
    else {
        Write-Log "Lock file not found: `$LockFile" -Level "WARNING"
    }
}
"@
            
            # Replace the release function with optimized version
            $content = $content -replace [regex]::Escape($oldReleaseCode), $newReleaseCode
            
            # Add finally blocks to ensure locks are released
            $content = $content -replace "(\s+)# Execute action\s+(\$action\.Invoke\(\))\s+# Release lock\s+Release-FileLock -LockFile \$lockFile", "`$1# Execute action`n`$1try {`n`$1    `$2`n`$1}`n`$1finally {`n`$1    # Release lock`n`$1    Release-FileLock -LockFile `$lockFile`n`$1}"
            
            # Save optimized content
            Set-Content -Path $FilePath -Value $content
            Write-Log "Successfully optimized file locking mechanism in $FilePath"
            return $true
        }
        else {
            Write-Log "$FilePath is not a file locking script" -Level "WARNING"
            return $false
        }
    }
    catch {
        Write-Log "Failed to optimize file locking in $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

# Function to optimize memory usage
function Optimize-MemoryUsage {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    }
    
    try {
        # Create backup
        $backupSuccess = Backup-File -FilePath $FilePath
        if (-not $backupSuccess) {
            return $false
        }
        
        # Read file content
        $content = Get-Content -Path $FilePath -Raw
        
        # Identify script type
        $isMemoryFile = $FilePath.Contains("memory") -and $FilePath.EndsWith(".ps1")
        $isSyncFile = $FilePath.Contains("sync") -and $FilePath.EndsWith(".ps1")
        $isConvertFile = $FilePath.Contains("convert") -and $FilePath.EndsWith(".ps1")
        
        # Apply optimizations based on script type
        if ($isMemoryFile -or $isSyncFile -or $isConvertFile) {
            Write-Log "Optimizing memory usage in $FilePath"
            
            # Add memory optimization functions
            $memoryOptCode = @"

# Memory optimization function
function Optimize-MemoryUsage {
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
    [System.GC]::Collect()
}
"@
            
            # Check if the function already exists
            if (-not ($content -match "function Optimize-MemoryUsage")) {
                # Add memory optimization function to the file
                $functionEnd = $content.LastIndexOf("}")
                $content = $content.Insert($functionEnd + 1, $memoryOptCode)
            }
            
            # Add memory optimization calls after large operations
            if ($isMemoryFile) {
                # Add memory optimization calls after file operations
                $content = $content -replace "(\s+Set-Content.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
                $content = $content -replace "(\s+Add-Content.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
                $content = $content -replace "(\s+Get-Content.*?-Raw.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
            }
            
            if ($isSyncFile) {
                # Add memory optimization calls after sync operations
                $content = $content -replace "(\s+# Sync completed.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
            }
            
            if ($isConvertFile) {
                # Add memory optimization calls after conversion operations
                $content = $content -replace "(\s+# Conversion completed.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
                $content = $content -replace "(\s+ConvertTo-Json.*?\r?\n)", "`$1`r`n    # Optimize memory usage`r`n    Optimize-MemoryUsage`r`n"
            }
            
            # Save optimized content
            Set-Content -Path $FilePath -Value $content
            Write-Log "Successfully optimized memory usage in $FilePath"
            return $true
        }
        else {
            Write-Log "$FilePath is not a memory-intensive script" -Level "INFO"
            return $false
        }
    }
    catch {
        Write-Log "Failed to optimize memory usage in $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

# Main function to implement performance optimizations
function Implement-PerformanceOptimizations {
    Write-Log "Starting DMMS performance optimization implementation"
    
    # Target scripts for optimization
    $fileLockingScript = Join-Path -Path $PSScriptRoot -ChildPath "file-locking.ps1"
    $syncMemoryScript = Join-Path -Path $PSScriptRoot -ChildPath "sync-memory-files.ps1"
    $syncBidirectionalScript = Join-Path -Path $PSScriptRoot -ChildPath "sync-bidirectional.ps1"
    $convertMdToJsonScript = Join-Path -Path $PSScriptRoot -ChildPath "convert-md-to-json.ps1"
    
    # Optimize file locking mechanism
    Write-Log "Optimizing file locking mechanism..."
    $lockOptimizationResult = Optimize-FileLocking -FilePath $fileLockingScript
    
    if ($lockOptimizationResult) {
        Write-Log "File locking optimization completed successfully"
    }
    else {
        Write-Log "File locking optimization failed or was not applicable" -Level "WARNING"
    }
    
    # Optimize memory usage in critical scripts
    Write-Log "Optimizing memory usage in critical scripts..."
    $memoryOptResults = @(
        (Optimize-MemoryUsage -FilePath $syncMemoryScript),
        (Optimize-MemoryUsage -FilePath $syncBidirectionalScript),
        (Optimize-MemoryUsage -FilePath $convertMdToJsonScript)
    )
    
    $successCount = ($memoryOptResults | Where-Object { $_ -eq $true }).Count
    Write-Log "Memory usage optimization completed for $successCount out of $($memoryOptResults.Count) scripts"
    
    # Generate optimization report
    $reportFile = Join-Path -Path $logDir -ChildPath "performance-optimization-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $report = @"
# DMMS Performance Optimization Report

## Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Status**: Completed

## Optimizations Implemented

### File Locking Mechanism
- **Script**: `$fileLockingScript`
- **Status**: $($lockOptimizationResult ? "Completed" : "Not Applicable")
- **Improvements**:
  - Implemented timeout and retry logic for lock acquisition
  - Added stale lock detection and cleanup
  - Enhanced error handling in lock release function
  - Added finally blocks to ensure locks are always released

### Memory Usage Optimization
- **Scripts Optimized**: $successCount out of $($memoryOptResults.Count)
- **Status**: Completed
- **Improvements**:
  - Added explicit garbage collection after memory-intensive operations
  - Optimized file reading and writing operations
  - Implemented memory cleanup after large data processing

## Next Steps
1. Run performance benchmarks to measure optimization impact
2. Monitor memory usage in production for improved performance
3. Implement additional optimizations if needed
4. Update documentation to reflect optimized components

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $report
    Write-Log "Created performance optimization report at $reportFile"
    
    Write-Host "`nDMMS performance optimization completed. See $reportFile for details." -ForegroundColor Green
}

# Execute performance optimizations
Implement-PerformanceOptimizations 