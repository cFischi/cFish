<#
.SYNOPSIS
    Fixes common PowerShell syntax issues in script files.

.DESCRIPTION
    This script scans PowerShell script files in the specified directory and fixes common syntax issues:
    - Ternary operator compatibility issues
    - Markdown syntax in PowerShell strings
    - Path reference and directory structure issues

.PARAMETER ScriptDirectory
    The directory containing PowerShell scripts to fix. Default is the current directory.

.PARAMETER BackupDirectory
    The directory to store backups of original scripts. Default is ".\backups".

.PARAMETER LogFile
    The path to the log file. Default is ".\fix-powershell-syntax.log".

.PARAMETER WhatIf
    If specified, shows what would be fixed without making actual changes.

.EXAMPLE
    .\fix-powershell-syntax.ps1 -ScriptDirectory "C:\Scripts" -BackupDirectory "C:\Backups" -LogFile "C:\Logs\fix.log"

.NOTES
    Version:        1.0
    Author:         cFish.io Team
    Creation Date:  2025-03-20
#>

[CmdletBinding(SupportsShouldProcess=$true)]
param (
    [Parameter(Mandatory=$false)]
    [string]$ScriptDirectory = ".",
    
    [Parameter(Mandatory=$false)]
    [string]$BackupDirectory = ".\backups",
    
    [Parameter(Mandatory=$false)]
    [string]$LogFile = ".\fix-powershell-syntax.log"
)

######## Initialize logging
function Write-Log {
    param (
        [Parameter(Mandatory=$true)]
        [string]$Message,
        
        [Parameter(Mandatory=$false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    ######## Write to console with appropriate color
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Green }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    ######## Write to log file
    Add-Content -Path $LogFile -Value $logMessage
}

######## Create backup directory if it doesn't exist
if (-not (Test-Path -Path $BackupDirectory)) {
    try {
        New-Item -Path $BackupDirectory -ItemType Directory -Force | Out-Null
        Write-Log "Created backup directory: $BackupDirectory"
    }
    catch {
        Write-Log "Failed to create backup directory: $($_.Exception.Message)" -Level "ERROR"
        exit 1
    }
}

######## Initialize counters
$scriptCount = 0
$fixedScriptCount = 0
$errorCount = 0

######## Get all PowerShell scripts in the directory
$scripts = Get-ChildItem -Path $ScriptDirectory -Filter "*.ps1" -Recurse

Write-Log "Found $($scripts.Count) PowerShell scripts to process"

foreach ($script in $scripts) {
    $scriptCount++
    $scriptPath = $script.FullName
    $backupPath = Join-Path -Path $BackupDirectory -ChildPath "$($script.Name).bak"
    
    Write-Log "Processing script: $scriptPath"
    
    try {
        ######## Read script content
        $content = Get-Content -Path $scriptPath -Raw
        
        ######## Create backup
        if ($PSCmdlet.ShouldProcess($scriptPath, "Create backup")) {
            Copy-Item -Path $scriptPath -Destination $backupPath -Force
            Write-Log "Created backup: $backupPath"
        }
        else {
            Write-Log "Would create backup: $backupPath (WhatIf mode)" -Level "INFO"
        }
        
        ######## Track if any fixes were applied
        $fixesApplied = $false
        
        ######## Fix 1: Ternary operator compatibility issues
        ######## Replace: $var = if (condition) { trueValue } else { falseValue }
        ######## With: $var = if (condition) { trueValue } else { falseValue }
        $ternaryPattern = if ('(\$\w+)\s*=\s*(.+)\s*\?\s*(.+) { )\s* } else { \s*(.+?)(?=\r|\n| };)'
        if ($content -match $ternaryPattern) {
            Write-Log "Fixing ternary operator in $($script.Name)" -Level "INFO"
            $content = [regex]::Replace(
                $content,
                $ternaryPattern,
                {
                    param($match)
                    $var = $match.Groups[1].Value
                    $condition = $match.Groups[2].Value
                    $trueValue = $match.Groups[3].Value
                    $falseValue = $match.Groups[4].Value
                    
                    "$var = if ($condition) { $trueValue } else { $falseValue }"
                }
            )
            $fixesApplied = $true
        }
        
        ######## Fix 2: Markdown syntax in PowerShell strings
        ######## Replace: "# Header" with "######### Header" in strings
        # This is a simplified example - actual implementation would be more complex
        $markdownPattern = '("[^"]*#\s+[^"]*")'
        if ($content -match $markdownPattern) {
            Write-Log "Fixing markdown syntax in strings in $($script.Name)" -Level "INFO"
            $content = [regex]::Replace(
                $content,
                $markdownPattern,
                {
                    param($match)
                    $str = $match.Groups[1].Value
                    ######## Only replace if not in a comment
                    if ($str -notmatch '^\s*#') {
                        $str = $str -replace '#\s+', '######### '
                    }
                    $str
                }
            )
            $fixesApplied = $true
        }
        
        ######## Fix 3: Path reference issues
        ######## Replace: "C:\path\to\file" with "C:\path\to\file"
        $pathPattern = '"([A-Za-z]:)/([^"]*)"'
        if ($content -match $pathPattern) {
            Write-Log "Fixing path references in $($script.Name)" -Level "INFO"
            $content = [regex]::Replace(
                $content,
                $pathPattern,
                {
                    param($match)
                    $drive = $match.Groups[1].Value
                    $path = $match.Groups[2].Value -replace '/', '\'
                    
                    """$drive\$path"""
                }
            )
            $fixesApplied = $true
        }
        
        ######## Save changes if any fixes were applied
        if ($fixesApplied) {
            if ($PSCmdlet.ShouldProcess($scriptPath, "Fix PowerShell syntax issues")) {
                Set-Content -Path $scriptPath -Value $content
                Write-Log "Fixed syntax issues in: $scriptPath" -Level "INFO"
                $fixedScriptCount++
            }
            else {
                Write-Log "Would fix syntax issues in: $scriptPath (WhatIf mode)" -Level "INFO"
            }
        }
        else {
            Write-Log "No syntax issues found in: $scriptPath" -Level "INFO"
        }
    }
    catch {
        Write-Log "Error processing ${scriptPath}: $($_.Exception.Message)" -Level "ERROR"
        $errorCount++
    }
}

######## Summary
Write-Log "===== Summary =====" -Level "INFO"
Write-Log "Total scripts processed: $scriptCount" -Level "INFO"
Write-Log "Scripts with fixes applied: $fixedScriptCount" -Level "INFO"
Write-Log "Errors encountered: $errorCount" -Level "INFO"

if ($errorCount -gt 0) {
    Write-Log "Completed with errors. See log file for details: $LogFile" -Level "WARNING"
    exit 1
}
else {
    Write-Log "Completed successfully. See log file for details: $LogFile" -Level "INFO"
    exit 0
}



