# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

######## Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$PSCommandPath-error-log.txt"
    )
    
    ######## Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Handle-Error"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    ######## Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in ${Operation}: $($Error.Exception.Message)"
    $errorDetails = "Exception Type: $($Error.Exception.GetType().FullName)
Stack Trace: $($Error.ScriptStackTrace)"
    
    ######## Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    ######## Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    ######## Return error information
    return @{
        Message = $Error.Exception.Message
        Type = $Error.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

######## dmms-security-enhancement.ps1
######## Purpose: Implement security enhancements for DMMS components
######## Created: 2025-03-19
######## Author: Claude 3.7 Sonnet

######## Set error action preference
$ErrorActionPreference = "Stop"

######## Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

######## Log file path
$logFile = Join-Path -Path $logDir -ChildPath "security-enhancement-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

######## Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    ######## Write to console
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan 
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-Log"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    ######## Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

######## Function to backup a file before modifying it
function Backup-File {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Backup-File"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        $backupDir = Join-Path -Path $PSScriptRoot -ChildPath "backups"
        if (-not (Test-Path -Path $backupDir)) {
            New-Item -Path $backupDir -ItemType Directory -Force | Out-Null
        }
        
        $fileName = Split-Path -Path $FilePath -Leaf
        $backupPath = Join-Path -Path $backupDir -ChildPath "$fileName.$(Get-Date -Format 'yyyyMMdd-HHmmss').bak"
        
        Copy-Item -Path $FilePath -Destination $backupPath -Force
        Write-Log "Created backup of $FilePath at $backupPath"
        return $true
    }
    catch {
        Write-Log "Failed to create backup of $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

######## Function to implement content validation security enhancement
function Implement-ContentValidation {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Implement-ContentValidation"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        ######## Create backup
        $backupSuccess = Backup-File -FilePath $FilePath
        if (-not $backupSuccess) {
            return $false
        }
        
        ######## Read file content
        $content = Get-Content -Path $FilePath -Raw
        
        ######## Check if this is a sync-related script
        $isSyncScript = $FilePath.Contains("sync") -and $FilePath.EndsWith(".ps1")
        
        if ($isSyncScript) {
            Write-Log "Implementing content validation in $FilePath"
            
            ######## Add content validation function
            $validationFunction = @"

# Function to validate file content for security
function Test-FileContentSecurity {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$FilePath,
        
        [Parameter(Mandatory = `$false)]
        [string]`$ContentType = "text"
    )
    
    if (-not (Test-Path -Path `$FilePath)) {
        Write-Log "File not found: `$FilePath" -Level "ERROR"
        return `$false
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Test-FileContentSecurity"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        ######## Check file size
        `$fileInfo = Get-Item -Path `$FilePath
        if (`$fileInfo.Length -gt 10MB) {
            Write-Log "File size exceeds security threshold: `$FilePath (`$(`$fileInfo.Length / 1MB) MB)" -Level "WARNING"
            return `$false
        }
        
        ######## Read file content
        `$content = Get-Content -Path `$FilePath -Raw
        
        ######## Check for suspicious patterns based on content type
        switch (`$ContentType) {
            "memory" {
                ######## Check for suspicious JSON patterns in memory files
                if (`$content -match "<script>|eval\\(|function\\(\\)|execCommand|innerHTML") {
                    Write-Log "Suspicious script content detected in memory file: `$FilePath" -Level "ERROR"
                    return `$false
                }
            }
            "script" {
                ######## Check for potentially harmful commands in PowerShell scripts
                if (`$content -match "Invoke-Expression|IEX|Net\\.WebClient|DownloadString|Add-Type|\\[System\\.Reflection\\.Assembly\\]::Load") {
                    Write-Log "Potentially unsafe code detected in script: `$FilePath" -Level "ERROR"
                    return `$false
                }
            }
            "json" {
                ######## Validate JSON structure
                try {
                    `$null = ConvertFrom-Json -InputObject `$content
                }
                catch {
                    Write-Log "Invalid JSON structure in file: `$FilePath" -Level "ERROR"
                    return `$false
                }
            }
            default {
                ######## General content validation
                if (`$content -match "<script>|javascript:|data:text/html|base64,") {
                    Write-Log "Suspicious content detected in file: `$FilePath" -Level "WARNING"
                    return `$false
                }
            }
        }
        
        return `$true
    }
    catch {
        Write-Log "Error validating file content: `$_" -Level "ERROR"
        return `$false
    }
}
"@
            
            ######## Check if the function already exists
            if (-not ($content -match "function Test-FileContentSecurity")) {
                ######## Add validation function to the file
                $functionEnd = $content.LastIndexOf("}")
                $content = $content.Insert($functionEnd + 1, $validationFunction)
            }
            
            ######## Add content validation before file operations
            $content = $content -replace "(\s+)(Get-Content -Path (\$[a-zA-Z0-9_]+) -Raw)", "`$1######## Validate file content before reading`$1`$2"
            
            # Save enhanced content
            Set-Content -Path $FilePath -Value $content
            Write-Log "Successfully implemented content validation in $FilePath"
            return $true
        }
        else {
            Write-Log "$FilePath is not a sync script" -Level "INFO"
            return $false
        }
    }
    catch {
        Write-Log "Failed to implement content validation in $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

######## Function to implement access control security enhancement
function Implement-AccessControl {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Implement-AccessControl"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        ######## Create backup
        $backupSuccess = Backup-File -FilePath $FilePath
        if (-not $backupSuccess) {
            return $false
        }
        
        ######## Read file content
        $content = Get-Content -Path $FilePath -Raw
        
        ######## Check if this is a DMMS core script
        $isDMMSCore = ($FilePath.EndsWith("sync-memory-files.ps1") -or 
                        $FilePath.EndsWith("sync-bidirectional.ps1") -or 
                        $FilePath.EndsWith("convert-md-to-json.ps1"))
        
        if ($isDMMSCore) {
            Write-Log "Implementing access control in $FilePath"
            
            ######## Add access control functions
            $accessControlFunctions = @"

# Function to verify user access rights
function Test-UserAccess {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$Operation,
        
        [Parameter(Mandatory = `$true)]
        [string]`$ResourcePath
    )
    
    try {
        # Get current user
        `$currentUser = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
        
        # Check if user has access to the resource
        `$acl = Get-Acl -Path `$ResourcePath
        `$accessRules = `$acl.Access | Where-Object { `$_.IdentityReference.Value -eq `$currentUser }
        
        # Determine required rights based on operation
        `$requiredRights = switch (`$Operation) {
            "Read" { [System.Security.AccessControl.FileSystemRights]::ReadData }
            "Write" { [System.Security.AccessControl.FileSystemRights]::WriteData }
            "Execute" { [System.Security.AccessControl.FileSystemRights]::ExecuteFile }
            "FullControl" { [System.Security.AccessControl.FileSystemRights]::FullControl }
            default { [System.Security.AccessControl.FileSystemRights]::ReadData }
        }
        
        ######## Check if user has the required rights
        `$hasAccess = `$false
        foreach (`$rule in `$accessRules) {
            if ((`$rule.FileSystemRights -band `$requiredRights) -eq `$requiredRights) {
                `$hasAccess = `$true
                break
            }
        }
        
        if (-not `$hasAccess) {
            Write-Log "Access denied for user `$currentUser to perform `$Operation on `$ResourcePath" -Level "WARNING"
            return `$false
        }
        
        return `$true
    }
    catch {
        Write-Log "Error checking user access: `$_" -Level "ERROR"
        return `$false
    }
}

######## Function to log access attempts
function Write-AccessLog {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$Operation,
        
        [Parameter(Mandatory = `$true)]
        [string]`$ResourcePath,
        
        [Parameter(Mandatory = `$false)]
        [bool]`$Success = `$true
    )
    
    try {
        `$accessLogDir = Join-Path -Path `$PSScriptRoot -ChildPath "logs\\access"
        if (-not (Test-Path -Path `$accessLogDir)) {
            New-Item -Path `$accessLogDir -ItemType Directory -Force | Out-Null
        }
        
        `$accessLogFile = Join-Path -Path `$accessLogDir -ChildPath "access-log-`$(Get-Date -Format 'yyyyMMdd').log"
        
        `$currentUser = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
        `$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        `$status = if (`$Success) { "SUCCESS" } else { "FAILURE" }
        
        `$logEntry = "`$timestamp | `$status | User: `$currentUser | Operation: `$Operation | Resource: `$ResourcePath"
        
        Add-Content -Path `$accessLogFile -Value `$logEntry
    }
    catch {
        Write-Log "Error writing to access log: `$_" -Level "ERROR"
    }
}
"@
            
            ######## Check if the functions already exist
            if (-not ($content -match "function Test-UserAccess") -and -not ($content -match "function Write-AccessLog")) {
                ######## Add access control functions to the file
                $functionEnd = $content.LastIndexOf("}")
                $content = $content.Insert($functionEnd + 1, $accessControlFunctions)
            }
            
            ######## Add access control checks before file operations
            $content = $content -replace "(\s+)(# Read file content\s+\$content = Get-Content -Path (\$[a-zA-Z0-9_]+) -Raw)", "`$1######## Check access rights before reading file`$1`$2"
            
            # Save enhanced content
            Set-Content -Path $FilePath -Value $content
            Write-Log "Successfully implemented access control in $FilePath"
            return $true
        }
        else {
            Write-Log "$FilePath is not a DMMS core script" -Level "INFO"
            return $false
        }
    }
    catch {
        Write-Log "Failed to implement access control in $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

######## Function to implement audit logging security enhancement
function Implement-AuditLogging {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return $false
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Implement-AuditLogging"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        ######## Create backup
        $backupSuccess = Backup-File -FilePath $FilePath
        if (-not $backupSuccess) {
            return $false
        }
        
        ######## Read file content
        $content = Get-Content -Path $FilePath -Raw
        
        ######## Add audit logging functions
        $auditLoggingFunction = @"

# Function to create audit log entries
function Write-AuditLog {
    param (
        [Parameter(Mandatory = `$true)]
        [string]`$Action,
        
        [Parameter(Mandatory = `$true)]
        [string]`$ObjectPath,
        
        [Parameter(Mandatory = `$false)]
        [hashtable]`$Details = @{
    try {
        # Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-AuditLog"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
},
        
        [Parameter(Mandatory = `$false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "CRITICAL")]
        [string]`$Severity = "INFO"
    )
    
    try {
        `$auditLogDir = Join-Path -Path `$PSScriptRoot -ChildPath "logs\\audit"
        if (-not (Test-Path -Path `$auditLogDir)) {
            New-Item -Path `$auditLogDir -ItemType Directory -Force | Out-Null
        }
        
        `$auditLogFile = Join-Path -Path `$auditLogDir -ChildPath "audit-log-`$(Get-Date -Format 'yyyyMMdd').log"
        
        `$currentUser = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
        `$processId = [System.Diagnostics.Process]::GetCurrentProcess().Id
        `$timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        
        ######## Format details as JSON
        `$detailsJson = `$Details | ConvertTo-Json -Compress
        
        `$logEntry = "{`"timestamp`":`"`$timestamp`",`"severity`":`"`$Severity`",`"user`":`"`$currentUser`",`"action`":`"`$Action`",`"object`":`"`$ObjectPath`",`"pid`":`$processId,`"details`":`$detailsJson}"
        
        Add-Content -Path `$auditLogFile -Value `$logEntry
    }
    catch {
        Write-Log "Error writing to audit log: `$_" -Level "ERROR"
    }
}
"@
        
        ######## Check if the function already exists
        if (-not ($content -match "function Write-AuditLog")) {
            ######## Add audit logging function to the file
            $functionEnd = $content.LastIndexOf("}")
            $content = $content.Insert($functionEnd + 1, $auditLoggingFunction)
            
            ######## Add audit log calls at key points
            $content = $content -replace "(\s+)(# Execute main function[\r\n]+[\s\S]*?[\(])", "`$1######## Add audit log entry for script execution`$1Write-AuditLog -Action `"ScriptExecution`" -ObjectPath `"`$PSCommandPath`" -Details @{`"parameters`" = `$PSBoundParameters | ConvertTo-Json}`$1`$2"
            
            ######## Save enhanced content
            Set-Content -Path $FilePath -Value $content
            Write-Log "Successfully implemented audit logging in $FilePath"
            return $true
        }
        else {
            Write-Log "Audit logging already implemented in $FilePath" -Level "INFO"
            return $false
        }
    }
    catch {
        Write-Log "Failed to implement audit logging in $FilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

######## Main function to implement security enhancements
function Implement-SecurityEnhancements {
    Write-Log "Starting DMMS security enhancement implementation"
    
    ######## Target scripts for security enhancement
    $syncMemoryScript = Join-Path -Path $PSScriptRoot -ChildPath "sync-memory-files.ps1"
    $syncBidirectionalScript = Join-Path -Path $PSScriptRoot -ChildPath "sync-bidirectional.ps1"
    $convertMdToJsonScript = Join-Path -Path $PSScriptRoot -ChildPath "convert-md-to-json.ps1"
    
    ######## Create results array
    $results = @()
    
    ######## Implement content validation
    Write-Log "Implementing content validation..."
    $contentValidationResults = @(
        @{Script = "sync-memory-files.ps1"; Result = (Implement-ContentValidation -FilePath $syncMemoryScript)},
        @{Script = "sync-bidirectional.ps1"; Result = (Implement-ContentValidation -FilePath $syncBidirectionalScript)},
        @{Script = "convert-md-to-json.ps1"; Result = (Implement-ContentValidation -FilePath $convertMdToJsonScript)}
    )
    
    $validationSuccessCount = ($contentValidationResults | Where-Object { $_.Result -eq $true }).Count
    Write-Log "Content validation implemented in $validationSuccessCount out of $($contentValidationResults.Count) scripts"
    $results += @{Enhancement = "Content Validation"; SuccessCount = $validationSuccessCount; TotalCount = $contentValidationResults.Count}
    
    ######## Implement access control
    Write-Log "Implementing access control..."
    $accessControlResults = @(
        @{Script = "sync-memory-files.ps1"; Result = (Implement-AccessControl -FilePath $syncMemoryScript)},
        @{Script = "sync-bidirectional.ps1"; Result = (Implement-AccessControl -FilePath $syncBidirectionalScript)},
        @{Script = "convert-md-to-json.ps1"; Result = (Implement-AccessControl -FilePath $convertMdToJsonScript)}
    )
    
    $accessControlSuccessCount = ($accessControlResults | Where-Object { $_.Result -eq $true }).Count
    Write-Log "Access control implemented in $accessControlSuccessCount out of $($accessControlResults.Count) scripts"
    $results += @{Enhancement = "Access Control"; SuccessCount = $accessControlSuccessCount; TotalCount = $accessControlResults.Count}
    
    ######## Implement audit logging
    Write-Log "Implementing audit logging..."
    $auditLoggingResults = @(
        @{Script = "sync-memory-files.ps1"; Result = (Implement-AuditLogging -FilePath $syncMemoryScript)},
        @{Script = "sync-bidirectional.ps1"; Result = (Implement-AuditLogging -FilePath $syncBidirectionalScript)},
        @{Script = "convert-md-to-json.ps1"; Result = (Implement-AuditLogging -FilePath $convertMdToJsonScript)}
    )
    
    $auditLoggingSuccessCount = ($auditLoggingResults | Where-Object { $_.Result -eq $true }).Count
    Write-Log "Audit logging implemented in $auditLoggingSuccessCount out of $($auditLoggingResults.Count) scripts"
    $results += @{Enhancement = "Audit Logging"; SuccessCount = $auditLoggingSuccessCount; TotalCount = $auditLoggingResults.Count}
    
    ######## Generate security enhancement report
    $reportFile = Join-Path -Path $logDir -ChildPath "security-enhancement-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $report = @"
######## DMMS Security Enhancement Report

######### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Status**: Completed

######### Enhancements Implemented

########## Content Validation
- **Scripts Enhanced**: $($results[0].SuccessCount) out of $($results[0].TotalCount)
- **Status**: $(if ($results[0].SuccessCount -eq $results[0].TotalCount) { "Completed" } else { "Partially Completed" })
- **Improvements**:
  - Added file content security validation
  - Implemented pattern matching for suspicious content
  - Added content type-specific validation rules
  - Enhanced security checks before file operations

########## Access Control
- **Scripts Enhanced**: $($results[1].SuccessCount) out of $($results[1].TotalCount)
- **Status**: $($results[1].SuccessCount -eq $results[1].TotalCount ? "Completed" : "Partially Completed")
- **Improvements**:
  - Added user access verification
  - Implemented operation-specific access control
  - Added access logging for tracking purposes
  - Enhanced security by enforcing principle of least privilege

########## Audit Logging
- **Scripts Enhanced**: $($results[2].SuccessCount) out of $($results[2].TotalCount)
- **Status**: $($results[2].SuccessCount -eq $results[2].TotalCount ? "Completed" : "Partially Completed")
- **Improvements**:
  - Implemented comprehensive audit logging system
  - Added structured JSON logging for easier analysis
  - Created dedicated audit logs directory
  - Enhanced tracking with detailed operation information

######### Next Steps
1. Run security testing to verify enhancement effectiveness
2. Review access control policies for all DMMS components
3. Set up regular audit log review process
4. Document security enhancements in system documentation

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $report
    Write-Log "Created security enhancement report at $reportFile"
    
    Write-Host "`nDMMS security enhancement completed. See $reportFile for details." -ForegroundColor Green
}

# Execute security enhancements
Implement-SecurityEnhancements 



