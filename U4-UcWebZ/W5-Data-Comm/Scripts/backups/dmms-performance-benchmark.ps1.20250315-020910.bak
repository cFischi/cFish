# dmms-performance-benchmark.ps1
# Purpose: Benchmark DMMS performance metrics
# Created: 2025-03-19
# Author: Claude 3.7 Sonnet

# Set error action preference
$ErrorActionPreference = "Stop"

# Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

# Log file path
$logFile = Join-Path -Path $logDir -ChildPath "performance-benchmark-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

# Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    # Write to console
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    # Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

# Function to measure performance
function Measure-Performance {
    param (
        [Parameter(Mandatory = $true)]
        [string]$OperationName,
        
        [Parameter(Mandatory = $true)]
        [scriptblock]$ScriptBlock
    )
    
    Write-Log "Starting performance measurement for: $OperationName"
    
    $startMemory = [System.GC]::GetTotalMemory($true)
    $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
    
    try {
        # Execute the script block
        & $ScriptBlock
        
        $stopwatch.Stop()
        $endMemory = [System.GC]::GetTotalMemory($true)
        $memoryUsed = $endMemory - $startMemory
        
        Write-Log "Performance results for $OperationName:"
        Write-Log "  - Execution Time: $($stopwatch.ElapsedMilliseconds) ms"
        Write-Log "  - Memory Used: $($memoryUsed / 1KB) KB"
        
        return @{
            OperationName = $OperationName
            ExecutionTime = $stopwatch.ElapsedMilliseconds
            MemoryUsed = $memoryUsed
            Success = $true
        }
    }
    catch {
        $stopwatch.Stop()
        Write-Log "Error during performance measurement for $OperationName: $_" -Level "ERROR"
        
        return @{
            OperationName = $OperationName
            ExecutionTime = $stopwatch.ElapsedMilliseconds
            MemoryUsed = 0
            Success = $false
            Error = $_
        }
    }
}

# Main benchmarking function
function Start-DMMSBenchmark {
    Write-Log "Starting DMMS performance benchmark"
    
    $results = @()
    
    # Benchmark sync-memory-files.ps1
    $syncMemoryFilesPath = Join-Path -Path $PSScriptRoot -ChildPath "sync-memory-files.ps1"
    if (Test-Path -Path $syncMemoryFilesPath) {
        $result = Measure-Performance -OperationName "Sync Memory Files" -ScriptBlock {
            & $syncMemoryFilesPath
        }
        $results += $result
    }
    else {
        Write-Log "Script not found: $syncMemoryFilesPath" -Level "WARNING"
    }
    
    # Benchmark sync-bidirectional.ps1
    $syncBidirectionalPath = Join-Path -Path $PSScriptRoot -ChildPath "sync-bidirectional.ps1"
    if (Test-Path -Path $syncBidirectionalPath) {
        $result = Measure-Performance -OperationName "Sync Bidirectional" -ScriptBlock {
            & $syncBidirectionalPath
        }
        $results += $result
    }
    else {
        Write-Log "Script not found: $syncBidirectionalPath" -Level "WARNING"
    }
    
    # Benchmark convert-md-to-json.ps1
    $convertMdToJsonPath = Join-Path -Path $PSScriptRoot -ChildPath "convert-md-to-json.ps1"
    if (Test-Path -Path $convertMdToJsonPath) {
        $result = Measure-Performance -OperationName "Convert MD to JSON" -ScriptBlock {
            & $convertMdToJsonPath
        }
        $results += $result
    }
    else {
        Write-Log "Script not found: $convertMdToJsonPath" -Level "WARNING"
    }
    
    # Generate benchmark report
    $reportFile = Join-Path -Path $logDir -ChildPath "performance-benchmark-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $report = @"
# DMMS Performance Benchmark Report

## Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Total Operations Benchmarked**: $($results.Count)

## Results

| Operation | Execution Time (ms) | Memory Used (KB) | Success |
|-----------|---------------------|------------------|---------|
$(foreach ($result in $results) {
"| $($result.OperationName) | $($result.ExecutionTime) | $([math]::Round($result.MemoryUsed / 1KB, 2)) | $($result.Success) |"
})

## Next Steps
1. Analyze these baseline metrics for optimization opportunities
2. Implement performance enhancements in identified areas
3. Re-run benchmark to measure improvements
4. Document optimization results

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $report
    Write-Log "Created benchmark report at $reportFile"
    
    Write-Host "`nDMMS performance benchmark completed. See $reportFile for details." -ForegroundColor Green
}

# Run the benchmark
Start-DMMSBenchmark 