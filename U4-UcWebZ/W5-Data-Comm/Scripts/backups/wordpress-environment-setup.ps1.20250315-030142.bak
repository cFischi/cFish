# wordpress-environment-setup.ps1
# Purpose: Set up and configure WordPress environment for cFish.io
# Created: 2025-03-19
# Author: Claude 3.7 Sonnet

# Script parameters
param (
    [Parameter(Mandatory = $false)]
    [string]$ConfigPath = "config\wordpress-config.json",
    
    [Parameter(Mandatory = $false)]
    [string]$WordPressPath = "..\..\WordPress",
    
    [Parameter(Mandatory = $false)]
    [switch]$ForceSetup = $false,
    
    [Parameter(Mandatory = $false)]
    [switch]$SkipPlugins = $false,
    
    [Parameter(Mandatory = $false)]
    [switch]$SkipThemes = $false
)

######## Set error action preference
$ErrorActionPreference = "Stop"

######## Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

######## Log file path
$logFile = Join-Path -Path $logDir -ChildPath "wordpress-setup-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

######## Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "DEBUG")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    ######## Write to console with different colors based on level
    switch ($Level) {
        "DEBUG" { Write-Host $logMessage -ForegroundColor Gray }
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    ######## Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

######## Function to load WordPress configuration
function Load-WordPressConfig {
    param (
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath
    )
    
    $configFullPath = Join-Path -Path $PSScriptRoot -ChildPath $ConfigPath
    
    if (-not (Test-Path -Path $configFullPath)) {
        Write-Log "WordPress configuration file not found at $configFullPath" -Level "ERROR"
        Write-Log "Creating default WordPress configuration" -Level "WARNING"
        
        ######## Create default WordPress configuration
        $defaultConfig = @{
            "Version" = "1.0"
            "Environment" = "development"
            "LastUpdated" = (Get-Date -Format "yyyy-MM-dd")
            "CoreVersion" = "6.4.3"
            "Database" = @{
                "Host" = "localhost"
                "Name" = "cfish_wp"
                "User" = "cfish_user"
                "Password" = "PLACEHOLDER_PASSWORD_PROMPT"
                "TablePrefix" = "wp_"
            }
            "Site" = @{
                "Title" = "cFish.io"
                "AdminUser" = "admin"
                "AdminPassword" = "PLACEHOLDER_PASSWORD_PROMPT"
                "AdminEmail" = "admin@cfish.io"
                "Url" = "http://localhost/cfish"
            }
            "Plugins" = @(
                @{
                    "Name" = "advanced-custom-fields"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "custom-post-type-ui"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "classic-editor"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "wordfence"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "wp-mail-smtp"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "sucuri-scanner"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "wp-super-cache"
                    "Version" = "latest"
                    "Required" = $true
                },
                @{
                    "Name" = "all-in-one-seo-pack"
                    "Version" = "latest"
                    "Required" = $true
                }
            )
            "Themes" = @(
                @{
                    "Name" = "cfish-theme"
                    "Source" = "custom"
                    "Path" = "Themes\cfish-theme"
                    "IsChildTheme" = $false
                    "Required" = $true
                },
                @{
                    "Name" = "twentytwentyfour"
                    "Source" = "wp-repository"
                    "IsChildTheme" = $false
                    "Required" = $false
                }
            )
            "Settings" = @{
                "Permalink" = "/%postname%/"
                "CommentsEnabled" = $false
                "AutoUpdates" = @{
                    "Core" = "minor"
                    "Plugins" = $true
                    "Themes" = $true
                }
                "MaxRevisions" = 5
                "EmptyTrash" = 30
                "Debugging" = $false
            }
        }
        
        ######## Create directory if it doesn't exist
        $configDir = Split-Path -Path $configFullPath -Parent
        if (-not (Test-Path -Path $configDir)) {
            New-Item -Path $configDir -ItemType Directory -Force | Out-Null
            Write-Log "Created configuration directory at $configDir" -Level "INFO"
        }
        
        ######## Save default configuration to file
        $defaultConfig | ConvertTo-Json -Depth 10 | Set-Content -Path $configFullPath
        Write-Log "Created default WordPress configuration at $configFullPath" -Level "INFO"
        
        return $defaultConfig
    }
    
    try {
        $config = Get-Content -Path $configFullPath -Raw | ConvertFrom-Json
        Write-Log "Loaded WordPress configuration from $configFullPath" -Level "INFO"
        return $config
    }
    catch {
        Write-Log "Error loading WordPress configuration: $_" -Level "ERROR"
        throw "Failed to load WordPress configuration. See log for details."
    }
}

######## Function to check if WP-CLI is installed
function Check-WPCLI {
    try {
        $wpCliResult = Invoke-Expression "wp --info" 2>&1
        if ($LASTEXITCODE -eq 0) {
            Write-Log "WP-CLI is already installed." -Level "INFO"
            return $true
        }
        else {
            Write-Log "WP-CLI is not installed or not in PATH." -Level "WARNING"
            return $false
        }
    }
    catch {
        Write-Log "Error checking WP-CLI: $_" -Level "WARNING"
        return $false
    }
}

######## Function to install WP-CLI
function Install-WPCLI {
    try {
        Write-Log "Installing WP-CLI..." -Level "INFO"
        
        ######## Create temporary directory
        $tempDir = Join-Path -Path ${env}:TEMP -ChildPath "wpcli-install"
        if (-not (Test-Path -Path $tempDir)) {
            New-Item -Path $tempDir -ItemType Directory -Force | Out-Null
        }
        
        ######## Download WP-CLI PHAR file
        $wpcliUrl = "https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar"
        $wpcliPath = Join-Path -Path $tempDir -ChildPath "wp-cli.phar"
        
        Write-Log "Downloading WP-CLI from $wpcliUrl" -Level "INFO"
        Invoke-WebRequest -Uri $wpcliUrl -OutFile $wpcliPath
        
        ######## Create WP-CLI batch file
        $wpcliBatPath = Join-Path -Path $PSScriptRoot -ChildPath "wp.bat"
        
        $wpcliBatContent = @"
@ECHO OFF
php "%~dp0wp-cli.phar" %*
"@
        
        Set-Content -Path $wpcliBatPath -Value $wpcliBatContent
        
        ######## Move WP-CLI PHAR file to script directory
        $wpcliDestPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
        Copy-Item -Path $wpcliPath -Destination $wpcliDestPath -Force
        
        ######## Test WP-CLI
        $wpCliTest = Invoke-Expression "php `"$wpcliDestPath`" --info" 2>&1
        if ($LASTEXITCODE -eq 0) {
            Write-Log "WP-CLI installed successfully." -Level "INFO"
            return $true
        }
        else {
            Write-Log "WP-CLI installation failed: $wpCliTest" -Level "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error installing WP-CLI: $_" -Level "ERROR"
        return $false
    }
    finally {
        ######## Clean up temporary directory
        if (Test-Path -Path $tempDir) {
            Remove-Item -Path $tempDir -Force -Recurse -ErrorAction SilentlyContinue
        }
    }
}

######## Function to download WordPress
function Download-WordPress {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [string]$Version,
        
        [Parameter(Mandatory = $false)]
        [switch]$ForceDownload = $false
    )
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    
    ######## Check if WordPress is already downloaded
    if ((Test-Path -Path $wpFullPath) -and (-not $ForceDownload)) {
        Write-Log "WordPress directory already exists at $wpFullPath" -Level "INFO"
        
        ######## Check if it's actually WordPress
        if (Test-Path -Path (Join-Path -Path $wpFullPath -ChildPath "wp-config-sample.php")) {
            Write-Log "WordPress is already downloaded." -Level "INFO"
            return $true
        }
        else {
            Write-Log "Directory exists but does not appear to contain WordPress." -Level "WARNING"
        }
    }
    
    try {
        ######## Create WordPress directory if it doesn't exist
        if (-not (Test-Path -Path $wpFullPath)) {
            New-Item -Path $wpFullPath -ItemType Directory -Force | Out-Null
            Write-Log "Created WordPress directory at $wpFullPath" -Level "INFO"
        }
        
        ######## Download WordPress using WP-CLI
        Write-Log "Downloading WordPress $Version..." -Level "INFO"
        
        $wpcliPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
        $command = "php `"$wpcliPath`" core download --path=`"$wpFullPath`" --version=`"$Version`" --force"
        
        $result = Invoke-Expression $command 2>&1
        
        if ($LASTEXITCODE -eq 0) {
            Write-Log "WordPress $Version downloaded successfully." -Level "INFO"
            return $true
        }
        else {
            Write-Log "WordPress download failed: $result" -Level "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error downloading WordPress: $_" -Level "ERROR"
        return $false
    }
}

######## Function to create wp-config.php
function Create-WPConfig {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Config,
        
        [Parameter(Mandatory = $false)]
        [switch]$Force = $false
    )
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    $wpConfigPath = Join-Path -Path $wpFullPath -ChildPath "wp-config.php"
    
    ######## Check if wp-config.php already exists
    if ((Test-Path -Path $wpConfigPath) -and (-not $Force)) {
        Write-Log "wp-config.php already exists at $wpConfigPath" -Level "INFO"
        return $true
    }
    
    try {
        Write-Log "Creating wp-config.php..." -Level "INFO"
        
        ######## Handle password placeholder
        $dbPassword = $Config.Database.Password
        if ($dbPassword -eq "PLACEHOLDER_PASSWORD_PROMPT") {
            $dbPassword = Read-Host "Enter database password" -AsSecureString
            $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($dbPassword)
            $dbPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)
        }
        
        ######## Create wp-config.php using WP-CLI
        $wpcliPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
        $command = "php `"$wpcliPath`" config create --path=`"$wpFullPath`" --dbname=`"$($Config.Database.Name)`" --dbuser=`"$($Config.Database.User)`" --dbpass=`"$dbPassword`" --dbhost=`"$($Config.Database.Host)`" --dbprefix=`"$($Config.Database.TablePrefix)`" --force"
        
        $result = Invoke-Expression $command 2>&1
        
        if ($LASTEXITCODE -eq 0) {
            Write-Log "wp-config.php created successfully." -Level "INFO"
            
            ######## Add additional configuration options
            $additionalConfig = @"

/* Additional configuration */
define('WP_POST_REVISIONS', $($Config.Settings.MaxRevisions));
define('EMPTY_TRASH_DAYS', $($Config.Settings.EmptyTrash));
define('WP_DEBUG', $(if ($Config.Settings.Debugging) { 'true' } else { 'false' }));
define('AUTOMATIC_UPDATER_DISABLED', false);
define('WP_AUTO_UPDATE_CORE', '$($Config.Settings.AutoUpdates.Core)');
"@
            
            $wpConfigContent = Get-Content -Path $wpConfigPath -Raw
            $wpConfigContent = $wpConfigContent.Replace("/* That's all, stop editing! Happy publishing. */", $additionalConfig + "`n`n/* That's all, stop editing! Happy publishing. */")
            Set-Content -Path $wpConfigPath -Value $wpConfigContent
            
            Write-Log "Added additional configuration to wp-config.php" -Level "INFO"
            return $true
        }
        else {
            Write-Log "Failed to create wp-config.php: $result" -Level "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error creating wp-config.php: $_" -Level "ERROR"
        return $false
    }
}

######## Function to install WordPress
function Install-WordPress {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Config,
        
        [Parameter(Mandatory = $false)]
        [switch]$Force = $false
    )
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    
    try {
        Write-Log "Installing WordPress..." -Level "INFO"
        
        ######## Handle admin password placeholder
        $adminPassword = $Config.Site.AdminPassword
        if ($adminPassword -eq "PLACEHOLDER_PASSWORD_PROMPT") {
            $adminPassword = Read-Host "Enter WordPress admin password" -AsSecureString
            $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($adminPassword)
            $adminPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)
        }
        
        ######## Install WordPress using WP-CLI
        $wpcliPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
        $command = "php `"$wpcliPath`" core install --path=`"$wpFullPath`" --url=`"$($Config.Site.Url)`" --title=`"$($Config.Site.Title)`" --admin_user=`"$($Config.Site.AdminUser)`" --admin_password=`"$adminPassword`" --admin_email=`"$($Config.Site.AdminEmail)`""
        
        $result = Invoke-Expression $command 2>&1
        
        if ($LASTEXITCODE -eq 0) {
            Write-Log "WordPress installed successfully." -Level "INFO"
            
            ######## Configure additional settings
            Write-Log "Configuring additional WordPress settings..." -Level "INFO"
            
            ######## Set permalink structure
            $permalinkCommand = "php `"$wpcliPath`" rewrite structure --path=`"$wpFullPath`" `"$($Config.Settings.Permalink)`""
            $permalinkResult = Invoke-Expression $permalinkCommand 2>&1
            
            if ($LASTEXITCODE -eq 0) {
                Write-Log "Permalink structure set to $($Config.Settings.Permalink)" -Level "INFO"
            }
            else {
                Write-Log "Failed to set permalink structure: $permalinkResult" -Level "WARNING"
            }
            
            ######## Configure comments
            $commentsCommand = "php `"$wpcliPath`" option update --path=`"$wpFullPath`" default_comment_status " + $(if ($Config.Settings.CommentsEnabled) { "'open'" } else { "'closed'" })
            $commentsResult = Invoke-Expression $commentsCommand 2>&1
            
            if ($LASTEXITCODE -eq 0) {
                Write-Log "Comments " + $(if ($Config.Settings.CommentsEnabled) { "enabled" } else { "disabled" }) + " by default" -Level "INFO"
            }
            else {
                Write-Log "Failed to configure comments: $commentsResult" -Level "WARNING"
            }
            
            return $true
        }
        else {
            Write-Log "WordPress installation failed: $result" -Level "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error installing WordPress: $_" -Level "ERROR"
        return $false
    }
}

######## Function to install WordPress plugins
function Install-Plugins {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Plugins
    )
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    $wpcliPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
    
    $installedCount = 0
    $failedCount = 0
    
    Write-Log "Installing WordPress plugins..." -Level "INFO"
    
    foreach ($plugin in $Plugins) {
        try {
            Write-Log "Installing plugin: $($plugin.Name)" -Level "INFO"
            
            $versionArg = if ($plugin.Version -ne "latest") { "--version=`"$($plugin.Version)`"" } else { "" }
            $command = "php `"$wpcliPath`" plugin install --path=`"$wpFullPath`" $($plugin.Name) $versionArg --activate"
            
            $result = Invoke-Expression $command 2>&1
            
            if ($LASTEXITCODE -eq 0) {
                Write-Log "Plugin $($plugin.Name) installed and activated successfully." -Level "INFO"
                $installedCount++
            }
            else {
                Write-Log "Failed to install plugin $($plugin.Name): $result" -Level if ($plugin.Required) { "ERROR" } else { "WARNING" }
                $failedCount++
            }
        }
        catch {
            Write-Log "Error installing plugin $($plugin.Name): $_" -Level if ($plugin.Required) { "ERROR" } else { "WARNING" }
            $failedCount++
        }
    }
    
    Write-Log "Plugin installation complete. Installed: $installedCount, Failed: $failedCount" -Level "INFO"
    
    return $failedCount -eq 0 -or -not ($Plugins | Where-Object { $_.Required -eq $true } | Where-Object { $_.Name -in $failed })
}

######## Function to install WordPress themes
function Install-Themes {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Themes
    )
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    $wpcliPath = Join-Path -Path $PSScriptRoot -ChildPath "wp-cli.phar"
    
    $installedCount = 0
    $failedCount = 0
    
    Write-Log "Installing WordPress themes..." -Level "INFO"
    
    foreach ($theme in $Themes) {
        try {
            Write-Log "Installing theme: $($theme.Name)" -Level "INFO"
            
            if ($theme.Source -eq "wp-repository") {
                $command = "php `"$wpcliPath`" theme install --path=`"$wpFullPath`" $($theme.Name)"
                
                $result = Invoke-Expression $command 2>&1
                
                if ($LASTEXITCODE -eq 0) {
                    Write-Log "Theme $($theme.Name) installed successfully." -Level "INFO"
                    $installedCount++
                }
                else {
                    Write-Log "Failed to install theme $($theme.Name): $result" -Level if ($theme.Required) { "ERROR" } else { "WARNING" }
                    $failedCount++
                }
            }
            elseif ($theme.Source -eq "custom") {
                $themePath = Join-Path -Path $PSScriptRoot -ChildPath $theme.Path
                $themeDestPath = Join-Path -Path $wpFullPath -ChildPath "wp-content\themes\$($theme.Name)"
                
                if (Test-Path -Path $themePath) {
                    ######## Create destination directory if it doesn't exist
                    if (-not (Test-Path -Path $themeDestPath)) {
                        New-Item -Path $themeDestPath -ItemType Directory -Force | Out-Null
                    }
                    
                    ######## Copy theme files
                    Copy-Item -Path "$themePath\*" -Destination $themeDestPath -Recurse -Force
                    
                    Write-Log "Custom theme $($theme.Name) copied to themes directory." -Level "INFO"
                    $installedCount++
                }
                else {
                    Write-Log "Custom theme source directory not found: $themePath" -Level if ($theme.Required) { "ERROR" } else { "WARNING" }
                    $failedCount++
                }
            }
            else {
                Write-Log "Unknown theme source: $($theme.Source)" -Level "WARNING"
                $failedCount++
            }
        }
        catch {
            Write-Log "Error installing theme $($theme.Name): $_" -Level if ($theme.Required) { "ERROR" } else { "WARNING" }
            $failedCount++
        }
    }
    
    ######## Activate the first theme
    if ($Themes.Count -gt 0) {
        $firstTheme = $Themes[0].Name
        
        try {
            $activateCommand = "php `"$wpcliPath`" theme activate --path=`"$wpFullPath`" $firstTheme"
            $activateResult = Invoke-Expression $activateCommand 2>&1
            
            if ($LASTEXITCODE -eq 0) {
                Write-Log "Theme $firstTheme activated as default theme." -Level "INFO"
            }
            else {
                Write-Log "Failed to activate theme ${firstTheme}: $activateResult" -Level "WARNING"
            }
        }
        catch {
            Write-Log "Error activating theme ${firstTheme}: $_" -Level "WARNING"
        }
    }
    
    Write-Log "Theme installation complete. Installed: $installedCount, Failed: $failedCount" -Level "INFO"
    
    return $failedCount -eq 0 -or -not ($Themes | Where-Object { $_.Required -eq $true } | Where-Object { $_.Name -in $failed })
}

######## Function to generate a setup report
function Generate-SetupReport {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WordPressPath,
        
        [Parameter(Mandatory = $true)]
        [PSCustomObject]$Config,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$Results
    )
    
    $reportFile = Join-Path -Path $logDir -ChildPath "wordpress-setup-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    Write-Log "Generating WordPress setup report at $reportFile" -Level "INFO"
    
    $wpFullPath = Join-Path -Path $PSScriptRoot -ChildPath $WordPressPath
    
    $reportContent = @"
######## WordPress Environment Setup Report

######### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Environment**: $($Config.Environment)
- **WordPress Version**: $($Config.CoreVersion)
- **WordPress Path**: $wpFullPath

######### Setup Results

| Component | Status | Notes |
|-----------|--------|-------|
| WP-CLI Installation | $($Results.WPCLIInstall) | $(if ($Results.WPCLIInstall -eq "Success") { "WP-CLI installed and configured" } else { "Failed to install WP-CLI" }) |
| WordPress Download | $($Results.WordPressDownload) | $(if ($Results.WordPressDownload -eq "Success") { "WordPress $($Config.CoreVersion) downloaded" } else { "Failed to download WordPress" }) |
| wp-config.php Creation | $($Results.WPConfigCreate) | $(if ($Results.WPConfigCreate -eq "Success") { "Database connection configured" } else { "Failed to create wp-config.php" }) |
| WordPress Installation | $($Results.WordPressInstall) | $(if ($Results.WordPressInstall -eq "Success") { "WordPress installed and configured" } else { "Failed to install WordPress" }) |
| Plugin Installation | $($Results.PluginInstall) | $(if ($Results.PluginInstall -eq "Success") { "All required plugins installed" } else { "Some plugin installations failed" }) |
| Theme Installation | $($Results.ThemeInstall) | $(if ($Results.ThemeInstall -eq "Success") { "All required themes installed" } else { "Some theme installations failed" }) |

######### Site Information
- **Site URL**: $($Config.Site.Url)
- **Site Title**: $($Config.Site.Title)
- **Admin Username**: $($Config.Site.AdminUser)
- **Admin Email**: $($Config.Site.AdminEmail)

######### Installed Components

########## Plugins
$(foreach ($plugin in $Config.Plugins) {
"- $($plugin.Name) (Required: $($plugin.Required))"
})

########## Themes
$(foreach ($theme in $Config.Themes) {
"- $($theme.Name) (Source: $($theme.Source), Required: $($theme.Required))"
})

######### Next Steps
1. Access the WordPress admin panel at $($Config.Site.Url)/wp-admin
2. Verify that all required plugins and themes are activated
3. Configure Wordfence security settings
4. Set up SMTP mail configuration
5. Configure SEO settings in All-in-One SEO Pack
6. Customize the active theme

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $reportContent
    Write-Log "WordPress setup report generated at $reportFile" -Level "INFO"
    
    return $reportFile
}

######## Main execution
try {
    Write-Log "Starting WordPress Environment Setup" -Level "INFO"
    Write-Log "Parameters: ConfigPath=$ConfigPath, WordPressPath=$WordPressPath, ForceSetup=$ForceSetup, SkipPlugins=$SkipPlugins, SkipThemes=$SkipThemes" -Level "INFO"
    
    ######## Load WordPress configuration
    $config = Load-WordPressConfig -ConfigPath $ConfigPath
    Write-Log "Loaded WordPress configuration version $($config.Version), environment: $($config.Environment)" -Level "INFO"
    
    ######## Track results
    $results = @{
        WPCLIInstall = "Not Started"
        WordPressDownload = "Not Started"
        WPConfigCreate = "Not Started"
        WordPressInstall = "Not Started"
        PluginInstall = "Not Started"
        ThemeInstall = "Not Started"
    }
    
    ######## Check if WP-CLI is installed, install if not
    if (-not (Check-WPCLI)) {
        $wpCliInstallResult = Install-WPCLI
        $results.WPCLIInstall = if ($wpCliInstallResult) { "Success" } else { "Failed" }
        
        if (-not $wpCliInstallResult) {
            Write-Log "WP-CLI installation failed. Cannot continue." -Level "ERROR"
            exit 1
        }
    }
    else {
        $results.WPCLIInstall = "Success"
    }
    
    ######## Download WordPress
    $wpDownloadResult = Download-WordPress -WordPressPath $WordPressPath -Version $config.CoreVersion -ForceDownload:$ForceSetup
    $results.WordPressDownload = if ($wpDownloadResult) { "Success" } else { "Failed" }
    
    if (-not $wpDownloadResult) {
        Write-Log "WordPress download failed. Cannot continue." -Level "ERROR"
        exit 1
    }
    
    ######## Create wp-config.php
    $wpConfigResult = Create-WPConfig -WordPressPath $WordPressPath -Config $config -Force:$ForceSetup
    $results.WPConfigCreate = if ($wpConfigResult) { "Success" } else { "Failed" }
    
    if (-not $wpConfigResult) {
        Write-Log "wp-config.php creation failed. Cannot continue." -Level "ERROR"
        exit 1
    }
    
    ######## Install WordPress
    $wpInstallResult = Install-WordPress -WordPressPath $WordPressPath -Config $config -Force:$ForceSetup
    $results.WordPressInstall = if ($wpInstallResult) { "Success" } else { "Failed" }
    
    if (-not $wpInstallResult) {
        Write-Log "WordPress installation failed. Cannot continue with core installation." -Level "ERROR"
        ######## We can still try to install plugins and themes
    }
    
    ######## Install plugins if not skipped
    if (-not $SkipPlugins) {
        $pluginInstallResult = Install-Plugins -WordPressPath $WordPressPath -Plugins $config.Plugins
        $results.PluginInstall = if ($pluginInstallResult) { "Success" } else { "Failed" }
    }
    else {
        Write-Log "Skipping plugin installation as requested." -Level "INFO"
        $results.PluginInstall = "Skipped"
    }
    
    ######## Install themes if not skipped
    if (-not $SkipThemes) {
        $themeInstallResult = Install-Themes -WordPressPath $WordPressPath -Themes $config.Themes
        $results.ThemeInstall = if ($themeInstallResult) { "Success" } else { "Failed" }
    }
    else {
        Write-Log "Skipping theme installation as requested." -Level "INFO"
        $results.ThemeInstall = "Skipped"
    }
    
    ######## Generate setup report
    $reportPath = Generate-SetupReport -WordPressPath $WordPressPath -Config $config -Results $results
    
    ######## Log summary
    Write-Log "WordPress Environment Setup complete" -Level "INFO"
    Write-Log "WP-CLI Installation: $($results.WPCLIInstall)" -Level "INFO"
    Write-Log "WordPress Download: $($results.WordPressDownload)" -Level "INFO"
    Write-Log "wp-config.php Creation: $($results.WPConfigCreate)" -Level "INFO"
    Write-Log "WordPress Installation: $($results.WordPressInstall)" -Level "INFO"
    Write-Log "Plugin Installation: $($results.PluginInstall)" -Level "INFO"
    Write-Log "Theme Installation: $($results.ThemeInstall)" -Level "INFO"
    
    Write-Host "`nWordPress Environment Setup complete." -ForegroundColor Green
    Write-Host "Setup report generated at $reportPath" -ForegroundColor Cyan
    Write-Host "Log file: $logFile" -ForegroundColor Cyan
    
    ######## Exit with appropriate code
    if ($results.Values -contains "Failed") {
        Write-Host "`nSome setup steps failed. See the report for details." -ForegroundColor Yellow
        exit 1
    }
    else {
        Write-Host "`nAll setup steps completed successfully or were skipped." -ForegroundColor Green
        exit 0
    }
}
catch {
    Write-Log "Fatal error in WordPress Environment Setup: $_" -Level "ERROR"
    Write-Log $_.ScriptStackTrace -Level "ERROR"
    
    Write-Host "`nERROR: WordPress Environment Setup failed with an error." -ForegroundColor Red
    Write-Host "See log file for details: $logFile" -ForegroundColor Red
    
    exit 9999
} 


