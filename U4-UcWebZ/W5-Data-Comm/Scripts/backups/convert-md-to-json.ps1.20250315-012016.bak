<#
.SYNOPSIS
    Converts Markdown memory files to JSON format for AI ingestion.

.DESCRIPTION
    This script converts memory.md files to structured JSON format
    for better programmatic access and AI ingestion while maintaining
    all content and metadata.

.NOTES
    File Name      : convert-md-to-json.ps1
    Author         : tY FischEYe via Cursor/Claude
    Prerequisite   : PowerShell V3
    Copyright      : cFish.io 2025
    Date           : March 20, 2025
#>

param(
    [Parameter(Mandatory=$true)]
    [string]$InputFile,
    
    [Parameter(Mandatory=$true)]
    [string]$OutputFile
)

# Get workspace root directory
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$workspaceRoot = Split-Path -Parent (Split-Path -Parent $scriptDir)

# Handle relative paths
if (![System.IO.Path]::IsPathRooted($InputFile)) {
    $InputFile = Join-Path -Path $workspaceRoot -ChildPath $InputFile
}

if (![System.IO.Path]::IsPathRooted($OutputFile)) {
    $OutputFile = Join-Path -Path $workspaceRoot -ChildPath $OutputFile
}

# Create output directory if it doesn't exist
$outputDir = Split-Path -Parent $OutputFile
if (!(Test-Path $outputDir)) {
    Write-Host "Creating output directory: $outputDir"
    New-Item -ItemType Directory -Path $outputDir -Force | Out-Null
}

# Read input file
Write-Host "Reading input file: $InputFile"
$content = Get-Content -Path $InputFile -Raw

# Extract file metadata
$fileMetadata = @{
    fileName = (Split-Path -Leaf $InputFile)
    filePath = $InputFile
    conversionDate = (Get-Date -Format "yyyy-MM-dd")
    conversionTime = (Get-Date -Format "HH:mm:ss")
}

# Extract entries from file
$entries = [System.Collections.ArrayList]@()
$regex = [regex]"(?ms)^## (.*?) \((.*?)\)(.*?)(?=^## |\z)"
$matches = $regex.Matches($content)

Write-Host "Found $($matches.Count) entries in file."

foreach ($match in $matches) {
    $title = $match.Groups[1].Value.Trim()
    $date = $match.Groups[2].Value.Trim()
    $content = $match.Groups[3].Value.Trim()
    
    # Parse content into bullet points
    $bulletPoints = [System.Collections.ArrayList]@()
    $contentLines = $content -split "`n"
    foreach ($line in $contentLines) {
        $trimmedLine = $line.Trim()
        if ($trimmedLine -match "^- (.*)") {
            [void]$bulletPoints.Add($matches[1].Value)
        }
    }
    
    # Extract signature if present
    $signature = ""
    $signatureRegex = [regex]"_Updated (.*?) \| (.*?)_"
    $signatureMatch = $signatureRegex.Match($content)
    if ($signatureMatch.Success) {
        $updateDate = $signatureMatch.Groups[1].Value
        $updatedBy = $signatureMatch.Groups[2].Value
        $signature = @{
            updateDate = $updateDate
            updatedBy = $updatedBy
        }
    }
    
    # Add to entries collection
    $entry = [PSCustomObject]@{
        title = $title
        date = $date
        content = $content
        bulletPoints = $bulletPoints
        signature = $signature
    }
    
    [void]$entries.Add($entry)
}

# Create JSON structure
$jsonContent = [PSCustomObject]@{
    metadata = $fileMetadata
    entriesCount = $entries.Count
    entries = $entries
}

# Output to file
Write-Host "Writing JSON to: $OutputFile"
$jsonContent | ConvertTo-Json -Depth 10 | Out-File -FilePath $OutputFile -Encoding utf8

Write-Host "Conversion completed successfully." 