# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

######## Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$(Split-Path -Path $PSCommandPath -Leaf)-error-log.txt"
    )
    
    ######## Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    }
    
    ######## Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in ${Operation}: $(${Error}.Exception.Message)"
    $errorDetails = "Exception Type: $(${Error}.Exception.GetType().FullName)
Stack Trace: $(${Error}.ScriptStackTrace)"
    
    ######## Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    ######## Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    ######## Return error information
    return @{
        Message = ${Error}.Exception.Message
        Type = ${Error}.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

# verify-directory-structure.ps1
# Purpose: Verify and create necessary directory structure for the project
# Created: 2025-03-20
# Author: Claude 3.7 Sonnet

# Set error action preference
$ErrorActionPreference = "Stop"

######## Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

######## Log file path
$logFile = Join-Path -Path $logDir -ChildPath "directory-verification-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

######## Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    ######## Write to console with different colors based on level
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
        "SUCCESS" { Write-Host $logMessage -ForegroundColor Green }
    }
    
    ######## Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

######## Function to verify and create directory
function Verify-Directory {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Path,
        
        [Parameter(Mandatory = $false)]
        [string]$Description = "",
        
        [Parameter(Mandatory = $false)]
        [switch]$Create = $true
    )
    
    try {
        if (Test-Path -Path $Path -PathType Container) {
            Write-Log "Directory exists: $Path" -Level "INFO"
            return $true
        }
        else {
            if ($Create) {
                Write-Log "Creating directory: $Path" -Level "INFO"
                New-Item -Path $Path -ItemType Directory -Force | Out-Null
                
                if (Test-Path -Path $Path -PathType Container) {
                    Write-Log "Directory created: $Path" -Level "SUCCESS"
                    return $true
                }
                else {
                    Write-Log "Failed to create directory: $Path" -Level "ERROR"
                    return $false
                }
            }
            else {
                Write-Log "Directory does not exist: $Path" -Level "WARNING"
                return $false
            }
        }
    }
    catch {
        Write-Log "Error verifying directory $Path. Error: $_" -Level "ERROR"
        return $false
    }
}

######## Function to verify and create required directories
function Verify-RequiredDirectories {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WorkspaceRoot
    )
    
    $requiredDirectories = @(
        ######## Scripts directories
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\config"; Description = "Configuration directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\logs"; Description = "Logs directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\backups"; Description = "Backups directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\reports"; Description = "Reports directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\Templates"; Description = "Templates directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\Services"; Description = "Services directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Scripts\Services\Documentation"; Description = "Services documentation directory" },
        
        ######## Documentation directories
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\Core"; Description = "Core documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\Organization"; Description = "Organization documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\Implementation"; Description = "Implementation documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\tYDiSync"; Description = "tYDiSync documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\Tools"; Description = "Tools documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "Documentation\Reference"; Description = "Reference documentation directory" },
        
        ######## Department documentation directories
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U1-Administration\Documentation"; Description = "U1 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U2-Research\Documentation"; Description = "U2 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U3-Operations\Documentation"; Description = "U3 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U3-Operations\Documentation\SOPs"; Description = "U3 SOPs directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U4-Production\Documentation"; Description = "U4 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U4-Production\Documentation\WordPress"; Description = "U4 WordPress documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U5-Data\Documentation"; Description = "U5 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U6-Marketing\Documentation"; Description = "U6 documentation directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "U7-Systems\Documentation"; Description = "U7 documentation directory" },
        
        ######## WordPress directories
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "WordPress"; Description = "WordPress root directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "WordPress\wp-content"; Description = "WordPress content directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "WordPress\wp-content\themes"; Description = "WordPress themes directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "WordPress\wp-content\plugins"; Description = "WordPress plugins directory" },
        
        ######## Workbench directories
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "cFish-WB\active"; Description = "Master workbench active directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "cFish-WB\WB-readme"; Description = "Master workbench readme directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "cFish-WB\next-WB"; Description = "Master workbench next directory" },
        @{ Path = Join-Path -Path $WorkspaceRoot -ChildPath "cFish-WB\next-readme"; Description = "Master workbench next readme directory" }
    )
    
    $successCount = 0
    $failureCount = 0
    
    foreach ($dir in $requiredDirectories) {
        Write-Log "Verifying directory: $($dir.Path) ($($dir.Description))" -Level "INFO"
        $result = Verify-Directory -Path $dir.Path -Description $dir.Description -Create
        
        if ($result) {
            $successCount++
        }
        else {
            $failureCount++
        }
    }
    
    Write-Log "Directory verification completed. Success: $successCount, Failure: $failureCount" -Level "INFO"
    
    return @{
        SuccessCount = $successCount
        FailureCount = $failureCount
        TotalCount = $requiredDirectories.Count
    }
}

######## Function to generate directory structure report
function Generate-DirectoryReport {
    param (
        [Parameter(Mandatory = $true)]
        [string]$WorkspaceRoot,
        
        [Parameter(Mandatory = $true)]
        [hashtable]$Results
    )
    
    $reportFile = Join-Path -Path $logDir -ChildPath "directory-structure-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $report = @"
######## Directory Structure Verification Report

######### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Status**: $(if ($Results.FailureCount -eq 0) { "Completed Successfully" } else { "Completed with Issues" })

######### Results
- **Directories Verified**: $($Results.TotalCount)
- **Success**: $($Results.SuccessCount)
- **Failure**: $($Results.FailureCount)

######### Directory Structure
The following directory structure has been verified and created if necessary:

########## Scripts Directories
- U5-Data\Scripts\config
- U5-Data\Scripts\logs
- U5-Data\Scripts\backups
- U5-Data\Scripts\reports
- U5-Data\Scripts\Templates
- U5-Data\Scripts\Services
- U5-Data\Scripts\Services\Documentation

########## Documentation Directories
- Documentation\Core
- Documentation\Organization
- Documentation\Implementation
- Documentation\tYDiSync
- Documentation\Tools
- Documentation\Reference

########## Department Documentation Directories
- U1-Administration\Documentation
- U2-Research\Documentation
- U3-Operations\Documentation
- U3-Operations\Documentation\SOPs
- U4-Production\Documentation
- U4-Production\Documentation\WordPress
- U5-Data\Documentation
- U6-Marketing\Documentation
- U7-Systems\Documentation

########## WordPress Directories
- WordPress
- WordPress\wp-content
- WordPress\wp-content\themes
- WordPress\wp-content\plugins

########## Workbench Directories
- cFish-WB\active
- cFish-WB\WB-readme
- cFish-WB\next-WB
- cFish-WB\next-readme

######### Next Steps
1. Update path references in scripts to use these verified directories
2. Ensure all new files are created in the appropriate directories
3. Move existing files to the correct locations if needed

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $report
    Write-Log "Created directory structure report at $reportFile" -Level "INFO"
    
    return $reportFile
}

######## Main execution
function Main {
    param (
        [Parameter(Mandatory = $false)]
        [string]$WorkspaceRoot = (Get-Location | Select-Object -ExpandProperty Path)
    )
    
    Write-Log "Starting directory structure verification" -Level "INFO"
    Write-Log "Workspace root: $WorkspaceRoot" -Level "INFO"
    
    $results = Verify-RequiredDirectories -WorkspaceRoot $WorkspaceRoot
    
    $reportFile = Generate-DirectoryReport -WorkspaceRoot $WorkspaceRoot -Results $results
    
    Write-Log "Directory structure verification completed. Success: $($results.SuccessCount), Failure: $($results.FailureCount)" -Level "INFO"
    
    if ($results.FailureCount -eq 0) {
        Write-Host "`nDirectory structure verification completed successfully." -ForegroundColor Green
        Write-Host "See $reportFile for details." -ForegroundColor Cyan
    }
    else {
        Write-Host "`nDirectory structure verification completed with $($results.FailureCount) failures." -ForegroundColor Yellow
        Write-Host "See $reportFile for details." -ForegroundColor Cyan
    }
    
    return $results
}

######## Execute the script
if ($MyInvocation.InvocationName -ne ".") {
    # Script is being run directly, not dot-sourced
    $workspaceRoot = (Get-Item $PSScriptRoot).Parent.Parent.FullName
    Main -WorkspaceRoot $workspaceRoot
} 



