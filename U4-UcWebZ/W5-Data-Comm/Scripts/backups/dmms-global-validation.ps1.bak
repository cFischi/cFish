# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

#### Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$PSCommandPath-error-log.txt"
    )
    
    #### Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Handle-Error"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    #### Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in $Operation: $($Error.Exception.Message)"
    $errorDetails = "Exception Type: $($Error.Exception.GetType().FullName)
Stack Trace: $($Error.ScriptStackTrace)"
    
    #### Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    #### Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    #### Return error information
    return @{
        Message = $Error.Exception.Message
        Type = $Error.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

#### dmms-global-validation.ps1
#### Purpose: Implement global validation rules and data integrity checks for DMMS
#### Created: 2025-03-19
#### Author: Claude 3.7 Sonnet

#### Script parameters
param (
    [Parameter(Mandatory = $false)]
    [string]$ConfigPath = "config\validation-rules.json",
    
    [Parameter(Mandatory = $false)]
    [string]$LogLevel = "INFO",
    
    [Parameter(Mandatory = $false)]
    [switch]$FixIssues = $false,
    
    [Parameter(Mandatory = $false)]
    [switch]$GenerateReport = $true
)

#### Set error action preference
$ErrorActionPreference = "Stop"

#### Create log directory if it doesn't exist
$logDir = Join-Path -Path $PSScriptRoot -ChildPath "logs"
if (-not (Test-Path -Path $logDir)) {
    New-Item -Path $logDir -ItemType Directory -Force | Out-Null
}

#### Log file path
$logFile = Join-Path -Path $logDir -ChildPath "dmms-global-validation-$(Get-Date -Format 'yyyyMMdd-HHmmss').log"

#### Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR", "DEBUG")]
        [string]$Level = "INFO"
    )
    
    #### Check if we should log this level
    $logLevelMap = @{
        "DEBUG" = 0
        "INFO" = 1
        "WARNING" = 2
        "ERROR" = 3
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-Log"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    if ($logLevelMap[$Level] -ge $logLevelMap[$LogLevel]) {
        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        $logMessage = "[$timestamp] [$Level] $Message"
        
        #### Write to console with different colors based on level
        switch ($Level) {
            "DEBUG" { Write-Host $logMessage -ForegroundColor Gray }
            "INFO" { Write-Host $logMessage -ForegroundColor Cyan }
            "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
            "ERROR" { Write-Host $logMessage -ForegroundColor Red }
        }
        
        #### Write to log file
        Add-Content -Path $logFile -Value $logMessage
    }
}

#### Function to load validation rules
function Load-ValidationRules {
    param (
        [Parameter(Mandatory = $true)]
        [string]$ConfigPath
    )
    
    $configFullPath = Join-Path -Path $PSScriptRoot -ChildPath $ConfigPath
    
    if (-not (Test-Path -Path $configFullPath)) {
        Write-Log "Validation rules configuration file not found at $configFullPath" -Level "ERROR"
        Write-Log "Creating default validation rules configuration" -Level "WARNING"
        
        #### Create default validation rules
        $defaultRules = @{
            "Version" = "1.0"
            "LastUpdated" = (Get-Date -Format "yyyy-MM-dd")
            "GlobalRules" = @(
                @{
                    "RuleId" = "GR001"
                    "Name" = "FileExtensionMatch"
                    "Description" = "Ensures file content type matches its extension"
                    "Severity" = "Error"
                    "Parameters" = @{
                        "AllowedExtensions" = @(".ps1", ".bat", ".json", ".md", ".txt", ".log", ".csv")
                    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Load-ValidationRules"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
                },
                @{
                    "RuleId" = "GR002"
                    "Name" = "NoHardcodedCredentials"
                    "Description" = "Checks for hardcoded credentials in scripts"
                    "Severity" = "Critical"
                    "Parameters" = @{
                        "Patterns" = @(
                            'password\s*=\s*["''][^"'']+["'']',
                            'pwd\s*=\s*["''][^"'']+["'']',
                            'apikey\s*=\s*["''][^"'']+["'']',
                            'secret\s*=\s*["''][^"'']+["'']'
                        )
                    }
                },
                @{
                    "RuleId" = "GR003"
                    "Name" = "DataSchemaValidation"
                    "Description" = "Validates JSON/CSV files against schema"
                    "Severity" = "Warning"
                    "Parameters" = @{
                        "SchemaPath" = "config\schemas\"
                    }
                }
            )
            "FileTypeRules" = @{
                "PowerShell" = @(
                    @{
                        "RuleId" = "PS001"
                        "Name" = "ProperErrorHandling"
                        "Description" = "Checks for proper error handling in PowerShell scripts"
                        "Severity" = "Warning"
                        "Parameters" = @{
                            "RequiredPatterns" = @(
                                'try\s*\{[\s\S]*?catch\s*\{[\s\S]*?\}'
                            )
                        }
                    },
                    @{
                        "RuleId" = "PS002"
                        "Name" = "LoggingPresent"
                        "Description" = "Ensures logging is implemented in scripts"
                        "Severity" = "Warning"
                        "Parameters" = @{
                            "RequiredPatterns" = @(
                                'Write-Log',
                                'Add-Content\s+-Path\s+.*log'
                            )
                        }
                    }
                )
                "BatchFile" = @(
                    @{
                        "RuleId" = "BAT001"
                        "Name" = "ErrorLevelChecking"
                        "Description" = "Ensures error level checking is implemented"
                        "Severity" = "Warning"
                        "Parameters" = @{
                            "RequiredPatterns" = @(
                                'if\s+%ERRORLEVEL%\s+',
                                'if\s+errorlevel\s+'
                            )
                        }
                    }
                )
                "JSON" = @(
                    @{
                        "RuleId" = "JSON001"
                        "Name" = "ValidJSON"
                        "Description" = "Ensures JSON is valid"
                        "Severity" = "Error"
                        "Parameters" = @{}
                    }
                )
                "Markdown" = @(
                    @{
                        "RuleId" = "MD001"
                        "Name" = "ProperHeadings"
                        "Description" = "Ensures markdown has proper heading structure"
                        "Severity" = "Warning"
                        "Parameters" = @{
                            "RequiredPatterns" = @(
                                '^#\s+',
                                '^##\s+'
                            )
                        }
                    }
                )
            }
        }
        
        #### Create directory if it doesn't exist
        $configDir = Split-Path -Path $configFullPath -Parent
        if (-not (Test-Path -Path $configDir)) {
            New-Item -Path $configDir -ItemType Directory -Force | Out-Null
            Write-Log "Created configuration directory at $configDir" -Level "INFO"
        }
        
        #### Save default rules to file
        $defaultRules | ConvertTo-Json -Depth 10 | Set-Content -Path $configFullPath
        Write-Log "Created default validation rules at $configFullPath" -Level "INFO"
        
        return $defaultRules
    }
    
    try {
        $rules = Get-Content -Path $configFullPath -Raw | ConvertFrom-Json
        Write-Log "Loaded validation rules from $configFullPath" -Level "INFO"
        return $rules
    }
    catch {
        Write-Log "Error loading validation rules: $_" -Level "ERROR"
        throw "Failed to load validation rules. See log for details."
    }
}

#### Function to validate a file
function Validate-File {
    param (
        [Parameter(Mandatory = $true)]
        [string]$FilePath,
        
        [Parameter(Mandatory = $true)]
        [object]$Rules,
        
        [Parameter(Mandatory = $false)]
        [switch]$FixIssues = $false
    )
    
    if (-not (Test-Path -Path $FilePath)) {
        Write-Log "File not found: $FilePath" -Level "ERROR"
        return @{
            FilePath = $FilePath
            IsValid = $false
            Errors = @(@{
                RuleId = "SYSTEM"
                Message = "File not found"
                Severity = "Error"
            
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Validate-File"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
})
            Fixed = $false
        }
    }
    
    $fileExtension = [System.IO.Path]::GetExtension($FilePath)
    $fileName = [System.IO.Path]::GetFileName($FilePath)
    $fileContent = Get-Content -Path $FilePath -Raw
    
    Write-Log "Validating file: $FilePath" -Level "DEBUG"
    
    #### Determine file type
    $fileType = switch ($fileExtension) {
        ".ps1" { "PowerShell" }
        ".bat" { "BatchFile" }
        ".json" { "JSON" }
        ".md" { "Markdown" }
        ".log" { "LogFile" }
        ".csv" { "CSV" }
        default { "Unknown" }
    }
    
    $issues = @()
    
    #### Apply global rules
    foreach ($rule in $Rules.GlobalRules) {
        Write-Log "Applying global rule $($rule.RuleId): $($rule.Name)" -Level "DEBUG"
        
        switch ($rule.RuleId) {
            "GR001" {
                #### File extension match rule
                $isValidExtension = $rule.Parameters.AllowedExtensions -contains $fileExtension
                if (-not $isValidExtension) {
                    $issues += @{
                        RuleId = $rule.RuleId
                        Name = $rule.Name
                        Message = "File extension $fileExtension is not in the allowed list"
                        Severity = $rule.Severity
                        CanFix = $false
                    }
                }
            }
            "GR002" {
                #### No hardcoded credentials rule
                foreach ($pattern in $rule.Parameters.Patterns) {
                    if ($fileContent -match $pattern) {
                        $match = $Matches[0]
                        $issues += @{
                            RuleId = $rule.RuleId
                            Name = $rule.Name
                            Message = "Hardcoded credential pattern found: $match"
                            Severity = $rule.Severity
                            CanFix = $false
                        }
                    }
                }
            }
            "GR003" {
                #### Data schema validation - simplified implementation
                if (($fileType -eq "JSON" -or $fileType -eq "CSV") -and ($rule.Parameters.SchemaPath)) {
                    $schemaPath = Join-Path -Path $PSScriptRoot -ChildPath $rule.Parameters.SchemaPath
                    $schemaPath = Join-Path -Path $schemaPath -ChildPath "$fileType.schema.json"
                    
                    if (Test-Path -Path $schemaPath) {
                        Write-Log "Schema validation would be performed here with schema: $schemaPath" -Level "DEBUG"
                        #### Simplified: In a real implementation, we would validate against the schema
                    }
                    else {
                        Write-Log "Schema file not found: $schemaPath" -Level "WARNING"
                    }
                }
            }
        }
    }
    
    #### Apply file type specific rules
    if ($fileType -ne "Unknown" -and $Rules.FileTypeRules.$fileType) {
        foreach ($rule in $Rules.FileTypeRules.$fileType) {
            Write-Log "Applying $fileType rule $($rule.RuleId): $($rule.Name)" -Level "DEBUG"
            
            if ($rule.Parameters.RequiredPatterns) {
                $patternFound = $false
                
                foreach ($pattern in $rule.Parameters.RequiredPatterns) {
                    if ($fileContent -match $pattern) {
                        $patternFound = $true
                        break
                    }
                }
                
                if (-not $patternFound) {
                    $issues += @{
                        RuleId = $rule.RuleId
                        Name = $rule.Name
                        Message = "Required pattern not found in $fileName"
                        Severity = $rule.Severity
                        CanFix = $false
                    }
                }
            }
            
            #### Handle specific file type rules
            switch ($rule.RuleId) {
                "JSON001" {
                    #### JSON validation
                    if ($fileType -eq "JSON") {
                        try {
                            $null = $fileContent | ConvertFrom-Json
                        }
                        catch {
                            $issues += @{
                                RuleId = $rule.RuleId
                                Name = $rule.Name
                                Message = "Invalid JSON structure: $_"
                                Severity = $rule.Severity
                                CanFix = $false
                            }
                        }
                    }
                }
            }
        }
    }
    
    #### Log results
    $isValid = $issues.Count -eq 0
    $result = @{
        FilePath = $FilePath
        FileType = $fileType
        IsValid = $isValid
        Issues = $issues
        Fixed = $false
    }
    
    if ($isValid) {
        Write-Log "File validated successfully: $FilePath" -Level "INFO"
    }
    else {
        Write-Log "$($issues.Count) validation issues found in $FilePath" -Level "WARNING"
        
        foreach ($issue in $issues) {
            Write-Log "  [${$issue.Severity}] $($issue.RuleId): $($issue.Message)" -Level "WARNING"
        }
        
        #### Apply fixes if requested and possible
        if ($FixIssues) {
            Write-Log "Attempting to fix issues in $FilePath" -Level "INFO"
            $fixCount = 0
            
            #### Implementation of fixes would go here
            #### This is a placeholder for actual fix logic
            
            $result.Fixed = $fixCount -gt 0
            
            if ($result.Fixed) {
                Write-Log "Fixed $fixCount issues in $FilePath" -Level "INFO"
            }
            else {
                Write-Log "No issues could be automatically fixed in $FilePath" -Level "WARNING"
            }
        }
    }
    
    return $result
}

#### Function to scan a directory for files to validate
function Scan-Directory {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Directory,
        
        [Parameter(Mandatory = $true)]
        [object]$Rules,
        
        [Parameter(Mandatory = $false)]
        [string[]]$FileTypes = @("*.ps1", "*.bat", "*.json", "*.md", "*.csv"),
        
        [Parameter(Mandatory = $false)]
        [switch]$FixIssues = $false
    )
    
    if (-not (Test-Path -Path $Directory -PathType Container)) {
        Write-Log "Directory not found: $Directory" -Level "ERROR"
        return @()
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Scan-Directory"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    Write-Log "Scanning directory: $Directory" -Level "INFO"
    
    $files = Get-ChildItem -Path $Directory -Include $FileTypes -Recurse -File
    $results = @()
    
    $totalFiles = $files.Count
    $validFiles = 0
    $filesWithIssues = 0
    $fixedFiles = 0
    
    Write-Log "Found $totalFiles files to validate" -Level "INFO"
    
    foreach ($file in $files) {
        $result = Validate-File -FilePath $file.FullName -Rules $Rules -FixIssues:$FixIssues
        $results += $result
        
        if ($result.IsValid) {
            $validFiles++
        }
        else {
            $filesWithIssues++
            if ($result.Fixed) {
                $fixedFiles++
            }
        }
    }
    
    Write-Log "Validation complete. $validFiles/$totalFiles files valid, $filesWithIssues files with issues, $fixedFiles files fixed." -Level "INFO"
    
    return $results
}

#### Function to generate a validation report
function Generate-ValidationReport {
    param (
        [Parameter(Mandatory = $true)]
        [array]$Results,
        
        [Parameter(Mandatory = $false)]
        [string]$ReportPath = ""
    )
    
    if ($ReportPath -eq "") {
        $ReportPath = Join-Path -Path $logDir -ChildPath "validation-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Generate-ValidationReport"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    Write-Log "Generating validation report at $ReportPath" -Level "INFO"
    
    $totalFiles = $Results.Count
    $validFiles = ($Results | Where-Object { $_.IsValid }).Count
    $invalidFiles = $totalFiles - $validFiles
    $fixedFiles = ($Results | Where-Object { $_.Fixed }).Count
    
    $validPercentage = if ($totalFiles -gt 0) { [math]::Round(($validFiles / $totalFiles) * 100, 2) } else { 0 }
    
    $reportContent = @"
#### DMMS Global Validation Report

##### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Files Scanned**: $totalFiles
- **Valid Files**: $validFiles ($validPercentage%)
- **Files with Issues**: $invalidFiles
- **Files Fixed**: $fixedFiles

##### Issues by Severity

| Severity | Count |
|----------|-------|
"@
    
    # Count issues by severity
    $severityCounts = @{}
    foreach ($result in $Results) {
        foreach ($issue in $result.Issues) {
            if (-not $severityCounts.ContainsKey($issue.Severity)) {
                $severityCounts[$issue.Severity] = 0
            }
            $severityCounts[$issue.Severity]++
        }
    }
    
    foreach ($severity in $severityCounts.Keys | Sort-Object) {
        $reportContent += "| $severity | $($severityCounts[$severity]) |`n"
    }
    
    $reportContent += @"

##### Issues by Rule

| Rule ID | Rule Name | Count |
|---------|-----------|-------|
"@
    
    # Count issues by rule
    $ruleCounts = @{}
    foreach ($result in $Results) {
        foreach ($issue in $result.Issues) {
            $ruleKey = "$($issue.RuleId) - $($issue.Name)"
            if (-not $ruleCounts.ContainsKey($ruleKey)) {
                $ruleCounts[$ruleKey] = 0
            }
            $ruleCounts[$ruleKey]++
        }
    }
    
    foreach ($rule in $ruleCounts.Keys | Sort-Object) {
        $ruleId, $ruleName = $rule -split ' - ', 2
        $reportContent += "| $ruleId | $ruleName | $($ruleCounts[$rule]) |`n"
    }
    
    $reportContent += @"

##### Files with Issues

| File | File Type | Issues | Fixed |
|------|-----------|--------|-------|
"@
    
    foreach ($result in ($Results | Where-Object { -not $_.IsValid } | Sort-Object -Property FilePath)) {
        $filePath = $result.FilePath
        $fileType = $result.FileType
        $issueCount = $result.Issues.Count
        $fixed = if ($result.Fixed) { "Yes" } else { "No" }
        
        $reportContent += "| $filePath | $fileType | $issueCount | $fixed |`n"
    }
    
    $reportContent += @"

##### Next Steps
1. Address critical severity issues immediately
2. Review warning issues during scheduled maintenance
3. Update validation rules as needed
4. Run validation weekly to ensure ongoing compliance

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $ReportPath -Value $reportContent
    Write-Log "Validation report generated at $ReportPath" -Level "INFO"
    
    return $ReportPath
}

#### Main execution
try {
    Write-Log "Starting DMMS Global Validation" -Level "INFO"
    Write-Log "Parameters: ConfigPath=$ConfigPath, LogLevel=$LogLevel, FixIssues=$FixIssues, GenerateReport=$GenerateReport" -Level "DEBUG"
    
    #### Load validation rules
    $rules = Load-ValidationRules -ConfigPath $ConfigPath
    Write-Log "Loaded validation rules version $($rules.Version), last updated $($rules.LastUpdated)" -Level "INFO"
    
    #### Define directories to scan
    $dirsToScan = @(
        (Join-Path -Path $PSScriptRoot -ChildPath "."),  #### Current directory (Scripts)
        (Join-Path -Path $PSScriptRoot -ChildPath "..\..\cFish-WB\active")  #### Workbench active directory
    )
    
    $allResults = @()
    
    #### Scan each directory
    foreach ($dir in $dirsToScan) {
        if (Test-Path -Path $dir -PathType Container) {
            Write-Log "Scanning directory: $dir" -Level "INFO"
            $results = Scan-Directory -Directory $dir -Rules $rules -FixIssues:$FixIssues
            $allResults += $results
        }
        else {
            Write-Log "Directory not found, skipping: $dir" -Level "WARNING"
        }
    }
    
    #### Generate validation report if requested
    if ($GenerateReport) {
        $reportPath = Generate-ValidationReport -Results $allResults
        Write-Host "`nValidation report generated at $reportPath" -ForegroundColor Green
    }
    
    #### Log summary
    $totalFiles = $allResults.Count
    $validFiles = ($allResults | Where-Object { $_.IsValid }).Count
    $invalidFiles = $totalFiles - $validFiles
    $fixedFiles = ($allResults | Where-Object { $_.Fixed }).Count
    
    Write-Log "DMMS Global Validation complete" -Level "INFO"
    Write-Log "Summary: $validFiles/$totalFiles files valid, $invalidFiles files with issues, $fixedFiles files fixed" -Level "INFO"
    
    Write-Host "`nDMMS Global Validation complete." -ForegroundColor Green
    Write-Host "Log file: $logFile" -ForegroundColor Cyan
    
    #### Exit with error code if any issues found
    if ($invalidFiles -gt 0) {
        Write-Host "`nWARNING: $invalidFiles files have validation issues. See report for details." -ForegroundColor Yellow
        exit 1
    }
    else {
        Write-Host "`nSUCCESS: All files passed validation." -ForegroundColor Green
        exit 0
    }
}
catch {
    Write-Log "Fatal error in DMMS Global Validation: $_" -Level "ERROR"
    Write-Log $_.ScriptStackTrace -Level "ERROR"
    
    Write-Host "`nERROR: DMMS Global Validation failed with an error." -ForegroundColor Red
    Write-Host "See log file for details: $logFile" -ForegroundColor Red
    
    exit 9999
} 


