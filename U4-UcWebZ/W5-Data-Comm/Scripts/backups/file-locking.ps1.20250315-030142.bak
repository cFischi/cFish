# Enhanced error handling added 2025-03-15
$ErrorActionPreference = "Stop"

######## Error handling function
function Handle-Error {
    param (
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.ErrorRecord]$Error,
        
        [Parameter(Mandatory = $true)]
        [string]$Operation,
        
        [Parameter(Mandatory = $false)]
        [string]$LogFile = "$PSScriptRoot\logs\$PSCommandPath-error-log.txt"
    )
    
    ######## Create log directory if it doesn't exist
    $logDir = Split-Path -Path $LogFile -Parent
    if (-not (Test-Path -Path $logDir)) {
        New-Item -Path $logDir -ItemType Directory -Force | Out-Null
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Handle-Error"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    ######## Format error message
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $errorMessage = "[$timestamp] ERROR in $Operation: $($Error.Exception.Message)"
    $errorDetails = "Exception Type: $($Error.Exception.GetType().FullName)
Stack Trace: $($Error.ScriptStackTrace)"
    
    ######## Write to log file
    Add-Content -Path $LogFile -Value $errorMessage
    Add-Content -Path $LogFile -Value $errorDetails
    Add-Content -Path $LogFile -Value "----------------------------------------"
    
    ######## Display error message
    Write-Host $errorMessage -ForegroundColor Red
    
    ######## Return error information
    return @{
        Message = $Error.Exception.Message
        Type = $Error.Exception.GetType().FullName
        Operation = $Operation
        Time = $timestamp
    }
}

<######## .SYNOPSIS
    Implements a file locking system for the DMMS to prevent concurrent modifications.

.DESCRIPTION
    This script provides functions to lock and unlock files during synchronization operations,
    preventing multiple processes from modifying the same files simultaneously. It includes
    timeout capabilities, forced unlock options, and lock status monitoring.

.NOTES
    File Name      : file-locking.ps1
    Author         : tY FischEYe via Cursor/Claude
    Prerequisite   : PowerShell V3
    Copyright      : cFish.io 2025
    Date           : March 23, 2025
    Version        : 1.0
#>

######## Get workspace root directory
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$workspaceRoot = Split-Path -Parent (Split-Path -Parent $scriptDir)

######## Lock file directory
$lockDir = Join-Path -Path $scriptDir -ChildPath "locks"
if (!(Test-Path $lockDir)) {
    New-Item -ItemType Directory -Path $lockDir -Force | Out-Null
}

######## Log directory
$logDir = Join-Path -Path $scriptDir -ChildPath "logs"
if (!(Test-Path $logDir)) {
    New-Item -ItemType Directory -Path $logDir -Force | Out-Null
}
$logFile = Join-Path -Path $logDir -ChildPath "file_locking_$(Get-Date -Format 'yyyyMMdd').log"

######## Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory=$true)]
        [string]$Message,
        
        [Parameter(Mandatory=$false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] [$Level] $Message"
    
    Add-Content -Path $logFile -Value $logEntry
    
    ######## Also write to console with appropriate color
    switch ($Level) {
        "INFO" { Write-Host $logEntry -ForegroundColor White 
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-Log"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
        "WARNING" { Write-Host $logEntry -ForegroundColor Yellow }
        "ERROR" { Write-Host $logEntry -ForegroundColor Red }
    }
}

######## Function to get lock file path for a given file
function Get-LockFilePath {
    param (
        [Parameter(Mandatory=$true)]
        [string]$FilePath
    )
    
    ######## Convert full path to relative path if it's under the workspace
    $relativePath = $FilePath
    if ($FilePath.StartsWith($workspaceRoot)) {
        $relativePath = $FilePath.Substring($workspaceRoot.Length).TrimStart('\', '/')
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Get-LockFilePath"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    ######## Replace characters that aren't valid in filenames
    $safeFileName = $relativePath -replace '[\\\/\:\*\?\"\<\>\|]', '_'
    
    return Join-Path -Path $lockDir -ChildPath "$safeFileName.lock"
}

######## Function to lock a file
function Lock-File {
    param (
        [Parameter(Mandatory=$true)]
        [string]$FilePath,
        
        [Parameter(Mandatory=$false)]
        [int]$TimeoutSeconds = 30
    )
    
    $lockFilePath = Get-LockFilePath -FilePath $FilePath
    $processId = [System.Diagnostics.Process]::GetCurrentProcess().Id
    $computerName = [System.Environment]::MachineName
    $userName = [System.Environment]::UserName
    $startTime = Get-Date
    $endTime = $startTime.AddSeconds($TimeoutSeconds)
    
    ######## Wait until timeout or successful lock acquisition
    while ((Get-Date) -lt $endTime) {
        ######## Check if lock file exists
        if (Test-Path $lockFilePath) {
            ######## Lock exists, check if it's stale
            try {
                $lockInfo = Get-Content -Path $lockFilePath -Raw | ConvertFrom-Json
                $lockTime = [DateTime]::ParseExact($lockInfo.timestamp, "yyyy-MM-dd HH:mm:ss", [System.Globalization.CultureInfo]::InvariantCulture)
                $lockAge = (Get-Date) - $lockTime
                
                ######## If lock is older than 5 minutes, consider it stale
                if ($lockAge.TotalMinutes -gt 5) {
                    Write-Log "Stale lock found for '$FilePath'. Lock age: $($lockAge.TotalMinutes) minutes. Breaking stale lock." -Level "WARNING"
                    Remove-Item -Path $lockFilePath -Force
                } else {
                    ######## Lock is valid, wait and retry
                    Write-Log "File '$FilePath' is locked by $($lockInfo.userName) on $($lockInfo.computerName) (PID: $($lockInfo.processId)). Waiting..." -Level "INFO"
                    Start-Sleep -Seconds 2
                    continue
                }
            } catch {
                ######## Invalid lock file, remove it
                Write-Log "Invalid lock file found for '$FilePath'. Breaking invalid lock." -Level "WARNING"
                Remove-Item -Path $lockFilePath -Force
            }
        }
        
        ######## Try to create lock file
        try {
            $lockInfo = @{
                filePath = $FilePath
                processId = $processId
                computerName = $computerName
                userName = $userName
                timestamp = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
            }
            
            $lockInfo | ConvertTo-Json | Set-Content -Path $lockFilePath
            Write-Log "Successfully locked file: '$FilePath'" -Level "INFO"
            return $true
        } catch {
            Write-Log "Error creating lock file for '$FilePath': $_" -Level "ERROR"
            Start-Sleep -Seconds 1
        }
    }
    
    Write-Log "Failed to acquire lock for '$FilePath' after $TimeoutSeconds seconds" -Level "ERROR"
    return $false
}

######## Function to unlock a file
function Unlock-File {
    param (
        [Parameter(Mandatory=$true)]
        [string]$FilePath,
        
        [Parameter(Mandatory=$false)]
        [switch]$Force
    )
    
    $lockFilePath = Get-LockFilePath -FilePath $FilePath
    
    ######## Check if lock file exists
    if (!(Test-Path $lockFilePath)) {
        Write-Log "No lock found for file: '$FilePath'" -Level "WARNING"
        return $true
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Unlock-File"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    ######## Verify lock ownership if not forced
    if (!$Force) {
        try {
            $lockInfo = Get-Content -Path $lockFilePath -Raw | ConvertFrom-Json
            $processId = [System.Diagnostics.Process]::GetCurrentProcess().Id
            
            if ($lockInfo.processId -ne $processId) {
                Write-Log "Cannot unlock file '$FilePath'. Lock is owned by another process (PID: $($lockInfo.processId))" -Level "ERROR"
                return $false
            }
        } catch {
            Write-Log "Error reading lock file for '$FilePath': $_" -Level "ERROR"
            if ($Force) {
                ######## Continue with forced unlock
                Write-Log "Proceeding with forced unlock due to -Force parameter" -Level "WARNING"
            } else {
                return $false
            }
        }
    }
    
    ######## Remove lock file
    try {
        Remove-Item -Path $lockFilePath -Force
        Write-Log "Successfully unlocked file: '$FilePath'" -Level "INFO"
        return $true
    } catch {
        Write-Log "Error removing lock file for '$FilePath': $_" -Level "ERROR"
        return $false
    }
}

######## Function to check if a file is locked
function Test-FileLock {
    param (
        [Parameter(Mandatory=$true)]
        [string]$FilePath
    )
    
    $lockFilePath = Get-LockFilePath -FilePath $FilePath
    
    ######## Check if lock file exists
    if (!(Test-Path $lockFilePath)) {
        return @{
            locked = $false
            lockInfo = $null
        
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Test-FileLock"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    }
    
    ######## Read lock information
    try {
        $lockInfo = Get-Content -Path $lockFilePath -Raw | ConvertFrom-Json
        $lockTime = [DateTime]::ParseExact($lockInfo.timestamp, "yyyy-MM-dd HH:mm:ss", [System.Globalization.CultureInfo]::InvariantCulture)
        $lockAge = (Get-Date) - $lockTime
        
        ######## If lock is older than 5 minutes, consider it stale
        if ($lockAge.TotalMinutes -gt 5) {
            return @{
                locked = $false
                lockInfo = $lockInfo
                stale = $true
                lockAge = $lockAge
            }
        }
        
        return @{
            locked = $true
            lockInfo = $lockInfo
            stale = $false
            lockAge = $lockAge
        }
    } catch {
        Write-Log "Error reading lock file for '$FilePath': $_" -Level "ERROR"
        return @{
            locked = $false
            lockInfo = $null
            error = $_
        }
    }
}

######## Function to get all locks
function Get-AllLocks {
    $locks = @()
    
    ######## Get all lock files
    $lockFiles = Get-ChildItem -Path $lockDir -Filter "*.lock"
    
    foreach ($lockFile in $lockFiles) {
        try {
            $lockInfo = Get-Content -Path $lockFile.FullName -Raw | ConvertFrom-Json
            $lockTime = [DateTime]::ParseExact($lockInfo.timestamp, "yyyy-MM-dd HH:mm:ss", [System.Globalization.CultureInfo]::InvariantCulture)
            $lockAge = (Get-Date) - $lockTime
            
            $locks += @{
                filePath = $lockInfo.filePath
                processId = $lockInfo.processId
                computerName = $lockInfo.computerName
                userName = $lockInfo.userName
                timestamp = $lockInfo.timestamp
                lockAge = $lockAge
                lockFile = $lockFile.FullName
                stale = ($lockAge.TotalMinutes -gt 5)
            }
        } catch {
            Write-Log "Error reading lock file '$($lockFile.FullName)': $_" -Level "ERROR"
        }
    }
    
    return $locks
}

######## Function to clean up stale locks
function Remove-StaleLocks {
    $locks = Get-AllLocks
    $staleCount = 0
    
    foreach ($lock in $locks) {
        if ($lock.stale) {
            try {
                Remove-Item -Path $lock.lockFile -Force
                Write-Log "Removed stale lock for '$($lock.filePath)'. Lock age: $($lock.lockAge.TotalMinutes) minutes." -Level "INFO"
                $staleCount++
            } catch {
                Write-Log "Error removing stale lock file '$($lock.lockFile)': $_" -Level "ERROR"
            }
        }
    }
    
    Write-Log "Cleanup complete. Removed $staleCount stale locks." -Level "INFO"
    return $staleCount
}

######## Function to display lock status
function Show-LockStatus {
    $locks = Get-AllLocks
    
    if ($locks.Count -eq 0) {
        Write-Host "No active locks found." -ForegroundColor Green
        return
    
    try {
        ######## Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Show-LockStatus"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    Write-Host "Current Lock Status:" -ForegroundColor Cyan
    Write-Host "===================" -ForegroundColor Cyan
    
    foreach ($lock in $locks) {
        $statusColor = if ($lock.stale) { "Yellow" } else { "White" }
        $statusText = if ($lock.stale) { "STALE" } else { "ACTIVE" }
        
        Write-Host "File:      " -NoNewline -ForegroundColor Cyan
        Write-Host $lock.filePath -ForegroundColor $statusColor
        Write-Host "Status:    " -NoNewline -ForegroundColor Cyan
        Write-Host $statusText -ForegroundColor $statusColor
        Write-Host "Locked By: " -NoNewline -ForegroundColor Cyan
        Write-Host "$($lock.userName) on $($lock.computerName) (PID: $($lock.processId))" -ForegroundColor $statusColor
        Write-Host "Time:      " -NoNewline -ForegroundColor Cyan
        Write-Host "$($lock.timestamp) (Age: $([math]::Round($lock.lockAge.TotalMinutes, 2)) minutes)" -ForegroundColor $statusColor
        Write-Host "-----------------------------------------" -ForegroundColor Cyan
    }
}

# Export functions
Export-ModuleMember -Function Lock-File, Unlock-File, Test-FileLock, Get-AllLocks, Remove-StaleLocks, Show-LockStatus 



