#### Function to write to log
function Write-Log {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Message,
        
        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    #### Write to console
    switch ($Level) {
        "INFO" { Write-Host $logMessage -ForegroundColor Cyan 
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Write-Log"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
    }
    
    #### Write to log file
    Add-Content -Path $logFile -Value $logMessage
}

#### Function to create a UcF-compliant version of a file
function Create-UcFCompliantVersion {
    param (
        [Parameter(Mandatory = $true)]
        [string]$SourceFilePath,
        
        [Parameter(Mandatory = $true)]
        [string]$DestinationFilePath,
        
        [Parameter(Mandatory = $false)]
        [string]$Department = "U5-Data",
        
        [Parameter(Mandatory = $false)]
        [string]$Function = "1"
    )
    
    if (-not (Test-Path -Path $SourceFilePath)) {
        Write-Log "Source file not found: $SourceFilePath" -Level "ERROR"
        return $false
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Create-UcFCompliantVersion"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    try {
        #### Create destination directory if it doesn't exist
        $destinationDir = Split-Path -Path $DestinationFilePath -Parent
        if (-not (Test-Path -Path $destinationDir)) {
            New-Item -Path $destinationDir -ItemType Directory -Force | Out-Null
            Write-Log "Created directory: $destinationDir"
        }
        
        #### Read source file content
        $content = Get-Content -Path $SourceFilePath -Raw
        
        #### Extract file name without extension
        $fileName = [System.IO.Path]::GetFileNameWithoutExtension($SourceFilePath)
        $extension = [System.IO.Path]::GetExtension($SourceFilePath)
        
        #### Add UcF-compliant header
        $header = @"
# $fileName
# Department: $Department
# Function: $Function
# Created: $(Get-Date -Format "yyyy-MM-dd")
#### Last Updated: $(Get-Date -Format "yyyy-MM-dd")

"@
        
        #### Combine header and content
        $ucfContent = $header + $content
        
        #### Save UcF-compliant version
        Set-Content -Path $DestinationFilePath -Value $ucfContent
        Write-Log "Created UcF-compliant version of $SourceFilePath at $DestinationFilePath"
        return $true
    }
    catch {
        Write-Log "Failed to create UcF-compliant version of $SourceFilePath. Error: $_" -Level "ERROR"
        return $false
    }
}

#### Function to verify content preservation
function Verify-ContentPreservation {
    param (
        [Parameter(Mandatory = $true)]
        [string]$SourceFilePath,
        
        [Parameter(Mandatory = $true)]
        [string]$DestinationFilePath
    )
    
    if (-not (Test-Path -Path $SourceFilePath)) {
        Write-Log "Source file not found: $SourceFilePath" -Level "ERROR"
        return $false
    
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Verify-ContentPreservation"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    
    if (-not (Test-Path -Path $DestinationFilePath)) {
        Write-Log "Destination file not found: $DestinationFilePath" -Level "ERROR"
        return $false
    }
    
    try {
        #### Read file contents
        $sourceContent = Get-Content -Path $SourceFilePath -Raw
        $destinationContent = Get-Content -Path $DestinationFilePath -Raw
        
        #### Remove UcF header from destination content for comparison
        $headerEndIndex = $destinationContent.IndexOf("`n`n")
        if ($headerEndIndex -gt 0) {
            $destinationContentWithoutHeader = $destinationContent.Substring($headerEndIndex + 2)
        }
        else {
            $destinationContentWithoutHeader = $destinationContent
        }
        
        #### Compare source content with destination content without header
        if ($sourceContent.Trim() -eq $destinationContentWithoutHeader.Trim()) {
            Write-Log "Content verification successful for $DestinationFilePath"
            return $true
        }
        else {
            Write-Log "Content verification failed for $DestinationFilePath" -Level "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error verifying content preservation: $_" -Level "ERROR"
        return $false
    }
}

#### Function to move departmental documentation
function Move-DepartmentalDocumentation {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Department,
        
        [Parameter(Mandatory = $true)]
        [string]$SourcePath,
        
        [Parameter(Mandatory = $true)]
        [string]$DestinationPath
    )
    
    if (-not (Test-Path -Path $SourcePath)) {
        Write-Log "Source path not found: $SourcePath" -Level "ERROR"
        return @{
            Success = $false
            MovedFiles = 0
            TotalFiles = 0
        
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Move-DepartmentalDocumentation"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
}
    }
    
    try {
        #### Create destination directory if it doesn't exist
        if (-not (Test-Path -Path $DestinationPath)) {
            New-Item -Path $DestinationPath -ItemType Directory -Force | Out-Null
            Write-Log "Created destination directory: $DestinationPath"
        }
        
        #### Get all markdown files in source directory
        $files = Get-ChildItem -Path $SourcePath -Filter "*.md" -File -Recurse
        
        $movedFiles = 0
        $totalFiles = $files.Count
        
        foreach ($file in $files) {
            #### Determine the appropriate function number based on file name or content
            $function = "1"  #### Default function number
            
            #### Determine departmental function based on content or naming patterns
            if ($file.Name -match "sop|procedure|workflow") {
                $function = "2"  #### Operations procedures
            }
            elseif ($file.Name -match "spec|requirement|standard") {
                $function = "3"  #### Standards and specifications
            }
            elseif ($file.Name -match "implementation|install|deploy") {
                $function = "4"  #### Implementation guides
            }
            elseif ($file.Name -match "report|analysis|metrics") {
                $function = "5"  #### Reports and analytics
            }
            
            #### Create destination file path
            $relativePath = $file.FullName.Substring($SourcePath.Length).TrimStart('\')
            $destinationFilePath = Join-Path -Path $DestinationPath -ChildPath $relativePath
            
            #### Create UcF-compliant version of the file
            $result = Create-UcFCompliantVersion -SourceFilePath $file.FullName -DestinationFilePath $destinationFilePath -Department $Department -Function $function
            
            if ($result) {
                #### Verify content preservation
                $verificationResult = Verify-ContentPreservation -SourceFilePath $file.FullName -DestinationFilePath $destinationFilePath
                
                if ($verificationResult) {
                    $movedFiles++
                }
            }
        }
        
        Write-Log "Moved $movedFiles out of $totalFiles files for department $Department"
        
        return @{
            Success = ($movedFiles -eq $totalFiles)
            MovedFiles = $movedFiles
            TotalFiles = $totalFiles
        }
    }
    catch {
        Write-Log "Error moving departmental documentation for $Department. Error: $_" -Level "ERROR"
        return @{
            Success = $false
            MovedFiles = 0
            TotalFiles = 0
            Error = $_
        }
    }
}

#### Main function to execute Day 3 of documentation reorganization
function Execute-Day3Reorganization {
    Write-Log "Starting Day 3 of documentation reorganization"
    
    #### Define departmental documentation mapping
    $departmentalMapping = @(
        @{
            Department = "U1-Administration"
            SourcePath = "docs\administration"
            DestinationPath = "U1-Administration\Documentation"
        
    try {
        #### Original function body is above
    }
    catch {
        $errorInfo = Handle-Error -Error $_ -Operation "Execute-Day3Reorganization"
        Write-Warning "Operation failed. See error log for details."
        return $false
    }
},
        @{
            Department = "U2-Research"
            SourcePath = "docs\research"
            DestinationPath = "U2-Research\Documentation"
        },
        @{
            Department = "U3-Operations"
            SourcePath = "docs\operations"
            DestinationPath = "U3-Operations\Documentation"
        },
        @{
            Department = "U4-Production"
            SourcePath = "docs\production"
            DestinationPath = "U4-Production\Documentation"
        },
        @{
            Department = "U5-Data"
            SourcePath = "docs\data"
            DestinationPath = "U5-Data\Documentation"
        },
        @{
            Department = "U6-Marketing"
            SourcePath = "docs\marketing"
            DestinationPath = "U6-Marketing\Documentation"
        },
        @{
            Department = "U7-Systems"
            SourcePath = "docs\systems"
            DestinationPath = "U7-Systems\Documentation"
        }
    )
    
    #### Results array for reporting
    $results = @()
    
    #### Process each departmental mapping
    foreach ($mapping in $departmentalMapping) {
        Write-Log "Processing departmental documentation for $($mapping.Department)"
        
        $result = Move-DepartmentalDocumentation -Department $mapping.Department -SourcePath $mapping.SourcePath -DestinationPath $mapping.DestinationPath
        
        $results += @{
            Department = $mapping.Department
            Success = $result.Success
            MovedFiles = $result.MovedFiles
            TotalFiles = $result.TotalFiles
            Error = $result.Error
        }
    }
    
    #### Generate Day 3 completion report
    $reportFile = Join-Path -Path $logDir -ChildPath "doc-reorganization-day3-report-$(Get-Date -Format 'yyyyMMdd-HHmmss').md"
    
    $reportContent = @"
#### Documentation Reorganization Day 3 Completion Report

##### Overview
- **Date**: $(Get-Date -Format "yyyy-MM-dd")
- **Time**: $(Get-Date -Format "HH:mm:ss")
- **Phase**: Day 3 of 4-day reorganization plan

##### Departmental Documentation Migration

| Department | Files Moved | Total Files | Success |
|------------|------------|-------------|---------|
$(foreach ($result in $results) {
"| $($result.Department) | $($result.MovedFiles) | $($result.TotalFiles) | $($result.Success) |"
})

##### Summary
- **Total Files Processed**: $($results | Measure-Object -Property TotalFiles -Sum | Select-Object -ExpandProperty Sum)
- **Total Files Successfully Moved**: $($results | Measure-Object -Property MovedFiles -Sum | Select-Object -ExpandProperty Sum)
- **Overall Success Rate**: $([math]::Round(($results | Measure-Object -Property MovedFiles -Sum | Select-Object -ExpandProperty Sum) / ($results | Measure-Object -Property TotalFiles -Sum | Select-Object -ExpandProperty Sum) * 100, 2))%

##### Next Steps
1. Complete Day 4 documentation reorganization
2. Update remaining references in all documentation
3. Finalize symbolic links for backward compatibility
4. Conduct comprehensive verification of all moved documentation

_Updated $(Get-Date -Format "MM-dd-yyyy") | AI: Cursor (Claude 3.7 Sonnet)_
"@
    
    Set-Content -Path $reportFile -Value $reportContent
    Write-Log "Created Day 3 completion report at $reportFile"
    
    Write-Host "`nDay 3 of documentation reorganization completed. See $reportFile for details." -ForegroundColor Green
}

# Execute Day 3 reorganization
Execute-Day3Reorganization 


